<header class="lesson-header">
    <span class="lesson-number">Lesson @LessonNumber</span>
    <h1>@Title</h1>
    <div class="lesson-meta">
        <span class="lesson-duration">
            <Icon Name="@(IconName.Clock)" Size="16" />
            @Duration
        </span>
        <span class="lesson-level @Level.ToString().ToLowerInvariant()">@Level</span>
    </div>
</header>
