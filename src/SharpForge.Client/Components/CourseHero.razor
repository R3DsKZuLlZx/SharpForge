<section class="course-hero">
    <div class="container">
        <a href="courses" class="back-link">
            <Icon Name="@(IconName.ChevronLeft)" Size="20" />
            Back to Courses
        </a>
        <div class="course-hero-content">
            <div class="course-hero-text">
                <span class="course-level @Level.ToString().ToLowerInvariant()">@Level.ToString()</span>
                <h1>@Title</h1>
                <p class="course-description">@Description</p>
                <div class="course-meta">
                    <div class="meta-item">
                        <Icon Name="@(IconName.BarChart)" Size="20" />
                        <span>@LessonCount Lessons</span>
                    </div>
                    <div class="meta-item">
                        <Icon Name="@(IconName.Clock)" Size="20" />
                        <span>@Duration</span>
                    </div>
                    <div class="meta-item">
                        <Icon Name="@(IconName.Users)" Size="20" />
                        <span>@StudentCount Students</span>
                    </div>
                </div>
                <a href="@StartUrl" class="btn btn-primary btn-lg">Start Learning</a>
            </div>
            <div class="course-hero-image">
                <div class="course-icon">
                    @IconContent
                </div>
            </div>
        </div>
    </div>
</section>
