@inject CourseProgressService ProgressService
@implements IDisposable

<aside class="course-sidebar">
    <div class="sidebar-card">
        <h4>Course Progress</h4>
        <div class="progress-bar">
            <div class="progress-fill" style="width: @(ProgressPercent)%"></div>
        </div>
        <p class="progress-text">@_completedLessons of @TotalLessons lessons completed</p>
        <a href="@ContinueUrl" class="btn btn-primary">@(_completedLessons > 0 ? "Continue Course" : "Start Course")</a>
    </div>

    <div class="sidebar-card">
        <h4>Course Includes</h4>
        <ul class="includes-list">
            <li>
                <Icon Name="@(IconName.Video)" Size="20" />
                @Duration of content
            </li>
            <li>
                <Icon Name="@(IconName.Document)" Size="20" />
                @TotalLessons lessons
            </li>
            <li>
                <Icon Name="@(IconName.Code)" Size="20" />
                @ExerciseCount hands-on exercises
            </li>
            @if (!string.IsNullOrEmpty(ProjectDescription))
            {
                <li>
                    <Icon Name="@(IconName.Package)" Size="20" />
                    @ProjectDescription
                </li>
            }
            <li>
                <Icon Name="@(IconName.Info)" Size="20" />
                Lifetime access
            </li>
        </ul>
    </div>
</aside>
