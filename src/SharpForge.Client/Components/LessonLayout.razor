@namespace SharpForge.Client.Components
@inject MarkdownService MarkdownService

<PageTitle>@_lesson.Title - @_course.Title - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar
        CourseUrl="@CourseUrl"
        CourseTitle="@_course.Title"
        CurrentLesson="@LessonNumber"
        Lessons="_course.Lessons" />

    <main class="lesson-content">
        <article class="lesson-article">
            <LessonHeader
                LessonNumber="@LessonNumber"
                Title="@_lesson.Title"
                Duration="@Duration"
                Level="@_course.CourseLevel" />

            <div class="lesson-body">
                @ChildContent
            </div>

            <LessonFooter
                PreviousUrl="@_previousUrl"
                PreviousText="@_previousText"
                NextUrl="@_nextUrl"
                NextText="@_nextText"
                ShowHomeIcon="@_showHomeIcon" />
        </article>
    </main>
</div>
