@if (_isOpen)
{
    <div class="lesson-sidebar-overlay show" @onclick="CloseSidebar"></div>
}

<aside class="lesson-sidebar @(_isOpen ? "open" : "")">
    <div class="sidebar-header">
        <a href="@CourseUrl" class="back-link">
            <Icon Name="chevron-left" Size="20" />
            Course Overview
        </a>
        <h3>@CourseTitle</h3>
    </div>
    <nav class="lesson-nav">
        @foreach (var lesson in Lessons)
        {
            var isActive = lesson.Number == CurrentLesson;
            <a href="@($"{CourseUrl}/lesson/{lesson.Number}")" class="lesson-nav-item @(isActive ? "active" : "")" @onclick="CloseSidebar">
                <span class="lesson-num">@lesson.Number</span>
                <span>@lesson.Title</span>
            </a>
        }
    </nav>
</aside>

<button class="mobile-lesson-toggle" @onclick="ToggleSidebar" title="Toggle lesson menu">
    @if (_isOpen)
    {
        <Icon Name="close" />
    }
    else
    {
        <Icon Name="menu" />
    }
</button>
