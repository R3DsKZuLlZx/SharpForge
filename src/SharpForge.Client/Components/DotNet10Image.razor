<div class="dotnet10-image">
    <svg viewBox="0 0 400 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Background gradient -->
        <defs>
            <linearGradient id="dotnet10-bg-gradient" x1="0" y1="0" x2="400" y2="300" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#512BD4"/>
                <stop offset="1" stop-color="#7B68EE"/>
            </linearGradient>
        </defs>
        <rect width="400" height="300" fill="url(#dotnet10-bg-gradient)"/>
        
        <!-- Decorative circles -->
        <circle cx="50" cy="50" r="80" fill="rgba(255,255,255,0.05)"/>
        <circle cx="380" cy="280" r="120" fill="rgba(255,255,255,0.05)"/>
        <circle cx="300" cy="50" r="40" fill="rgba(255,255,255,0.08)"/>
        
        <!-- .NET 10 Logo -->
        <text x="100" y="168" font-family="Inter, Arial, sans-serif" font-size="52" font-weight="700" fill="white">.NET 10</text>
        
        <!-- Decorative code lines -->
        <rect x="80" y="220" width="100" height="8" rx="4" fill="rgba(255,255,255,0.3)"/>
        <rect x="80" y="236" width="160" height="8" rx="4" fill="rgba(255,255,255,0.2)"/>
        <rect x="80" y="252" width="80" height="8" rx="4" fill="rgba(255,255,255,0.15)"/>
        
        <!-- Decorative dots -->
        <circle cx="320" cy="220" r="6" fill="rgba(255,255,255,0.4)"/>
        <circle cx="340" cy="236" r="4" fill="rgba(255,255,255,0.3)"/>
        <circle cx="310" cy="250" r="5" fill="rgba(255,255,255,0.25)"/>
    </svg>
</div>

