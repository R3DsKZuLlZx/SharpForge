@namespace SharpForge.Client.Components

<PageTitle>@Title - SharpForge</PageTitle>
<CodeHighlighter />

<article class="blog-post">
    <BlogHeader
        Category="@Category"
        Date="@Date"
        ReadTime="@ReadTime"
        Title="@Title"
        Excerpt="@Excerpt" />

    <div class="container">
        <div class="post-content-wrapper">
            <div class="post-body">
                @ChildContent

                <BlogTags Tags="@Tags" />
            </div>

            <BlogSidebar Items="@SidebarItems" />
        </div>
    </div>
</article>
