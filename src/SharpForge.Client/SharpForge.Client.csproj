<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        
        <!-- Disable fingerprinting for simpler static hosting -->
        <WasmFingerprintDotnetJs>false</WasmFingerprintDotnetJs>
        <WasmFingerprintAssets>false</WasmFingerprintAssets>
        
        <!-- Production optimizations -->
        <BlazorEnableCompression>true</BlazorEnableCompression>
    </PropertyGroup>

    <!-- Release-only optimizations -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>partial</TrimMode>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="publish_test\web.config" />
      <_ContentIncludedByDefault Remove="publish_test\SharpForge.Client.runtimeconfig.json" />
      <_ContentIncludedByDefault Remove="publish_test\SharpForge.Client.staticwebassets.endpoints.json" />
      <_ContentIncludedByDefault Remove="publish_test\wwwroot\sample-data\weather.json" />
    </ItemGroup>

</Project>
