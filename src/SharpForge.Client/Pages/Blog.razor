@page "/blog"

<PageTitle>Blog - SharpForge</PageTitle>

<section class="page-hero">
    <div class="container">
        <span class="tag mb-3">Blog</span>
        <h1>Articles & Insights</h1>
        <p class="page-description">Stay up to date with the latest C# and .NET development trends</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="blog-layout">
            <main class="blog-main">
                <!-- Featured Post -->
                <article class="post-card featured">
                    <div class="post-image">
                        <DotNet10Image />
                    </div>
                    <div class="post-content">
                        <div class="post-meta">
                            <span class="post-category">Featured</span>
                            <span class="post-date">@FeaturedPost.Date</span>
                        </div>
                        <h2>@FeaturedPost.Title</h2>
                        <p>@FeaturedPost.Excerpt</p>
                        <a href="@FeaturedPost.Url" class="btn btn-primary">Read Article</a>
                    </div>
                </article>

                <!-- Regular Posts -->
                <div class="posts-grid">
                    @foreach (var post in CurrentPagePosts)
                    {
                        <article class="post-card">
                            <div class="post-content">
                                <div class="post-meta">
                                    <span class="post-category">@post.Category</span>
                                    <span class="post-date">@post.Date</span>
                                </div>
                                <h3>@post.Title</h3>
                                <p>@post.Excerpt</p>
                                <a href="@post.Url" class="post-link">Read More →</a>
                            </div>
                        </article>
                    }
                </div>

                <!-- Pagination -->
                <div class="pagination">
                    <button class="pagination-btn" disabled="@(CurrentPage == 1)" @onclick="PreviousPage">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                        <span class="pagination-text">Previous</span>
                    </button>
                    <div class="pagination-pages">
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNumber = i;
                            <button class="page-btn @(CurrentPage == pageNumber ? "active" : "")" 
                                    @onclick="@(() => GoToPage(pageNumber))">
                                @pageNumber
                            </button>
                        }
                    </div>
                    <button class="pagination-btn" disabled="@(CurrentPage == TotalPages)" @onclick="NextPage">
                        <span class="pagination-text">Next</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </button>
                </div>
            </main>

            <aside class="blog-sidebar">
                <div class="sidebar-section">
                    <h4>Categories</h4>
                    <ul class="category-list">
                        <li>
                            <a href="#" class="@(SelectedCategory == null ? "active" : "")" @onclick="@(() => SelectCategory(null))" @onclick:preventDefault>
                                All Posts <span>@(AllPosts.Count + 1)</span>
                            </a>
                        </li>
                        @foreach (var category in Categories)
                        {
                            <li>
                                <a href="#" class="@(SelectedCategory == category.Key ? "active" : "")" 
                                   @onclick="@(() => SelectCategory(category.Key))" @onclick:preventDefault>
                                    @category.Key <span>@category.Value</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h4>Popular Tags</h4>
                    <div class="tags-cloud">
                        <a href="#" class="tag-link">C#</a>
                        <a href="#" class="tag-link">.NET</a>
                        <a href="#" class="tag-link">Blazor</a>
                        <a href="#" class="tag-link">ASP.NET Core</a>
                        <a href="#" class="tag-link">Entity Framework</a>
                        <a href="#" class="tag-link">LINQ</a>
                        <a href="#" class="tag-link">async/await</a>
                        <a href="#" class="tag-link">Design Patterns</a>
                    </div>
                </div>

                <div class="sidebar-section newsletter">
                    <h4>Stay Updated</h4>
                    <p>Get the latest articles delivered to your inbox.</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Enter your email" class="form-control">
                        <button type="submit" class="btn btn-primary">Subscribe</button>
                    </form>
                </div>
            </aside>
        </div>
    </div>
</section>

@code {
    private int CurrentPage { get; set; } = 1;
    private int PageSize { get; set; } = 6;
    private string? SelectedCategory { get; set; } = null;
    
    private BlogPost FeaturedPost { get; } = new()
    {
        Title = "What's New in .NET 10: A Complete Overview",
        Excerpt = "Explore the latest features and improvements in .NET 10, including performance enhancements, new APIs, and language features that will change how you write C# code.",
        Date = "January 28, 2026",
        Category = "Featured",
        Url = "blog/whats-new-in-dotnet-10"
    };

    private List<BlogPost> AllPosts { get; } = new()
    {
        new() { Title = "Blazor Render Modes & Hosting Models", Excerpt = "Compare Blazor render modes (WASM, Server, prerendering) and hosting models (Standalone WASM, ASP.NET Core hosted).", Date = "February 3, 2026", Category = "Blazor", Url = "blog/blazor-render-modes" },

        new() { Title = "Building Real-Time Apps with Blazor and SignalR", Excerpt = "Learn how to create interactive real-time applications using Blazor WebAssembly and SignalR for seamless client-server communication.", Date = "January 22, 2026", Category = "Blazor", Url = "blog/blazor-signalr-realtime" },
        new() { Title = "Async/Await Best Practices in C# 13", Excerpt = "Master asynchronous programming with these essential tips, patterns, and common pitfalls to avoid in modern C# development.", Date = "January 15, 2026", Category = "Best Practices", Url = "blog/async-await-best-practices" },
        new() { Title = "Clean Architecture with ASP.NET Core", Excerpt = "A practical guide to implementing clean architecture in your ASP.NET Core applications for better maintainability and testability.", Date = "January 8, 2026", Category = "Architecture", Url = "blog/clean-architecture-aspnet-core" },
        new() { Title = "Memory Management in .NET: A Deep Dive", Excerpt = "Understanding garbage collection, memory allocation, and optimization techniques for high-performance .NET applications.", Date = "January 2, 2026", Category = "Performance", Url = "blog/memory-management-dotnet" },
        new() { Title = "Unit Testing with xUnit and Moq", Excerpt = "Complete guide to writing effective unit tests in C# using xUnit and Moq, including best practices and real-world examples.", Date = "December 28, 2025", Category = "Testing", Url = "blog/unit-testing-xunit-moq" },
        new() { Title = "CI/CD for .NET with GitHub Actions", Excerpt = "Set up a complete CI/CD pipeline for your .NET applications using GitHub Actions, including testing, building, and deployment.", Date = "December 20, 2025", Category = "DevOps", Url = "blog/cicd-dotnet-github-actions" },
        // Page 2 posts
        new() { Title = "Dependency Injection Deep Dive", Excerpt = "Understanding the built-in dependency injection container in ASP.NET Core and advanced patterns for complex scenarios.", Date = "December 15, 2025", Category = "ASP.NET Core", Url = "blog/dependency-injection-deep-dive" },
        new() { Title = "Working with JSON in .NET", Excerpt = "Master System.Text.Json and learn when to use Newtonsoft.Json. Covers serialization, deserialization, and custom converters.", Date = "December 10, 2025", Category = "Best Practices", Url = "blog/working-with-json-dotnet" },
        new() { Title = "Blazor Component Lifecycle", Excerpt = "Deep dive into Blazor component lifecycle methods and how to use them effectively in your applications.", Date = "December 5, 2025", Category = "Blazor", Url = "blog/blazor-component-lifecycle" },
        new() { Title = "LINQ Performance Tips", Excerpt = "Optimize your LINQ queries with these practical tips. Learn about deferred execution, materialization, and common pitfalls.", Date = "December 1, 2025", Category = "Performance", Url = "blog/linq-performance-tips" },
        new() { Title = "Securing ASP.NET Core APIs", Excerpt = "Implement authentication and authorization in your APIs using JWT tokens, OAuth 2.0, and ASP.NET Core Identity.", Date = "November 25, 2025", Category = "ASP.NET Core", Url = "blog/securing-aspnet-core-apis" },
        new() { Title = "Entity Framework Core Migrations", Excerpt = "Master database migrations in EF Core. Learn about migration strategies, seeding data, and handling production deployments.", Date = "November 20, 2025", Category = "Entity Framework", Url = "blog/ef-core-migrations" },
        // Page 3 posts
        new() { Title = "Creating Custom Middleware", Excerpt = "Build custom middleware components for ASP.NET Core to handle cross-cutting concerns like logging, caching, and error handling.", Date = "November 15, 2025", Category = "ASP.NET Core", Url = "blog/custom-middleware-aspnet-core" },
        new() { Title = "Blazor State Management", Excerpt = "Explore different approaches to state management in Blazor applications, from simple patterns to Flux-like architectures.", Date = "November 10, 2025", Category = "Blazor", Url = "blog/blazor-state-management" },
        new() { Title = "C# Pattern Matching", Excerpt = "Master pattern matching in C# with practical examples. Covers switch expressions, property patterns, and positional patterns.", Date = "November 5, 2025", Category = "C#", Url = "blog/csharp-pattern-matching" },
        new() { Title = "Docker for .NET Developers", Excerpt = "Containerize your .NET applications with Docker. Learn about multi-stage builds, optimization, and Docker Compose.", Date = "November 1, 2025", Category = "DevOps", Url = "blog/docker-for-dotnet-developers" },
        new() { Title = "gRPC Services in .NET", Excerpt = "Build high-performance microservices with gRPC. Covers protobuf, streaming, and integration with ASP.NET Core.", Date = "October 25, 2025", Category = "ASP.NET Core", Url = "blog/grpc-services-dotnet" },
        new() { Title = "Minimal APIs in .NET", Excerpt = "Build lightweight APIs with minimal code using .NET Minimal APIs. Perfect for microservices and simple endpoints.", Date = "October 20, 2025", Category = "ASP.NET Core", Url = "blog/minimal-apis-dotnet" }
    };

    private int TotalPages => (int)Math.Ceiling((double)FilteredPosts.Count() / PageSize);

    private IEnumerable<BlogPost> FilteredPosts => SelectedCategory == null 
        ? AllPosts 
        : AllPosts.Where(p => p.Category == SelectedCategory);

    private IEnumerable<BlogPost> CurrentPagePosts => FilteredPosts
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);

    private Dictionary<string, int> Categories => AllPosts
        .GroupBy(p => p.Category)
        .ToDictionary(g => g.Key, g => g.Count());

    private void SelectCategory(string? category)
    {
        SelectedCategory = category;
        CurrentPage = 1; // Reset to first page when changing category
    }

    private void GoToPage(int page)
    {
        CurrentPage = page;
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }

    private class BlogPost
    {
        public string Title { get; set; } = "";
        public string Excerpt { get; set; } = "";
        public string Date { get; set; } = "";
        public string Category { get; set; } = "";
        public string Url { get; set; } = "#";
    }
}
