@page "/blog"
@inject MarkdownService MarkdownService

<PageTitle>Blog - SharpForge</PageTitle>

<section class="page-hero">
    <div class="container">
        <span class="tag mb-3">Blog</span>
        <h1>Articles & Insights</h1>
        <p class="page-description">Stay up to date with the latest C# and .NET development trends</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="blog-layout">
            <main class="blog-main">
                <!-- Featured Post -->
                @if (_featured is not null)
                {
                    <article class="post-card featured">
                        <div class="post-image">
                            <DotNet10Image />
                        </div>
                        <div class="post-content">
                            <div class="post-meta">
                                <span class="post-category">Featured</span>
                                <span class="post-date">@_featured.Date</span>
                            </div>
                            <h2>@_featured.Title</h2>
                            <p>@_featured.Excerpt</p>
                            <a href="@_featured.Url" class="btn btn-primary">Read Article</a>
                        </div>
                    </article>
                }

                <!-- Regular Posts -->
                <div class="posts-grid">
                    @foreach (var post in CurrentPagePosts)
                    {
                        <article class="post-card">
                            <div class="post-content">
                                <div class="post-meta">
                                    <span class="post-category">@post.Category</span>
                                    <span class="post-date">@post.Date</span>
                                </div>
                                <h3>@post.Title</h3>
                                <p>@post.Excerpt</p>
                                <a href="@post.Url" class="post-link">Read More →</a>
                            </div>
                        </article>
                    }
                </div>

                <!-- Pagination -->
                <div class="pagination">
                    <button class="pagination-btn" disabled="@(CurrentPage == 1)" @onclick="PreviousPage">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"/>
                        </svg>
                        <span class="pagination-text">Previous</span>
                    </button>
                    <div class="pagination-pages">
                        @for (int i = 1; i <= TotalPages; i++)
                        {
                            var pageNumber = i;
                            <button class="page-btn @(CurrentPage == pageNumber ? "active" : "")" 
                                    @onclick="@(() => GoToPage(pageNumber))">
                                @pageNumber
                            </button>
                        }
                    </div>
                    <button class="pagination-btn" disabled="@(CurrentPage == TotalPages)" @onclick="NextPage">
                        <span class="pagination-text">Next</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"/>
                        </svg>
                    </button>
                </div>
            </main>

            <aside class="blog-sidebar">
                <div class="sidebar-section">
                    <h4>Categories</h4>
                    <ul class="category-list">
                        <li>
                            <a href="#" class="@(SelectedCategory == null ? "active" : "")" @onclick="@(() => SelectCategory(null))" @onclick:preventDefault>
                                All Posts <span>@_allPosts.Count</span>
                            </a>
                        </li>
                        @foreach (var category in Categories)
                        {
                            <li>
                                <a href="#" class="@(SelectedCategory == category.Key ? "active" : "")" 
                                   @onclick="@(() => SelectCategory(category.Key))" @onclick:preventDefault>
                                    @category.Key <span>@category.Value</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>

                <div class="sidebar-section">
                    <h4>Popular Tags</h4>
                    <div class="tags-cloud">
                        <a href="#" class="tag-link">C#</a>
                        <a href="#" class="tag-link">.NET</a>
                        <a href="#" class="tag-link">Blazor</a>
                        <a href="#" class="tag-link">ASP.NET Core</a>
                        <a href="#" class="tag-link">Entity Framework</a>
                        <a href="#" class="tag-link">LINQ</a>
                        <a href="#" class="tag-link">async/await</a>
                        <a href="#" class="tag-link">Design Patterns</a>
                    </div>
                </div>

                <div class="sidebar-section newsletter">
                    <h4>Stay Updated</h4>
                    <p>Get the latest articles delivered to your inbox.</p>
                    <form class="newsletter-form">
                        <input type="email" placeholder="Enter your email" class="form-control">
                        <button type="submit" class="btn btn-primary">Subscribe</button>
                    </form>
                </div>
            </aside>
        </div>
    </div>
</section>

@code {
    private int CurrentPage { get; set; } = 1;
    private const int PageSize = 6;
    private string? SelectedCategory { get; set; }

    private BlogPostFrontmatter? _featured;
    private IReadOnlyList<BlogPostFrontmatter> _allPosts = [];
    private IReadOnlyList<BlogPostFrontmatter> _regularPosts = [];

    protected override void OnInitialized()
    {
        _allPosts = MarkdownService.GetAllPosts();
        _featured = MarkdownService.GetFeaturedPost();
        _regularPosts = MarkdownService.GetRegularPosts();
    }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredPosts.Count() / PageSize));

    private IEnumerable<BlogPostFrontmatter> FilteredPosts => SelectedCategory == null 
        ? _regularPosts 
        : _regularPosts.Where(p => p.Category == SelectedCategory);

    private IEnumerable<BlogPostFrontmatter> CurrentPagePosts => FilteredPosts
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);

    private Dictionary<string, int> Categories => _regularPosts
        .GroupBy(p => p.Category)
        .ToDictionary(g => g.Key, g => g.Count());

    private void SelectCategory(string? category)
    {
        SelectedCategory = category;
        CurrentPage = 1;
    }

    private void GoToPage(int page)
    {
        CurrentPage = page;
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages) CurrentPage++;
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1) CurrentPage--;
    }
}
