            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>State Management Options</h2>
                    <ul>
                        <li><strong>Component state:</strong> Local to a single component</li>
                        <li><strong>Cascading values:</strong> Pass state down the component tree</li>
                        <li><strong>Scoped services:</strong> Share state via DI</li>
                        <li><strong>Browser storage:</strong> Persist state in localStorage/sessionStorage</li>
                    </ul>
                </section>

                <section class="lesson-section">
                    <h2>State Container Service</h2>
                    <pre><code class="language-csharp">// Services/AppState.cs
public class AppState
{
    public string? CurrentUser { get; private set; }
    public List&lt;CartItem&gt; CartItems { get; } = new();

    public event Action? OnChange;

    public void SetUser(string user)
    {
        CurrentUser = user;
        NotifyStateChanged();
    }

    public void AddToCart(Product product)
    {
        CartItems.Add(new CartItem { Product = product, Quantity = 1 });
        NotifyStateChanged();
    }

    private void NotifyStateChanged() =&gt; OnChange?.Invoke();
}

// Register as singleton (persists for app lifetime)
builder.Services.AddSingleton&lt;AppState&gt;();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Using State in Components</h2>
                    <pre><code class="language-razor">@@inject AppState State
@@implements IDisposable

&lt;p&gt;Cart has @@State.CartItems.Count items&lt;/p&gt;

@@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Browser Storage</h2>
                    <pre><code class="language-bash">dotnet add package Blazored.LocalStorage</code></pre>
                    <pre><code class="language-csharp">// Program.cs
builder.Services.AddBlazoredLocalStorage();</code></pre>
                    <pre><code class="language-razor">@@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

@@code {
    protected override async Task OnInitializedAsync()
    {
        // Load from storage
        var theme = await LocalStorage.GetItemAsync&lt;string&gt;("theme");
    }

    private async Task SaveTheme(string theme)
    {
        await LocalStorage.SetItemAsync("theme", theme);
    }

    private async Task ClearTheme()
    {
        await LocalStorage.RemoveItemAsync("theme");
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Cascading State</h2>
                    <pre><code class="language-razor">@@* App.razor or MainLayout.razor *@@
&lt;CascadingValue Value="@@appState"&gt;
    @@Body
&lt;/CascadingValue&gt;

@@code {
    private AppState appState = new();
}

@@* Any child component *@@
@@code {
    [CascadingParameter]
    public AppState? State { get; set; }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>URL-Based State</h2>
                    <pre><code class="language-razor">@@page "/products"
@@inject NavigationManager Nav

@@* State in query string *@@
@@code {
    [SupplyParameterFromQuery]
    public string? Category { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;

    private void ChangePage(int page)
    {
        Nav.NavigateTo($"/products?category={Category}&amp;page={page}");
    }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Use singleton services for app-wide state.</LessonTakeaway>
                    <LessonTakeaway>Event pattern (OnChange) notifies components of updates.</LessonTakeaway>
                    <LessonTakeaway>Use localStorage for persistent client-side state.</LessonTakeaway>
                    <LessonTakeaway>Query strings make state shareable via URL.</LessonTakeaway>
                </LessonTakeaways>
