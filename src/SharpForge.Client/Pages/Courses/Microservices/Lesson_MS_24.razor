    <main class="lesson-content">
        <article class="lesson-article">
            <LessonHeader 
                LessonNumber="24"
                Title="Distributed Tracing with OpenTelemetry"
                Duration="30 min"
                Level="Advanced" />
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>OpenTelemetry Setup</h2>
                    <pre><code class="language-csharp">// Program.cs
builder.Services.AddOpenTelemetry()
    .WithTracing(tracing =&gt;
    {
        tracing
            .AddAspNetCoreInstrumentation()
            .AddHttpClientInstrumentation()
            .AddSqlClientInstrumentation()
            .AddSource("OrderService")
            .AddOtlpExporter(opts =&gt;
            {
                opts.Endpoint = new Uri("http://jaeger:4317");
            });
    });</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Custom Spans</h2>
                    <pre><code class="language-csharp">public class OrderService
{
    private static readonly ActivitySource Source = new("OrderService");

    public async Task ProcessOrderAsync(Order order)
    {
        using var activity = Source.StartActivity("ProcessOrder");
        activity?.SetTag("order.id", order.Id.ToString());
        activity?.SetTag("order.total", order.Total);
        
        // Process order...
        
        activity?.AddEvent(new ActivityEvent("OrderValidated"));
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Trace Visualization</h2>
                    <pre><code class="language-text">Request Flow:
┌─────────────────────────────────────────────────────────────┐
│ API Gateway (12ms)                                          │
│   └─ Order Service (45ms)                                   │
│       ├─ Validate Order (5ms)                               │
│       ├─ Inventory Service (HTTP) (22ms)                    │
│       │   └─ Check Stock (15ms)                             │
│       └─ Payment Service (gRPC) (18ms)                      │
│           └─ Process Payment (12ms)                         │
└─────────────────────────────────────────────────────────────┘</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>OpenTelemetry is the standard for observability.</LessonTakeaway>
                    <LessonTakeaway>Traces show request flow across services.</LessonTakeaway>
                    <LessonTakeaway>Use Jaeger or Zipkin to visualize traces.</LessonTakeaway>
                </LessonTakeaways>
            </div>
