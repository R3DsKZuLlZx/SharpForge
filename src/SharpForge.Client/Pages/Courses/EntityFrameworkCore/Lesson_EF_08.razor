@page "/training/entity-framework-core/lesson/8"
<PageTitle>Loading Related Data - Entity Framework Core - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="training/entity-framework-core"
        CourseTitle="Entity Framework Core"
        CurrentLesson="8"
        Lessons="CourseLessons.EntityFrameworkCore" />
    <main class="lesson-content">
        <article class="lesson-article">
            <LessonHeader 
                LessonNumber="8"
                Title="Loading Related Data"
                Duration="18 min"
                Level="Intermediate" />
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Eager Loading (Include)</h2>
                    <p>Use <code>Include</code> to load related entities in the same query (JOINs); this makes data available immediately but may produce large queries—use selectively.</p>
                    <pre><code class="language-csharp">// Load related data in the same query
var products = await context.Products
    .Include(p =&gt; p.Category)
    .ToListAsync();

// Multiple includes
var orders = await context.Orders
    .Include(o =&gt; o.Customer)
    .Include(o =&gt; o.Items)
    .ToListAsync();

// Nested includes
var orders = await context.Orders
    .Include(o =&gt; o.Items)
        .ThenInclude(i =&gt; i.Product)
            .ThenInclude(p =&gt; p.Category)
    .ToListAsync();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Filtered Include</h2>
                    <p>Filtered <code>Include</code> limits which related entities are loaded (useful to reduce payload); note support depends on provider/EF Core version.</p>
                    <pre><code class="language-csharp">// Only load active products in each category
var categories = await context.Categories
    .Include(c =&gt; c.Products.Where(p =&gt; p.IsActive))
    .ToListAsync();

// Order included entities
var categories = await context.Categories
    .Include(c =&gt; c.Products.OrderBy(p =&gt; p.Name).Take(5))
    .ToListAsync();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Explicit Loading</h2>
                    <p>Explicit loading fetches related entities on demand via the context entry API, helpful when you need to load relations conditionally after the parent is loaded.</p>
                    <pre><code class="language-csharp">// Load related data on demand
var product = await context.Products.FindAsync(id);

// Load reference navigation
await context.Entry(product)
    .Reference(p =&gt; p.Category)
    .LoadAsync();

// Load collection navigation
var category = await context.Categories.FindAsync(categoryId);
await context.Entry(category)
    .Collection(c =&gt; c.Products)
    .LoadAsync();

// Check if loaded
bool isLoaded = context.Entry(product)
    .Reference(p =&gt; p.Category)
    .IsLoaded;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Lazy Loading</h2>
                    <p>Enable lazy loading with proxies to load navigation properties on access—be cautious: it can trigger many small queries (N+1 problem).</p>
                    <pre><code class="language-bash">dotnet add package Microsoft.EntityFrameworkCore.Proxies</code></pre>
                    <pre><code class="language-csharp">// Enable lazy loading
options.UseLazyLoadingProxies();

// Entities must use virtual navigation properties
public class Product
{
    public int Id { get; set; }
    public virtual Category Category { get; set; }  // virtual!
}</code></pre>
                    <div class="warning-box">
                        <div class="warning-box-header"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span>Warning</span></div>
                        <p>Lazy loading can cause N+1 query problems! Prefer eager loading for predictable performance.</p>
                    </div>
                </section>

                <section class="lesson-section">
                    <h2>Split Queries</h2>
                    <p>Use <code>AsSplitQuery()</code> when a single large JOIN query is expensive—EF Core will split it into multiple queries which can sometimes improve performance.</p>
                    <pre><code class="language-csharp">// Default: single query with JOINs (can be slow)
var orders = await context.Orders
    .Include(o =&gt; o.Items)
    .ToListAsync();

// Split into multiple queries (can be faster)
var orders = await context.Orders
    .Include(o =&gt; o.Items)
    .AsSplitQuery()
    .ToListAsync();

// Configure globally
options.UseSqlServer(connectionString, o =&gt; o.UseQuerySplittingBehavior(
    QuerySplittingBehavior.SplitQuery));</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Eager loading (Include) is the default recommendation.</LessonTakeaway>
                    <LessonTakeaway>Use ThenInclude for nested relationships.</LessonTakeaway>
                    <LessonTakeaway>Filtered Include can limit related data loaded.</LessonTakeaway>
                    <LessonTakeaway>Avoid lazy loading—it can cause N+1 queries.</LessonTakeaway>
                </LessonTakeaways>
            </div>
