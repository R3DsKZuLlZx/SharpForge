            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Basic Entity Class</h2>
                    <p>This is a plain C# POCO entity class; EF Core maps properties to database columns by convention (Id => primary key).</p>
                    <pre><code class="language-csharp">public class Product
{
    public int Id { get; set; }  // Convention: primary key
    public string Name { get; set; } = string.Empty;
    public string? Description { get; set; }
    public decimal Price { get; set; }
    public int Stock { get; set; }
    public DateTime CreatedAt { get; set; }
    public bool IsActive { get; set; }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Data Annotations</h2>
                    <p>Data annotations provide a quick way to configure mapping rules directly on entity properties (required, max length, column type, computed/not mapped, etc.).</p>
                    <pre><code class="language-csharp">using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

public class Product
{
    [Key]
    public int Id { get; set; }

    [Required]
    [MaxLength(100)]
    public string Name { get; set; } = string.Empty;

    [MaxLength(500)]
    public string? Description { get; set; }

    [Column(TypeName = "decimal(18,2)")]
    public decimal Price { get; set; }

    [Range(0, int.MaxValue)]
    public int Stock { get; set; }

    [DatabaseGenerated(DatabaseGeneratedOption.Identity)]
    public DateTime CreatedAt { get; set; }

    [NotMapped]  // Not stored in database
    public decimal TotalValue =&gt; Price * Stock;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Fluent API Configuration</h2>
                    <p>Use the Fluent API in <code>OnModelCreating</code> for advanced mapping scenarios; this example shows common property configuration and indexing.</p>
                    <pre><code class="language-csharp">protected override void OnModelCreating(ModelBuilder modelBuilder)
{
    modelBuilder.Entity&lt;Product&gt;(entity =&gt;
    {
        entity.ToTable("Products");
        entity.HasKey(e =&gt; e.Id);
        
        entity.Property(e =&gt; e.Name)
            .IsRequired()
            .HasMaxLength(100);
        
        entity.Property(e =&gt; e.Price)
            .HasPrecision(18, 2);
        
        entity.Property(e =&gt; e.CreatedAt)
            .HasDefaultValueSql("GETUTCDATE()");
        
        entity.HasIndex(e =&gt; e.Name);
        
        entity.Ignore(e =&gt; e.TotalValue);  // Not mapped
    });
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Entity Configuration Classes</h2>
                    <p>Split configuration into classes that implement <code>IEntityTypeConfiguration&lt;T&gt;</code> to keep the <code>DbContext</code> tidy and modular.</p>
                    <pre><code class="language-csharp">public class ProductConfiguration : IEntityTypeConfiguration&lt;Product&gt;
{
    public void Configure(EntityTypeBuilder&lt;Product&gt; builder)
    {
        builder.ToTable("Products");
        builder.HasKey(e =&gt; e.Id);
        builder.Property(e =&gt; e.Name).IsRequired().HasMaxLength(100);
        builder.Property(e =&gt; e.Price).HasPrecision(18, 2);
    }
}

// Apply in OnModelCreating
protected override void OnModelCreating(ModelBuilder modelBuilder)
{
    modelBuilder.ApplyConfiguration(new ProductConfiguration());
    
    // Or apply all configurations from assembly
    modelBuilder.ApplyConfigurationsFromAssembly(typeof(AppDbContext).Assembly);
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Value Conversions</h2>
                    <p>Value conversions map CLR types to database representations (e.g., enums to strings or lists to CSV); use them when the CLR type doesn't map directly to a DB type.</p>
                    <pre><code class="language-csharp">public enum ProductStatus { Draft, Active, Discontinued }

public class Product
{
    public ProductStatus Status { get; set; }
}

// In configuration
builder.Property(e =&gt; e.Status)
    .HasConversion&lt;string&gt;();  // Store as string in DB

// Custom conversion
builder.Property(e =&gt; e.Tags)
    .HasConversion(
        v =&gt; string.Join(',', v),
        v =&gt; v.Split(',', StringSplitOptions.RemoveEmptyEntries).ToList());</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Id property is automatically the primary key by convention.</LessonTakeaway>
                    <LessonTakeaway>Use Data Annotations for simple configuration.</LessonTakeaway>
                    <LessonTakeaway>Use Fluent API for complex configuration.</LessonTakeaway>
                    <LessonTakeaway>IEntityTypeConfiguration keeps DbContext clean.</LessonTakeaway>
                </LessonTakeaways>
