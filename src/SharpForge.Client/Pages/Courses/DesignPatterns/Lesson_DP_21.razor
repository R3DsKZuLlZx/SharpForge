            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Define the skeleton of an algorithm in a method, deferring some steps to subclasses. Template Method lets subclasses redefine certain steps without changing the algorithm's structure.</p>
                </section>

                <section class="lesson-section">
                    <h2>Data Export Example</h2>
                    <pre><code class="language-csharp">public abstract class DataExporter
{
    // Template method - defines algorithm skeleton
    public void Export(IEnumerable&lt;Data&gt; data)
    {
        var processed = Transform(data);
        var formatted = Format(processed);
        Save(formatted);
        NotifyCompletion();
    }

    // Common implementation
    protected virtual void NotifyCompletion() 
        =&gt; Console.WriteLine("Export completed");

    // Steps to be implemented by subclasses
    protected abstract IEnumerable&lt;Data&gt; Transform(IEnumerable&lt;Data&gt; data);
    protected abstract string Format(IEnumerable&lt;Data&gt; data);
    protected abstract void Save(string content);
}

public class CsvExporter : DataExporter
{
    protected override IEnumerable&lt;Data&gt; Transform(IEnumerable&lt;Data&gt; data)
        =&gt; data.Where(d =&gt; d.IsValid);

    protected override string Format(IEnumerable&lt;Data&gt; data)
        =&gt; string.Join("\n", data.Select(d =&gt; $"{d.Id},{d.Name},{d.Value}"));

    protected override void Save(string content)
        =&gt; File.WriteAllText("export.csv", content);
}

public class JsonExporter : DataExporter
{
    protected override IEnumerable&lt;Data&gt; Transform(IEnumerable&lt;Data&gt; data)
        =&gt; data;

    protected override string Format(IEnumerable&lt;Data&gt; data)
        =&gt; JsonSerializer.Serialize(data);

    protected override void Save(string content)
        =&gt; File.WriteAllText("export.json", content);
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Hook Methods</h2>
                    <pre><code class="language-csharp">public abstract class DataExporter
{
    public void Export(IEnumerable&lt;Data&gt; data)
    {
        if (ShouldValidate())  // Hook - optional override
            Validate(data);
        
        // ... rest of algorithm
    }

    // Hook with default implementation
    protected virtual bool ShouldValidate() =&gt; true;
    protected virtual void Validate(IEnumerable&lt;Data&gt; data) { }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Base class defines algorithm structure.</LessonTakeaway>
                    <LessonTakeaway>Subclasses implement specific steps.</LessonTakeaway>
                    <LessonTakeaway>Hooks provide optional customization points.</LessonTakeaway>
                </LessonTakeaways>
