            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Convert the interface of a class into another interface that clients expect. Adapter lets classes work together that couldn't otherwise because of incompatible interfaces.</p>
                </section>

                <section class="lesson-section">
                    <h2>The Problem</h2>
                    <pre><code class="language-csharp">// Your application expects this interface
public interface IPaymentGateway
{
    Task&lt;bool&gt; ChargeAsync(decimal amount, string currency);
}

// But the third-party library has a different interface
public class StripeClient
{
    public async Task&lt;StripeCharge&gt; CreateChargeAsync(StripeChargeRequest request)
    {
        // Stripe-specific implementation
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>The Adapter Solution</h2>
                    <pre><code class="language-csharp">public class StripeAdapter : IPaymentGateway
{
    private readonly StripeClient _stripeClient;

    public StripeAdapter(StripeClient stripeClient)
    {
        _stripeClient = stripeClient;
    }

    public async Task&lt;bool&gt; ChargeAsync(decimal amount, string currency)
    {
        var request = new StripeChargeRequest
        {
            Amount = (long)(amount * 100),  // Stripe uses cents
            Currency = currency.ToLower()
        };

        var result = await _stripeClient.CreateChargeAsync(request);
        return result.Status == "succeeded";
    }
}

// Your code works with the interface
public class PaymentService
{
    private readonly IPaymentGateway _gateway;

    public PaymentService(IPaymentGateway gateway) =&gt; _gateway = gateway;

    public async Task ProcessPayment(decimal amount)
    {
        await _gateway.ChargeAsync(amount, "USD");
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Real-World Examples</h2>
                    <ul>
                        <li>Wrapping legacy APIs</li>
                        <li>Integrating third-party libraries</li>
                        <li>Database provider adapters</li>
                        <li>Logging framework adapters</li>
                    </ul>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Adapter bridges incompatible interfaces.</LessonTakeaway>
                    <LessonTakeaway>Wraps existing class without modifying it.</LessonTakeaway>
                    <LessonTakeaway>Allows working with third-party code.</LessonTakeaway>
                </LessonTakeaways>
