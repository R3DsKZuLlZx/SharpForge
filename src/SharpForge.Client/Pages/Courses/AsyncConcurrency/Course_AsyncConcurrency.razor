@page "/training/async-concurrency"

<PageTitle>Async/Await & Concurrency - SharpForge</PageTitle>

<CourseHero 
    Level="Advanced"
    Title="Async/Await & Concurrency"
    Description="Deep dive into asynchronous programming, Task Parallel Library, and concurrency patterns in C#. Master async/await, parallel processing, and thread-safe code."
    LessonCount="16"
    Duration="8 Hours"
    StudentCount="987"
    StartUrl="training/async-concurrency/lesson/1">
    <IconContent>
        <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="64" cy="64" r="60" fill="url(#async-gradient)"/>
            <path d="M40 64h48" stroke="white" stroke-width="4" stroke-linecap="round"/>
            <path d="M64 40v48" stroke="white" stroke-width="4" stroke-linecap="round"/>
            <circle cx="40" cy="64" r="8" fill="white"/>
            <circle cx="88" cy="64" r="8" fill="white"/>
            <circle cx="64" cy="40" r="8" fill="white"/>
            <circle cx="64" cy="88" r="8" fill="white"/>
            <path d="M48 48l32 32M80 48l-32 32" stroke="white" stroke-width="2" stroke-dasharray="4 4"/>
            <defs>
                <linearGradient id="async-gradient" x1="0" y1="0" x2="128" y2="128" gradientUnits="userSpaceOnUse">
                    <stop offset="0" stop-color="#f59e0b"/>
                    <stop offset="1" stop-color="#d97706"/>
                </linearGradient>
            </defs>
        </svg>
    </IconContent>
</CourseHero>

<section class="section course-content">
    <div class="container">
        <div class="course-layout">
            <main class="course-main">
                <CourseLearningOutcomes>
                    <CourseLearningOutcome Text="Master async/await syntax and patterns" />
                    <CourseLearningOutcome Text="Work with Task and ValueTask effectively" />
                    <CourseLearningOutcome Text="Implement cancellation and progress reporting" />
                    <CourseLearningOutcome Text="Use Parallel.For and PLINQ for data parallelism" />
                    <CourseLearningOutcome Text="Build pipelines with TPL Dataflow" />
                    <CourseLearningOutcome Text="Synchronize threads safely" />
                    <CourseLearningOutcome Text="Use concurrent collections properly" />
                    <CourseLearningOutcome Text="Debug and profile async applications" />
                </CourseLearningOutcomes>

                <CourseCurriculum 
                    BaseUrl="training/async-concurrency"
                    Lessons="@_lessons" />

                <CoursePrerequisites Prerequisites="@_prerequisites" />
            </main>

            <CourseSidebar 
                CourseId="async-concurrency"
                TotalLessons="16"
                Duration="8 hours"
                ExerciseCount="10"
                ProjectDescription="Concurrent application project"
                StartUrl="training/async-concurrency/lesson/1" />
        </div>
    </div>
</section>

@code {
    private readonly List<CourseCurriculum.CourseLessonInfo> _lessons =
    [
        // Async Fundamentals
        new(1, "Introduction to Asynchronous Programming", "Understand why async matters and how it differs from parallel programming.", "30 min"),
        new(2, "Tasks and the Task-Based Asynchronous Pattern", "Learn about Task, Task<T>, and how the TAP pattern works.", "30 min"),
        new(3, "Async and Await Keywords", "Master the syntax and mechanics of async/await in C#.", "35 min"),
        new(4, "ValueTask for Performance", "Use ValueTask to reduce allocations in hot paths.", "25 min"),
        
        // Advanced Async Patterns
        new(5, "Task Combinators", "Work with Task.WhenAll, Task.WhenAny, and custom combinators.", "30 min"),
        new(6, "Cancellation Tokens", "Implement cooperative cancellation in async operations.", "30 min"),
        new(7, "Progress Reporting", "Report progress from long-running async operations.", "25 min"),
        new(8, "Exception Handling in Async Code", "Handle exceptions properly in async methods and aggregated exceptions.", "30 min"),
        
        // Parallel Programming
        new(9, "Parallel.For and Parallel.ForEach", "Process collections in parallel with the TPL.", "30 min"),
        new(10, "PLINQ - Parallel LINQ", "Execute LINQ queries in parallel for data-intensive operations.", "30 min"),
        new(11, "Dataflow with TPL Dataflow", "Build producer-consumer pipelines with TPL Dataflow blocks.", "35 min"),
        
        // Synchronization
        new(12, "Thread Synchronization Primitives", "Use locks, Monitor, Mutex, and Semaphore for thread safety.", "35 min"),
        new(13, "Concurrent Collections", "Work with ConcurrentDictionary, ConcurrentQueue, and other thread-safe collections.", "30 min"),
        new(14, "Channels", "Implement producer-consumer patterns with System.Threading.Channels.", "30 min"),
        
        // Best Practices
        new(15, "Avoiding Common Pitfalls", "Avoid deadlocks, async void, and other common mistakes.", "30 min"),
        new(16, "Debugging and Profiling Async Code", "Use tools to diagnose issues in concurrent applications.", "35 min")
    ];

    private readonly List<string> _prerequisites =
    [
        "Strong understanding of C# fundamentals",
        "Experience with .NET applications",
        "Basic understanding of threading concepts",
        "Familiarity with LINQ"
    ];
}
