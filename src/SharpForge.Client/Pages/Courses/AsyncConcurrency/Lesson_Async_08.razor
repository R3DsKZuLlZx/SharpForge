                Title="Exception Handling in Async Code"
                Duration="30 min"
                Level="Intermediate" />
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Basic Exception Handling</h2>
                    <pre><code class="language-csharp">try
{
    var result = await GetDataAsync();
}
catch (HttpRequestException ex)
{
    // Handle network error
    logger.LogError(ex, "Network request failed");
}
catch (OperationCanceledException)
{
    // Handle cancellation
    logger.LogInformation("Operation was cancelled");
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>AggregateException with WhenAll</h2>
                    <pre><code class="language-csharp">var tasks = urls.Select(url =&gt; httpClient.GetStringAsync(url));
var allTask = Task.WhenAll(tasks);

try
{
    var results = await allTask;
}
catch (Exception)
{
    // Only first exception is thrown!
    // To get all exceptions:
    if (allTask.Exception != null)
    {
        foreach (var ex in allTask.Exception.InnerExceptions)
        {
            logger.LogError(ex, "Task failed");
        }
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Exception Filters</h2>
                    <pre><code class="language-csharp">try
{
    await DoWorkAsync(cancellationToken);
}
catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
{
    // Intentional cancellation
    return null;
}
catch (OperationCanceledException)
{
    // Timeout or other cancellation
    throw new TimeoutException("Operation timed out");
}
catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
{
    return null;  // 404 is expected
}
catch (HttpRequestException ex)
{
    throw;  // Other HTTP errors are unexpected
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Fire-and-Forget Safety</h2>
                    <pre><code class="language-csharp">// ❌ Dangerous - exceptions are lost
_ = DoWorkAsync();  // Fire and forget

// ✅ Safe - capture exceptions
_ = Task.Run(async () =&gt;
{
    try
    {
        await DoWorkAsync();
    }
    catch (Exception ex)
    {
        logger.LogError(ex, "Background task failed");
    }
});</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Use try/catch with await like synchronous code.</LessonTakeaway>
                    <LessonTakeaway>WhenAll only throws first exception; check Exception.InnerExceptions.</LessonTakeaway>
                    <LessonTakeaway>Use exception filters for conditional handling.</LessonTakeaway>
                    <LessonTakeaway>Always handle exceptions in fire-and-forget tasks.</LessonTakeaway>
                </LessonTakeaways>
            </div>
