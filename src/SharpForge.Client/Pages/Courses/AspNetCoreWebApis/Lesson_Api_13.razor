            <div class="lesson-body">
                <section class="lesson-section"><h2>Built-in Logging</h2><p>Use the built-in <code>ILogger&lt;T&gt;</code> for lightweight, structured logging. Prefer named placeholders so logs are queryable by fields.</p><pre><code class="language-csharp">public class ProductsController : ControllerBase
{
    private readonly ILogger&lt;ProductsController&gt; _logger;
    
    public ProductsController(ILogger&lt;ProductsController&gt; logger) => _logger = logger;

    [HttpGet("{id}")]
    public async Task&lt;ActionResult&lt;Product&gt;&gt; GetById(int id)
    {
        _logger.LogInformation("Getting product {ProductId}", id);
        var product = await _repository.GetByIdAsync(id);
        if (product == null)
        {
            _logger.LogWarning("Product {ProductId} not found", id);
            return NotFound();
        }
        return Ok(product);
    }
}</code></pre></section>
                <section class="lesson-section"><h2>Serilog Setup</h2><p>Serilog is a popular structured logging library; install sinks for console and file output and configure the host to use Serilog.</p><pre><code class="language-bash">dotnet add package Serilog.AspNetCore
dotnet add package Serilog.Sinks.Console
dotnet add package Serilog.Sinks.File</code></pre><pre><code class="language-csharp">// Program.cs
builder.Host.UseSerilog((context, config) => config
    .ReadFrom.Configuration(context.Configuration)
    .WriteTo.Console()
    .WriteTo.File("logs/log-.txt", rollingInterval: RollingInterval.Day));</code></pre></section>
                <section class="lesson-section"><h2>Structured Logging</h2><p>Structured logging captures values as named properties which makes them searchable in log stores; avoid string interpolation for production logs.</p><pre><code class="language-csharp">// ✅ Structured - values are searchable
_logger.LogInformation("Order {OrderId} placed by {UserId} for {Amount}", 
    orderId, userId, amount);

// ❌ String interpolation - not searchable
_logger.LogInformation($"Order {orderId} placed by {userId} for {amount}");</code></pre></section>
                <section class="lesson-section"><h2>Request Logging</h2><p>Enable request-level logging to capture HTTP method, path, status code, and latency for each request — useful for monitoring and SLAs.</p><pre><code class="language-csharp">// Add Serilog request logging
app.UseSerilogRequestLogging(options =>
{
    options.MessageTemplate = "HTTP {RequestMethod} {RequestPath} responded {StatusCode} in {Elapsed:0.0000}ms";
});</code></pre></section>
                <LessonTakeaways>
                    <LessonTakeaway>Use structured logging with named placeholders.</LessonTakeaway>
                    <LessonTakeaway>Serilog provides powerful logging capabilities.</LessonTakeaway>
                    <LessonTakeaway>Log appropriate levels: Debug, Info, Warning, Error.</LessonTakeaway>
                </LessonTakeaways>
