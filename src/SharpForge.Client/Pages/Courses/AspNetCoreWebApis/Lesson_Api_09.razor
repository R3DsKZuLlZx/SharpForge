            <div class="lesson-body">
                <section class="lesson-section"><h2>Why Use the Repository Pattern?</h2><p>The repository pattern abstracts data access, making your code more testable and maintainable. It separates business logic from data access logic.</p></section>
                <section class="lesson-section"><h2>Generic Repository Interface</h2><p>Define a small, well-scoped interface for common CRUD operations so implementations can be swapped in tests.</p><pre><code class="language-csharp">public interface IRepository&lt;T&gt; where T : class
{
    Task&lt;IEnumerable&lt;T&gt;&gt; GetAllAsync();
    Task&lt;T?&gt; GetByIdAsync(int id);
    Task AddAsync(T entity);
    Task UpdateAsync(T entity);
    Task DeleteAsync(int id);
}</code></pre></section>
                <section class="lesson-section"><h2>Implementation</h2><p>Implement a reusable generic repository backed by EF Core. Keep transaction boundaries and SaveChanges where appropriate — sometimes higher-level services should control transactions.</p><pre><code class="language-csharp">public class Repository&lt;T&gt; : IRepository&lt;T&gt; where T : class
{
    protected readonly AppDbContext _context;
    protected readonly DbSet&lt;T&gt; _dbSet;

    public Repository(AppDbContext context)
    {
        _context = context;
        _dbSet = context.Set&lt;T&gt;();
    }

    public async Task&lt;IEnumerable&lt;T&gt;&gt; GetAllAsync() => await _dbSet.ToListAsync();
    public async Task&lt;T?&gt; GetByIdAsync(int id) => await _dbSet.FindAsync(id);
    public async Task AddAsync(T entity) { await _dbSet.AddAsync(entity); await _context.SaveChangesAsync(); }
    public async Task UpdateAsync(T entity) { _dbSet.Update(entity); await _context.SaveChangesAsync(); }
    public async Task DeleteAsync(int id) { var entity = await GetByIdAsync(id); if (entity != null) { _dbSet.Remove(entity); await _context.SaveChangesAsync(); } }
}</code></pre></section>
                <section class="lesson-section"><h2>Product-Specific Repository</h2><p>Extend the generic repository for entity-specific queries when necessary — this keeps cross-cutting CRUD behavior generic while allowing specialized queries.</p><pre><code class="language-csharp">public interface IProductRepository : IRepository&lt;Product&gt;
{
    Task&lt;IEnumerable&lt;Product&gt;&gt; GetByCategoryAsync(int categoryId);
    Task&lt;IEnumerable&lt;Product&gt;&gt; SearchAsync(string term);
}

public class ProductRepository : Repository&lt;Product&gt;, IProductRepository
{
    public ProductRepository(AppDbContext context) : base(context) { }

    public async Task&lt;IEnumerable&lt;Product&gt;&gt; GetByCategoryAsync(int categoryId)
        => await _dbSet.Where(p => p.CategoryId == categoryId).ToListAsync();

    public async Task&lt;IEnumerable&lt;Product&gt;&gt; SearchAsync(string term)
        => await _dbSet.Where(p => p.Name.Contains(term)).ToListAsync();
}</code></pre></section>
                <section class="lesson-section"><h2>Registration</h2><p>Register generic and concrete repository types with DI so services can request the interfaces.</p><pre><code class="language-csharp">builder.Services.AddScoped(typeof(IRepository&lt;&gt;), typeof(Repository&lt;&gt;));
builder.Services.AddScoped&lt;IProductRepository, ProductRepository&gt;();</code></pre></section>
                <LessonTakeaways>
                    <LessonTakeaway>Repositories abstract data access from business logic.</LessonTakeaway>
                    <LessonTakeaway>Generic repositories reduce code duplication.</LessonTakeaway>
                    <LessonTakeaway>Extend generic repos for entity-specific queries.</LessonTakeaway>
                </LessonTakeaways>
