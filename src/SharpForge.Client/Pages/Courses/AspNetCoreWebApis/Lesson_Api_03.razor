            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Understanding Routing in ASP.NET Core</h2>
                    <p>Routing is responsible for matching incoming HTTP requests to endpoints. ASP.NET Core uses attribute routing for Web APIs.</p>
                </section>

                <section class="lesson-section">
                    <h2>Route Templates</h2>
                    <p>Route templates define how controller and action names map to URLs. Use controller-level templates for common prefixes and action-level templates for specific paths.</p>
                    <pre><code class="language-csharp">// Controller-level route
[Route("api/[controller]")]  // api/products
public class ProductsController : ControllerBase
{
    // Action-level routes
    [HttpGet]                    // GET api/products
    [HttpGet("{id}")]           // GET api/products/5
    [HttpGet("category/{cat}")] // GET api/products/category/electronics
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Route Parameters</h2>
                    <p>Parameters in the route template bind values from the URL into your action method parameters. You can make parameters optional, provide defaults, or accept multiple parameters.</p>
                    <pre><code class="language-csharp">// Required parameter
[HttpGet("{id}")]
public ActionResult Get(int id) { }

// Optional parameter
[HttpGet("{id?}")]
public ActionResult Get(int? id) { }

// Default value
[HttpGet("{id=1}")]
public ActionResult Get(int id) { }

// Multiple parameters
[HttpGet("{category}/{id}")]
public ActionResult Get(string category, int id) { }</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Route Constraints</h2>
                    <p>Constraints validate and parse route parameters (for example ensuring an <code>id</code> is an integer) before the action is invoked. Use them to reduce invalid requests and simplify action code.</p>
                    <pre><code class="language-csharp">// Integer constraint
[HttpGet("{id:int}")]
public ActionResult GetById(int id) { }

// Min/Max value
[HttpGet("{id:int:min(1):max(100)}")]
public ActionResult GetById(int id) { }

// GUID constraint
[HttpGet("{id:guid}")]
public ActionResult GetById(Guid id) { }

// Regex constraint
[HttpGet("{slug:regex(^[a-z0-9-]+$)}")]
public ActionResult GetBySlug(string slug) { }

// Length constraint
[HttpGet("{name:minlength(3):maxlength(50)}")]
public ActionResult GetByName(string name) { }</code></pre>

                    <div class="info-box">
                        <div class="info-box-header">
