            <div class="lesson-body">
                <section class="lesson-section"><h2>What are Minimal APIs?</h2><p>Minimal APIs provide a lightweight way to build HTTP APIs with minimal boilerplate which is ideal for microservices or simple endpoints.</p></section>
                <section class="lesson-section"><h2>Basic Endpoints</h2><p>Use top-level route mappings like <code>MapGet</code> and <code>MapPost</code> to define handlers inline or delegate to methods for clarity.</p><pre><code class="language-csharp">var builder = WebApplication.CreateBuilder(args);
var app = builder.Build();

app.MapGet("/", () => "Hello World");
app.MapGet("/products", () => products);
app.MapGet("/products/{id}", (int id) => products.Find(p => p.Id == id));
app.MapPost("/products", (Product product) => { products.Add(product); return Results.Created($"/products/{product.Id}", product); });
app.MapPut("/products/{id}", (int id, Product product) => { /* update */ return Results.NoContent(); });
app.MapDelete("/products/{id}", (int id) => { /* delete */ return Results.NoContent(); });

app.Run();</code></pre></section>
                <section class="lesson-section"><h2>Dependency Injection</h2><p>Minimal APIs support DI — request handlers can request services directly in the parameter list, making code concise and testable.</p><pre><code class="language-csharp">app.MapGet("/products", async (IProductRepository repo) => 
    await repo.GetAllAsync());

app.MapGet("/products/{id}", async (int id, IProductRepository repo, ILogger&lt;Program&gt; logger) =&gt;
{
    logger.LogInformation("Getting product {Id}", id);
    var product = await repo.GetByIdAsync(id);
    return product is null ? Results.NotFound() : Results.Ok(product);
});</code></pre></section>
                <section class="lesson-section"><h2>Route Groups</h2><p>Group related endpoints with <code>MapGroup</code> to apply common metadata, tags, or authorization to a set of routes.</p><pre><code class="language-csharp">var products = app.MapGroup("/api/products")
    .WithTags("Products")
    .RequireAuthorization();

products.MapGet("/", GetAll);
products.MapGet("/{id}", GetById);
products.MapPost("/", Create);
products.MapPut("/{id}", Update);
products.MapDelete("/{id}", Delete);</code></pre></section>
                <section class="lesson-section"><h2>Validation with Filters</h2><p>Use endpoint filters to run validation or cross-cutting logic before the handler executes; return a response early when validation fails.</p><pre><code class="language-csharp">app.MapPost("/products", (Product product) => Results.Ok(product))
    .AddEndpointFilter(async (context, next) =>
    {
        var product = context.GetArgument&lt;Product&gt;(0);
        if (string.IsNullOrEmpty(product.Name))
            return Results.BadRequest("Name is required");
        return await next(context);
    });</code></pre></section>
                <LessonTakeaways>
                    <LessonTakeaway>Minimal APIs are perfect for simple services.</LessonTakeaway>
                    <LessonTakeaway>Use route groups to organize related endpoints.</LessonTakeaway>
                    <LessonTakeaway>Endpoint filters provide validation and cross-cutting concerns.</LessonTakeaway>
                </LessonTakeaways>
