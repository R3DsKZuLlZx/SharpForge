@page "/training/{Slug}"

@if (_course is null)
{
    <NotFound />
}
else
{
    <PageTitle>@_course.Title - SharpForge</PageTitle>

    <CourseHero
        Level="@_course.Level"
        Title="@_course.Title"
        Description="@_course.Description"
        LessonCount="@_course.LessonCount"
        Duration="@_course.Duration"
        StudentCount="@_course.StudentCount"
        StartUrl="@_course.StartUrl">
        <IconContent>
            @((MarkupString)_course.IconSvg)
        </IconContent>
    </CourseHero>

    <section class="section course-content">
        <div class="container">
            <div class="course-layout">
                <main class="course-main">
                    <CourseLearningOutcomes>
                        @foreach (var outcome in _course.LearningOutcomes)
                        {
                            <CourseLearningOutcome Text="@outcome" />
                        }
                    </CourseLearningOutcomes>

                    <CourseCurriculum
                        BaseUrl="@($"training/{_course.Slug}")"
                        Lessons="@_curriculumLessons" />

                    <CoursePrerequisites Prerequisites="@_course.Prerequisites" />
                </main>

                <CourseSidebar
                    CourseId="@_course.Slug"
                    TotalLessons="@_course.LessonCount"
                    Duration="@_course.Duration"
                    ExerciseCount="@_course.ExerciseCount"
                    ProjectDescription="@_course.ProjectDescription"
                    StartUrl="@_course.StartUrl" />
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private CourseDetail? _course;
    private List<CourseCurriculum.CourseLessonInfo> _curriculumLessons = [];

    protected override void OnParametersSet()
    {
        _course = CourseDetailRegistry.Courses.GetValueOrDefault(Slug);

        _curriculumLessons = _course?.Lessons
            .Select(l => new CourseCurriculum.CourseLessonInfo(l.Number, l.Title, l.Description, l.Duration))
            .ToList() ?? [];
    }
}

