@page "/projects"

<PageTitle>Projects - SharpForge</PageTitle>

<section class="page-hero">
    <div class="container">
        <span class="tag mb-3">Projects</span>
        <h1>Open Source Projects</h1>
        <p class="page-description">Explore real-world C# projects that demonstrate professional development practices</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <!-- Featured Project -->
        <div class="featured-project">
            <div class="featured-content">
                <span class="tag mb-3">Featured</span>
                <h2>SharpForge</h2>
                <p>The very website you're looking at! Built with Blazor WebAssembly, this project demonstrates modern C# web development practices including component-based architecture, theme management, and responsive design.</p>
                <div class="project-tech">
                    <span class="tech-badge">Blazor WASM</span>
                    <span class="tech-badge">C# 13</span>
                    <span class="tech-badge">.NET 10</span>
                    <span class="tech-badge">CSS3</span>
                </div>
                <div class="project-links">
                    <a href="https://github.com/R3DsKZuLlZx/SharpForge" target="_blank" class="btn btn-primary">
                        <Icon Name="@(IconName.GitHub)" Size="20" />
                        View on GitHub
                    </a>
                    <a href="" class="btn btn-secondary">
                        <Icon Name="@(IconName.ExternalLink)" Size="20" />
                        Live Demo
                    </a>
                </div>
            </div>
            <div class="featured-preview">
                <div class="code-window">
                    <div class="code-header">
                        <span class="code-dot red"></span>
                        <span class="code-dot yellow"></span>
                        <span class="code-dot green"></span>
                        <span class="code-filename">ThemeService.cs</span>
                    </div>
                    <pre class="code-content"><code><span class="keyword">public class</span> <span class="type">ThemeService</span>
{
    <span class="keyword">public bool</span> IsDarkMode { <span class="keyword">get</span>; }

    <span class="keyword">public async</span> Task <span class="method">ToggleThemeAsync</span>()
    {
        _isDarkMode = !_isDarkMode;
        <span class="keyword">await</span> <span class="method">ApplyThemeAsync</span>();
    }
}</code></pre>
                </div>
            </div>
        </div>

