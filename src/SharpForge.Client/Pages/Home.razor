@page "/"

<PageTitle>SharpForge - Learn C# the Right Way</PageTitle>

<!-- Hero Section -->
<section class="hero">
    <div class="hero-background"></div>
    <div class="container hero-content">
        <div class="hero-badge">
            <span class="tag">Open Source</span>
        </div>
        <h1 class="hero-title">
            Master <span class="text-gradient">C#</span> with SharpForge
        </h1>
        <p class="hero-description">
            Your comprehensive platform for learning C# and .NET development. 
            From beginner tutorials to advanced patterns, we've got you covered.
        </p>
        <div class="hero-actions">
            <a href="training" class="btn btn-primary btn-lg">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="5 3 19 12 5 21 5 3"/>
                </svg>
                Start Learning
            </a>
            <a href="projects" class="btn btn-secondary btn-lg">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                </svg>
                View Projects
            </a>
        </div>
        
        <!-- Code Preview -->
        <div class="hero-code">
            <div class="code-header">
                <span class="code-dot red"></span>
                <span class="code-dot yellow"></span>
                <span class="code-dot green"></span>
                <span class="code-filename">Program.cs</span>
            </div>
            <pre class="code-content"><code><span class="keyword">using</span> SharpForge;

<span class="keyword">var</span> journey = <span class="keyword">new</span> <span class="type">LearningJourney</span>();
journey.<span class="method">Start</span>(<span class="string">"C# Fundamentals"</span>);

<span class="keyword">await</span> journey.<span class="method">MasterAsync</span>(<span class="string">"ASP.NET Core"</span>);
<span class="keyword">await</span> journey.<span class="method">BuildAsync</span>(<span class="string">"Real Projects"</span>);

Console.<span class="method">WriteLine</span>(<span class="string">"You're now a C# expert! 🚀"</span>);</code></pre>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="section features">
    <div class="container">
        <div class="section-header text-center">
            <span class="tag mb-3">Why SharpForge?</span>
            <h2>Everything you need to become a C# expert</h2>
            <p class="text-muted mt-3">Comprehensive resources designed for developers at every level</p>
        </div>
        
        <div class="features-grid">
            <a href="training" class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                    </svg>
                </div>
                <h3>Structured Training</h3>
                <p>Follow our carefully crafted learning paths from basics to advanced topics, with hands-on exercises.</p>
            </a>
            
            <a href="blog" class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                </div>
                <h3>In-Depth Blog Posts</h3>
                <p>Stay updated with the latest .NET trends, best practices, and deep dives into C# features.</p>
            </a>
            
            <a href="projects" class="feature-card">
                <div class="feature-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="16 18 22 12 16 6"/>
                        <polyline points="8 6 2 12 8 18"/>
                    </svg>
                </div>
                <h3>Real-World Projects</h3>
                <p>Explore open-source projects that demonstrate professional C# development practices.</p>
            </a>
        </div>
    </div>
</section>

<!-- Training Preview Section -->
<section class="section training-preview">
    <div class="container">
        <div class="section-header">
            <div class="section-header-left">
                <span class="tag mb-3">Training</span>
                <h2>Start your learning journey</h2>
                <p class="text-muted mt-3">Comprehensive courses for every skill level</p>
            </div>
            <a href="training" class="btn btn-secondary">View All Courses</a>
        </div>
        
        <div class="training-grid">
            <a href="training/csharp-fundamentals" class="training-card">
                <div class="training-level beginner">Beginner</div>
                <h3>C# Fundamentals</h3>
                <p>Master the basics of C# programming including variables, control flow, and object-oriented concepts.</p>
                <div class="training-meta">
                    <span>12 Lessons</span>
                    <span>•</span>
                    <span>4 Hours</span>
                </div>
            </a>
            
            <a href="training" class="training-card">
                <div class="training-level intermediate">Intermediate</div>
                <h3>ASP.NET Core Web APIs</h3>
                <p>Build production-ready REST APIs with ASP.NET Core, including authentication and deployment.</p>
                <div class="training-meta">
                    <span>18 Lessons</span>
                    <span>•</span>
                    <span>8 Hours</span>
                </div>
            </a>
            
            <a href="training" class="training-card">
                <div class="training-level advanced">Advanced</div>
                <h3>Design Patterns in C#</h3>
                <p>Learn Gang of Four patterns, SOLID principles, and clean architecture in C# applications.</p>
                <div class="training-meta">
                    <span>24 Lessons</span>
                    <span>•</span>
                    <span>10 Hours</span>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- Blog Preview Section -->
<section class="section blog-preview">
    <div class="container">
        <div class="section-header">
            <div class="section-header-left">
                <span class="tag mb-3">Blog</span>
                <h2>Latest articles</h2>
                <p class="text-muted mt-3">Insights, tutorials, and news from the .NET world</p>
            </div>
            <a href="blog" class="btn btn-secondary">View All Posts</a>
        </div>
        
        <div class="blog-grid">
            <article class="blog-card featured">
                <div class="blog-image">
                    <DotNet10Image />
                </div>
                <div class="blog-content">
                    <span class="blog-date">January 28, 2026</span>
                    <h3>What's New in .NET 10</h3>
                    <p>Explore the latest features and improvements in .NET 10, including performance enhancements and new APIs.</p>
                    <a href="blog/whats-new-in-dotnet-10" class="blog-link">Read More →</a>
                </div>
            </article>
            
            <article class="blog-card">
                <div class="blog-content">
                    <span class="blog-date">January 22, 2026</span>
                    <h3>Building Real-Time Apps with Blazor and SignalR</h3>
                    <p>Learn how to create interactive real-time applications using Blazor WebAssembly and SignalR.</p>
                    <a href="blog/blazor-signalr-realtime" class="blog-link">Read More →</a>
                </div>
            </article>
            
            <article class="blog-card">
                <div class="blog-content">
                    <span class="blog-date">January 15, 2026</span>
                    <h3>Async/Await Best Practices</h3>
                    <p>Master asynchronous programming in C# with these essential tips and patterns.</p>
                    <a href="blog/async-await-best-practices" class="blog-link">Read More →</a>
                </div>
            </article>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="section cta">
    <div class="container">
        <div class="cta-content">
            <h2>Ready to start your C# journey?</h2>
            <p>Join thousands of developers learning C# with SharpForge</p>
            <div class="cta-actions">
                <a href="training" class="btn btn-primary btn-lg">Get Started Free</a>
            </div>
        </div>
    </div>
</section>
