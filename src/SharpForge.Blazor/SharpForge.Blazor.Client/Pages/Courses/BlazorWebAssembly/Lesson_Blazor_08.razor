@page "/training/blazor-webassembly/lesson/8"
<PageTitle>Routing and Navigation - Blazor WebAssembly - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/blazor-webassembly"
        CourseTitle="Blazor WebAssembly"
        CurrentLesson="8"
        Lessons="CourseLessons.BlazorWebAssembly" />
    <main class="lesson-content">
        <article class="lesson-article">
            <LessonHeader 
                LessonNumber="8"
                Title="Routing and Navigation"
                Duration="25 min"
                Level="Intermediate" />
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Basic Routing</h2>
                    <pre><code class="language-razor">@@page "/products"
@@page "/products/list"  @@* Multiple routes *@@

&lt;h1&gt;Products&lt;/h1&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Route Parameters</h2>
                    <pre><code class="language-razor">@@page "/products/{Id:int}"

&lt;h1&gt;Product @@Id&lt;/h1&gt;

@@code {
    [Parameter]
    public int Id { get; set; }
}

@@* Optional parameter *@@
@@page "/products/{Category?}"

@@code {
    [Parameter]
    public string? Category { get; set; }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Route Constraints</h2>
                    <pre><code class="language-razor">@@page "/users/{Id:int}"           @@* Integer *@@
@@page "/users/{Id:guid}"          @@* GUID *@@
@@page "/orders/{Date:datetime}"   @@* DateTime *@@
@@page "/items/{Active:bool}"      @@* Boolean *@@
@@page "/search/{Query:minlength(3)}" @@* Min length *@@</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Query String Parameters</h2>
                    <pre><code class="language-razor">@@page "/search"

@@* URL: /search?query=blazor&amp;page=2 *@@

@@code {
    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    [SupplyParameterFromQuery]
    public int Page { get; set; } = 1;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>NavLink Component</h2>
                    <pre><code class="language-razor">@@* Adds 'active' class when route matches *@@
&lt;NavLink href="/products" Match="NavLinkMatch.All"&gt;
    Products
&lt;/NavLink&gt;

&lt;NavLink href="/products" Match="NavLinkMatch.Prefix"&gt;
    Products (matches /products/*)
&lt;/NavLink&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Programmatic Navigation</h2>
                    <pre><code class="language-razor">@@inject NavigationManager Navigation

&lt;button @@onclick="GoToProducts"&gt;View Products&lt;/button&gt;

@@code {
    private void GoToProducts()
    {
        Navigation.NavigateTo("/products");
    }

    private void GoToProduct(int id)
    {
        Navigation.NavigateTo($"/products/{id}");
    }

    private void GoExternal()
    {
        Navigation.NavigateTo("https://google.com", forceLoad: true);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Not Found Page</h2>
                    <pre><code class="language-razor">@@* In App.razor *@@
&lt;Router AppAssembly="@@typeof(App).Assembly"&gt;
    &lt;Found Context="routeData"&gt;
        &lt;RouteView RouteData="@@routeData" DefaultLayout="@@typeof(MainLayout)" /&gt;
    &lt;/Found&gt;
    &lt;NotFound&gt;
        &lt;LayoutView Layout="@@typeof(MainLayout)"&gt;
            &lt;h1&gt;404 - Page Not Found&lt;/h1&gt;
            &lt;p&gt;Sorry, the page you requested doesn't exist.&lt;/p&gt;
            &lt;a href="/"&gt;Go Home&lt;/a&gt;
        &lt;/LayoutView&gt;
    &lt;/NotFound&gt;
&lt;/Router&gt;</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>@@page directive defines component routes.</LessonTakeaway>
                    <LessonTakeaway>Route parameters use {Name:type} syntax.</LessonTakeaway>
                    <LessonTakeaway>NavigationManager enables programmatic navigation.</LessonTakeaway>
                    <LessonTakeaway>NavLink adds active styling automatically.</LessonTakeaway>
                </LessonTakeaways>
            </div>
            <LessonFooter 
                PreviousUrl="/training/blazor-webassembly/lesson/7" 
                PreviousText="Previous Lesson"
                NextUrl="/training/blazor-webassembly/lesson/9" 
                NextText="Next Lesson" />
        </article>
    </main>
</div>