            <header class="lesson-header"><span class="lesson-number">Lesson 5</span><h1>Event Handling</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Handling DOM Events</h2>
                    <pre><code class="language-razor">@@* Click events *@@
&lt;button @@onclick="HandleClick"&gt;Click me&lt;/button&gt;
&lt;button @@onclick="() =&gt; count++"&gt;Increment&lt;/button&gt;
&lt;button @@onclick="@@(() =&gt; DeleteItem(item.Id))"&gt;Delete&lt;/button&gt;

@@* With event args *@@
&lt;button @@onclick="HandleClickWithArgs"&gt;Click&lt;/button&gt;

@@code {
    private void HandleClick()
    {
        Console.WriteLine("Clicked!");
    }

    private void HandleClickWithArgs(MouseEventArgs e)
    {
        Console.WriteLine($"Clicked at {e.ClientX}, {e.ClientY}");
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Common Event Types</h2>
                    <pre><code class="language-razor">@@* Mouse events *@@
&lt;div @@onclick="OnClick" @@onmouseover="OnHover"&gt;...&lt;/div&gt;

@@* Keyboard events *@@
&lt;input @@onkeydown="OnKeyDown" @@onkeyup="OnKeyUp" /&gt;

@@* Focus events *@@
&lt;input @@onfocus="OnFocus" @@onblur="OnBlur" /&gt;

@@* Form events *@@
&lt;input @@oninput="OnInput" @@onchange="OnChange" /&gt;
&lt;form @@onsubmit="OnSubmit"&gt;...&lt;/form&gt;

@@code {
    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { /* Submit */ }
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Preventing Default and Stopping Propagation</h2>
                    <pre><code class="language-razor">@@* Prevent default action *@@
&lt;a href="/other" @@onclick="HandleClick" @@onclick:preventDefault&gt;
    Won't navigate
&lt;/a&gt;

@@* Stop event bubbling *@@
&lt;div @@onclick="ParentClick"&gt;
    &lt;button @@onclick="ChildClick" @@onclick:stopPropagation&gt;
        Only triggers ChildClick
    &lt;/button&gt;
&lt;/div&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Custom Component Events (EventCallback)</h2>
                    <pre><code class="language-razor">@@* RatingComponent.razor *@@
&lt;div class="rating"&gt;
    @@for (int i = 1; i &lt;= 5; i++)
    {
        var star = i;
        &lt;span @@onclick="() =&gt; OnRatingChanged.InvokeAsync(star)"&gt;
            @@(star &lt;= CurrentRating ? "★" : "☆")
        &lt;/span&gt;
    }
&lt;/div&gt;

@@code {
    [Parameter]
    public int CurrentRating { get; set; }

    [Parameter]
    public EventCallback&lt;int&gt; OnRatingChanged { get; set; }
}

@@* Parent usage *@@
&lt;RatingComponent CurrentRating="@@rating" OnRatingChanged="HandleRating" /&gt;

@@code {
    private int rating = 3;
    private void HandleRating(int newRating) =&gt; rating = newRating;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Async Event Handlers</h2>
                    <pre><code class="language-razor">&lt;button @@onclick="LoadDataAsync" disabled="@@isLoading"&gt;
    @@(isLoading ? "Loading..." : "Load Data")
&lt;/button&gt;

@@code {
    private bool isLoading = false;
    private List&lt;Item&gt; items = new();

    private async Task LoadDataAsync()
    {
        isLoading = true;
        items = await Http.GetFromJsonAsync&lt;List&lt;Item&gt;&gt;("api/items") ?? new();
        isLoading = false;
    }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Use @@onclick, @@onchange, etc. for DOM events.</LessonTakeaway>
                    <LessonTakeaway>EventCallback&lt;T&gt; creates custom component events.</LessonTakeaway>
                    <LessonTakeaway>Use :preventDefault and :stopPropagation modifiers.</LessonTakeaway>
                    <LessonTakeaway>Event handlers can be async (Task return type).</LessonTakeaway>
                </LessonTakeaways>
