        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 2</span><h1>Project Setup</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Creating a Blazor WebAssembly Project</h2>
                    <pre><code class="language-bash"># Standalone Blazor WebAssembly
dotnet new blazorwasm -n MyBlazorApp

# Blazor WebAssembly with ASP.NET Core hosted
dotnet new blazorwasm -n MyBlazorApp --hosted

# Run the app
cd MyBlazorApp
dotnet run</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Project Structure</h2>
                    <pre><code class="language-bash">MyBlazorApp/
├── Properties/
│   └── launchSettings.json
├── wwwroot/
│   ├── css/
│   ├── index.html          # Host page
│   └── favicon.png
├── Pages/
│   ├── Counter.razor
│   ├── Home.razor
│   └── Weather.razor
├── Layout/
│   ├── MainLayout.razor    # Main layout
│   └── NavMenu.razor       # Navigation
├── _Imports.razor          # Global usings
├── App.razor               # Root component
├── Program.cs              # Entry point
└── MyBlazorApp.csproj</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Program.cs - Entry Point</h2>
                    <pre><code class="language-csharp">using Microsoft.AspNetCore.Components.Web;
using Microsoft.AspNetCore.Components.WebAssembly.Hosting;
using MyBlazorApp;

var builder = WebAssemblyHostBuilder.CreateDefault(args);
builder.RootComponents.Add&lt;App&gt;("#app");
builder.RootComponents.Add&lt;HeadOutlet&gt;("head::after");

builder.Services.AddScoped(sp => 
    new HttpClient { BaseAddress = new Uri(builder.HostEnvironment.BaseAddress) });

await builder.Build().RunAsync();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>index.html - Host Page</h2>
                    <pre><code class="language-html">&lt;!DOCTYPE html&gt;
&lt;html lang="en"&gt;
&lt;head&gt;
    &lt;meta charset="utf-8" /&gt;
    &lt;title&gt;MyBlazorApp&lt;/title&gt;
    &lt;base href="/" /&gt;
    &lt;link href="css/app.css" rel="stylesheet" /&gt;
&lt;/head&gt;
&lt;body&gt;
    &lt;div id="app"&gt;Loading...&lt;/div&gt;

    &lt;script src="_framework/blazor.webassembly.js"&gt;&lt;/script&gt;
&lt;/body&gt;
&lt;/html&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>App.razor - Root Component</h2>
                    <pre><code class="language-razor">&lt;Router AppAssembly="@@typeof(App).Assembly"&gt;
    &lt;Found Context="routeData"&gt;
        &lt;RouteView RouteData="@@routeData" DefaultLayout="@@typeof(MainLayout)" /&gt;
        &lt;FocusOnNavigate RouteData="@@routeData" Selector="h1" /&gt;
    &lt;/Found&gt;
    &lt;NotFound&gt;
        &lt;PageTitle&gt;Not found&lt;/PageTitle&gt;
        &lt;LayoutView Layout="@@typeof(MainLayout)"&gt;
            &lt;p&gt;Sorry, there's nothing at this address.&lt;/p&gt;
        &lt;/LayoutView&gt;
    &lt;/NotFound&gt;
&lt;/Router&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Key Takeaways</h2>
                    <div class="takeaways">
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Use <code>dotnet new blazorwasm</code> to create a new project.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Program.cs configures services and root components.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>App.razor handles routing for your application.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>wwwroot contains static files like CSS and images.</span></div>
                    </div>
                </section>
