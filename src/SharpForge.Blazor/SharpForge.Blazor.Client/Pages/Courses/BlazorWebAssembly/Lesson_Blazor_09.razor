            <header class="lesson-header"><span class="lesson-number">Lesson 9</span><h1>Forms and Validation</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>35 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>EditForm Basics</h2>
                    <pre><code class="language-razor">&lt;EditForm Model="@@product" OnValidSubmit="HandleSubmit"&gt;
    &lt;DataAnnotationsValidator /&gt;
    &lt;ValidationSummary /&gt;

    &lt;div class="form-group"&gt;
        &lt;label&gt;Name&lt;/label&gt;
        &lt;InputText @@bind-Value="product.Name" class="form-control" /&gt;
        &lt;ValidationMessage For="() =&gt; product.Name" /&gt;
    &lt;/div&gt;

    &lt;button type="submit" class="btn btn-primary"&gt;Save&lt;/button&gt;
&lt;/EditForm&gt;

@@code {
    private Product product = new();

    private async Task HandleSubmit()
    {
        await Http.PostAsJsonAsync("api/products", product);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Model with Validation</h2>
                    <pre><code class="language-csharp">public class Product
{
    [Required(ErrorMessage = "Name is required")]
    [StringLength(100, MinimumLength = 2)]
    public string Name { get; set; } = "";

    [Required]
    [Range(0.01, 999999.99, ErrorMessage = "Price must be positive")]
    public decimal Price { get; set; }

    [EmailAddress]
    public string? ContactEmail { get; set; }

    [Url]
    public string? Website { get; set; }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Input Components</h2>
                    <pre><code class="language-razor">@@* Text input *@@
&lt;InputText @@bind-Value="model.Name" /&gt;

@@* Number input *@@
&lt;InputNumber @@bind-Value="model.Price" /&gt;

@@* Checkbox *@@
&lt;InputCheckbox @@bind-Value="model.IsActive" /&gt;

@@* Date *@@
&lt;InputDate @@bind-Value="model.StartDate" /&gt;

@@* Select/Dropdown *@@
&lt;InputSelect @@bind-Value="model.Category"&gt;
    &lt;option value=""&gt;Select...&lt;/option&gt;
    &lt;option value="electronics"&gt;Electronics&lt;/option&gt;
    &lt;option value="clothing"&gt;Clothing&lt;/option&gt;
&lt;/InputSelect&gt;

@@* Text area *@@
&lt;InputTextArea @@bind-Value="model.Description" /&gt;

@@* Radio buttons *@@
&lt;InputRadioGroup @@bind-Value="model.Priority"&gt;
    &lt;InputRadio Value="@@("low")" /&gt; Low
    &lt;InputRadio Value="@@("medium")" /&gt; Medium
    &lt;InputRadio Value="@@("high")" /&gt; High
&lt;/InputRadioGroup&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Form Events</h2>
                    <pre><code class="language-razor">@@* OnValidSubmit - fires only if validation passes *@@
&lt;EditForm Model="@@model" OnValidSubmit="HandleValid"&gt;

@@* OnInvalidSubmit - fires if validation fails *@@
&lt;EditForm Model="@@model" OnInvalidSubmit="HandleInvalid"&gt;

@@* OnSubmit - fires always, you check validity *@@
&lt;EditForm Model="@@model" OnSubmit="HandleSubmit"&gt;

@@code {
    private void HandleSubmit(EditContext context)
    {
        if (context.Validate())
        {
            // Valid - save
        }
        else
        {
            // Invalid - show errors
        }
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Custom Validation</h2>
                    <pre><code class="language-csharp">public class FutureDateAttribute : ValidationAttribute
{
    protected override ValidationResult? IsValid(
        object? value, ValidationContext context)
    {
        if (value is DateTime date &amp;&amp; date &lt;= DateTime.Now)
        {
            return new ValidationResult("Date must be in the future");
        }
        return ValidationResult.Success;
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Displaying Validation Errors</h2>
                    <pre><code class="language-razor">@@* Show all errors at top *@@
&lt;ValidationSummary /&gt;

@@* Show error for specific field *@@
&lt;ValidationMessage For="() =&gt; model.Name" /&gt;

@@* Custom error styling *@@
&lt;InputText @@bind-Value="model.Name" class="form-control" /&gt;
&lt;ValidationMessage For="() =&gt; model.Name" class="text-danger" /&gt;</code></pre>
                </section>

                <LessonTakeaways>
                        <LessonTakeaway>EditForm with DataAnnotationsValidator enables validation.</LessonTakeaway>
                        <LessonTakeaway>Use Input* components (InputText, InputNumber, etc.).</LessonTakeaway>
                        <LessonTakeaway>OnValidSubmit only fires when form is valid.</LessonTakeaway>
                        <LessonTakeaway>ValidationMessage shows field-specific errors.</LessonTakeaway>
                    </LessonTakeaways>
