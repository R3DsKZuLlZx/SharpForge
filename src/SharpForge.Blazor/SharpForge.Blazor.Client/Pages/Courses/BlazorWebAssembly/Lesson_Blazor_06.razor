@page "/training/blazor-webassembly/lesson/6"
<PageTitle>Data Binding - Blazor WebAssembly - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/blazor-webassembly"
        CourseTitle="Blazor WebAssembly"
        CurrentLesson="6"
        Lessons="CourseLessons.BlazorWebAssembly" />
    <main class="lesson-content">
        <article class="lesson-article">
            <LessonHeader 
                LessonNumber="6"
                Title="Data Binding"
                Duration="30 min"
                Level="Intermediate" />
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>One-Way Binding</h2>
                    <pre><code class="language-razor">@@* Display a value (one-way) *@@
&lt;p&gt;Hello, @@name!&lt;/p&gt;
&lt;input value="@@name" /&gt;

@@* Attribute binding *@@
&lt;button disabled="@@isDisabled"&gt;Submit&lt;/button&gt;
&lt;div class="@@cssClass"&gt;Styled div&lt;/div&gt;

@@code {
    private string name = "World";
    private bool isDisabled = false;
    private string cssClass = "highlight";
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Two-Way Binding with @@bind</h2>
                    <pre><code class="language-razor">@@* Two-way binding *@@
&lt;input @@bind="name" /&gt;
&lt;p&gt;You entered: @@name&lt;/p&gt;

@@* Different input types *@@
&lt;input type="text" @@bind="textValue" /&gt;
&lt;input type="number" @@bind="numberValue" /&gt;
&lt;input type="checkbox" @@bind="isChecked" /&gt;
&lt;input type="date" @@bind="dateValue" /&gt;

&lt;select @@bind="selectedOption"&gt;
    &lt;option value="a"&gt;Option A&lt;/option&gt;
    &lt;option value="b"&gt;Option B&lt;/option&gt;
&lt;/select&gt;

&lt;textarea @@bind="textArea"&gt;&lt;/textarea&gt;

@@code {
    private string name = "";
    private string textValue = "";
    private int numberValue = 0;
    private bool isChecked = false;
    private DateTime dateValue = DateTime.Today;
    private string selectedOption = "a";
    private string textArea = "";
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Binding Events</h2>
                    <pre><code class="language-razor">@@* Default: onchange (when focus leaves) *@@
&lt;input @@bind="search" /&gt;

@@* Bind on input (real-time) *@@
&lt;input @@bind="search" @@bind:event="oninput" /&gt;

@@* With callback after binding *@@
&lt;input @@bind="search" @@bind:after="SearchAsync" /&gt;

@@code {
    private string search = "";
    
    private async Task SearchAsync()
    {
        // Called after search is updated
        await PerformSearch(search);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Binding with Format</h2>
                    <pre><code class="language-razor">@@* Date formatting *@@
&lt;input @@bind="startDate" @@bind:format="yyyy-MM-dd" /&gt;

@@* Custom format for display *@@
&lt;p&gt;Price: @@price.ToString("C2")&lt;/p&gt;

@@code {
    private DateTime startDate = DateTime.Today;
    private decimal price = 19.99m;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Component Two-Way Binding</h2>
                    <pre><code class="language-razor">@@* Counter.razor - child component *@@
&lt;button @@onclick="Decrement"&gt;-&lt;/button&gt;
&lt;span&gt;@@Value&lt;/span&gt;
&lt;button @@onclick="Increment"&gt;+&lt;/button&gt;

@@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback&lt;int&gt; ValueChanged { get; set; }

    private async Task Increment() =&gt; await ValueChanged.InvokeAsync(Value + 1);
    private async Task Decrement() =&gt; await ValueChanged.InvokeAsync(Value - 1);
}

@@* Parent usage with @@bind *@@
&lt;Counter @@bind-Value="quantity" /&gt;
&lt;p&gt;Quantity: @@quantity&lt;/p&gt;

@@code {
    private int quantity = 1;
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Use @@bind for two-way data binding.</LessonTakeaway>
                    <LessonTakeaway>@@bind:event="oninput" binds on every keystroke.</LessonTakeaway>
                    <LessonTakeaway>@@bind:after runs code after value changes.</LessonTakeaway>
                    <LessonTakeaway>Value + ValueChanged pattern enables @@bind on components.</LessonTakeaway>
                </LessonTakeaways>
            </div>
