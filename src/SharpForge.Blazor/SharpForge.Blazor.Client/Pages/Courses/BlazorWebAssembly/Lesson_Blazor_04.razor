    <main class="lesson-content">
        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 4</span><h1>Component Parameters</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>30 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Basic Parameters</h2>
                    <pre><code class="language-razor">@@* Alert.razor *@@
&lt;div class="alert alert-@@Type"&gt;
    @@Message
&lt;/div&gt;

@@code {
    [Parameter]
    public string Message { get; set; } = "";

    [Parameter]
    public string Type { get; set; } = "info";
}

@@* Usage *@@
&lt;Alert Message="Operation successful!" Type="success" /&gt;
&lt;Alert Message="Something went wrong" Type="danger" /&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Required Parameters</h2>
                    <pre><code class="language-csharp">@@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = default!;

    [Parameter]
    public string? Subtitle { get; set; }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Child Content (RenderFragment)</h2>
                    <pre><code class="language-razor">@@* Card.razor *@@
&lt;div class="card"&gt;
    &lt;div class="card-header"&gt;@@Title&lt;/div&gt;
    &lt;div class="card-body"&gt;
        @@ChildContent
    &lt;/div&gt;
&lt;/div&gt;

@@code {
    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

@@* Usage *@@
&lt;Card Title="Welcome"&gt;
    &lt;p&gt;This content goes inside the card!&lt;/p&gt;
    &lt;button&gt;Click me&lt;/button&gt;
&lt;/Card&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Cascading Parameters</h2>
                    <pre><code class="language-razor">@@* Parent provides the value *@@
&lt;CascadingValue Value="@@theme"&gt;
    &lt;ChildComponent /&gt;
    &lt;AnotherChild /&gt;
&lt;/CascadingValue&gt;

@@code {
    private Theme theme = new Theme { Primary = "#007bff" };
}

@@* Any descendant can receive it *@@
@@code {
    [CascadingParameter]
    public Theme? Theme { get; set; }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Attribute Splatting</h2>
                    <pre><code class="language-razor">@@* CustomButton.razor *@@
&lt;button @@attributes="AdditionalAttributes" class="btn @@Class"&gt;
    @@ChildContent
&lt;/button&gt;

@@code {
    [Parameter]
    public string Class { get; set; } = "btn-primary";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary&lt;string, object&gt;? AdditionalAttributes { get; set; }
}

@@* Usage - extra attributes passed through *@@
&lt;CustomButton id="submit-btn" data-testid="submit"&gt;Submit&lt;/CustomButton&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Key Takeaways</h2>
                    <div class="takeaways">
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Use [Parameter] to define component inputs.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>RenderFragment allows passing child content.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>CascadingParameter passes values through the tree.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Attribute splatting passes extra HTML attributes.</span></div>
                    </div>
                </section>
