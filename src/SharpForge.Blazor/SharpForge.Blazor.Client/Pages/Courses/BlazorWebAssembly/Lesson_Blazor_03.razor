@page "/training/blazor-webassembly/lesson/3"
<PageTitle>Razor Components - Blazor WebAssembly - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/blazor-webassembly"
        CourseTitle="Blazor WebAssembly"
        CurrentLesson="3"
        Lessons="@_lessons" />
    <main class="lesson-content">
        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 3</span><h1>Razor Components</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>30 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Anatomy of a Razor Component</h2>
                    <pre><code class="language-razor">@@* Directives at the top *@@
@@page "/my-component"
@@using MyApp.Models
@@inject HttpClient Http

@@* HTML Markup with Razor syntax *@@
&lt;h1&gt;@@title&lt;/h1&gt;

&lt;ul&gt;
    @@foreach (var item in items)
    {
        &lt;li&gt;@@item.Name&lt;/li&gt;
    }
&lt;/ul&gt;

@@* C# Code Block *@@
@@code {
    private string title = "My Component";
    private List&lt;Item&gt; items = new();
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Razor Syntax Basics</h2>
                    <pre><code class="language-razor">@@* Implicit expressions *@@
&lt;p&gt;Hello, @@name!&lt;/p&gt;
&lt;p&gt;Count: @@items.Count&lt;/p&gt;

@@* Explicit expressions *@@
&lt;p&gt;Total: @@(price * quantity)&lt;/p&gt;

@@* Code blocks *@@
@@{
    var greeting = "Hello";
    var target = "World";
}
&lt;p&gt;@@greeting, @@target!&lt;/p&gt;

@@* Conditionals *@@
@@if (isVisible)
{
    &lt;p&gt;I'm visible!&lt;/p&gt;
}
else
{
    &lt;p&gt;I'm hidden!&lt;/p&gt;
}

@@* Loops *@@
@@foreach (var product in products)
{
    &lt;div class="product"&gt;@@product.Name&lt;/div&gt;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Creating Reusable Components</h2>
                    <pre><code class="language-razor">@@* Components/ProductCard.razor *@@
&lt;div class="product-card"&gt;
    &lt;h3&gt;@@Product.Name&lt;/h3&gt;
    &lt;p class="price"&gt;@@Product.Price.ToString("C")&lt;/p&gt;
    &lt;button @@onclick="AddToCart"&gt;Add to Cart&lt;/button&gt;
&lt;/div&gt;

@@code {
    [Parameter]
    public Product Product { get; set; } = default!;

    private void AddToCart()
    {
        // Add to cart logic
    }
}</code></pre>
                    <pre><code class="language-razor">@@* Using the component *@@
&lt;ProductCard Product="@@myProduct" /&gt;</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Component CSS Isolation</h2>
                    <p>Create a <code>.razor.css</code> file with the same name as your component:</p>
                    <pre><code class="language-css">/* ProductCard.razor.css */
.product-card {
    border: 1px solid #ccc;
    padding: 1rem;
    border-radius: 8px;
}

.price {
    color: green;
    font-weight: bold;
}</code></pre>
                    <p>Styles are automatically scoped to the component!</p>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Components combine HTML, C#, and CSS in .razor files.</LessonTakeaway>
                    <LessonTakeaway>Use @@ for expressions and @@code for C# logic.</LessonTakeaway>
                    <LessonTakeaway>CSS isolation scopes styles to individual components.</LessonTakeaway>
                    <LessonTakeaway>Components are reusable building blocks.</LessonTakeaway>
                </LessonTakeaways>
            </div>
            <LessonFooter 
                PreviousUrl="/training/blazor-webassembly/lesson/2" 
                PreviousText="Previous Lesson"
                NextUrl="/training/blazor-webassembly/lesson/4" 
                NextText="Next Lesson" />
        </article>
    </main>
</div>

