            <header class="lesson-header"><span class="lesson-number">Lesson 10</span><h1>Calling REST APIs</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>30 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>HttpClient Setup</h2>
                    <pre><code class="language-csharp">// Program.cs - already configured in template
builder.Services.AddScoped(sp =&gt; 
    new HttpClient { BaseAddress = new Uri(builder.HostEnvironment.BaseAddress) });

// Or with typed client
builder.Services.AddHttpClient&lt;IProductService, ProductService&gt;(client =&gt;
    client.BaseAddress = new Uri("https://api.example.com"));</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>GET Requests</h2>
                    <pre><code class="language-razor">@@inject HttpClient Http

@@if (products == null)
{
    &lt;p&gt;Loading...&lt;/p&gt;
}
else
{
    @@foreach (var product in products)
    {
        &lt;div&gt;@@product.Name - @@product.Price.ToString("C")&lt;/div&gt;
    }
}

@@code {
    private List&lt;Product&gt;? products;

    protected override async Task OnInitializedAsync()
    {
        products = await Http.GetFromJsonAsync&lt;List&lt;Product&gt;&gt;("api/products");
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>POST Requests</h2>
                    <pre><code class="language-csharp">private async Task CreateProduct()
{
    var newProduct = new Product { Name = "Widget", Price = 9.99m };
    
    var response = await Http.PostAsJsonAsync("api/products", newProduct);
    
    if (response.IsSuccessStatusCode)
    {
        var created = await response.Content.ReadFromJsonAsync&lt;Product&gt;();
        products?.Add(created!);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>PUT and DELETE</h2>
                    <pre><code class="language-csharp">// UPDATE
private async Task UpdateProduct(Product product)
{
    var response = await Http.PutAsJsonAsync($"api/products/{product.Id}", product);
    response.EnsureSuccessStatusCode();
}

// DELETE
private async Task DeleteProduct(int id)
{
    var response = await Http.DeleteAsync($"api/products/{id}");
    if (response.IsSuccessStatusCode)
    {
        products?.RemoveAll(p =&gt; p.Id == id);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Error Handling</h2>
                    <pre><code class="language-csharp">private string? errorMessage;

private async Task LoadProducts()
{
    try
    {
        products = await Http.GetFromJsonAsync&lt;List&lt;Product&gt;&gt;("api/products");
    }
    catch (HttpRequestException ex)
    {
        errorMessage = $"Error loading products: {ex.Message}";
    }
}

// Or check status codes
private async Task LoadProductSafe()
{
    var response = await Http.GetAsync("api/products");
    
    if (response.IsSuccessStatusCode)
    {
        products = await response.Content.ReadFromJsonAsync&lt;List&lt;Product&gt;&gt;();
    }
    else if (response.StatusCode == HttpStatusCode.NotFound)
    {
        products = new List&lt;Product&gt;();
    }
    else
    {
        errorMessage = $"Error: {response.StatusCode}";
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Creating a Service</h2>
                    <pre><code class="language-csharp">public class ProductService
{
    private readonly HttpClient _http;
    
    public ProductService(HttpClient http) =&gt; _http = http;

    public async Task&lt;List&lt;Product&gt;&gt; GetAllAsync()
        =&gt; await _http.GetFromJsonAsync&lt;List&lt;Product&gt;&gt;("api/products") ?? new();

    public async Task&lt;Product?&gt; GetByIdAsync(int id)
        =&gt; await _http.GetFromJsonAsync&lt;Product&gt;($"api/products/{id}");

    public async Task&lt;Product&gt; CreateAsync(Product product)
    {
        var response = await _http.PostAsJsonAsync("api/products", product);
        return await response.Content.ReadFromJsonAsync&lt;Product&gt;() ?? product;
    }
}

// Register: builder.Services.AddScoped&lt;ProductService&gt;();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Key Takeaways</h2>
                    <div class="takeaways">
                        <LessonTakeaway>Use GetFromJsonAsync for GET requests with JSON.</LessonTakeaway>
                        <LessonTakeaway>PostAsJsonAsync and PutAsJsonAsync for sending data.</LessonTakeaway>
                        <LessonTakeaway>Handle errors with try-catch or status code checks.</LessonTakeaway>
                        <LessonTakeaway>Create services to encapsulate API logic.</LessonTakeaway>
                    </div>
                </section>
