@page "/training/getting-started-dotnet"

<PageTitle>Getting Started with .NET - SharpForge</PageTitle>

<section class="course-hero">
    <div class="container">
        <a href="/training" class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back to Training
        </a>
        <div class="course-hero-content">
            <div class="course-hero-text">
                <span class="course-level beginner">Beginner</span>
                <h1>Getting Started with .NET</h1>
                <p class="course-description">Learn the fundamentals of the .NET platform. Understand the runtime, SDK, project structure, and build your first applications across web, console, and API projects.</p>
                <div class="course-meta">
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 20V10M18 20V4M6 20v-4"/>
                        </svg>
                        <span>10 Lessons</span>
                    </div>
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span>5 Hours</span>
                    </div>
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        <span>1,523 Students</span>
                    </div>
                </div>
                <a href="/training/getting-started-dotnet/lesson/1" class="btn btn-primary btn-lg">Start Learning</a>
            </div>
            <div class="course-hero-image">
                <div class="course-icon">
                    <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="64" cy="64" r="60" fill="url(#dotnet-gradient)"/>
                        <text x="64" y="78" text-anchor="middle" font-family="Inter, Arial, sans-serif" font-size="32" font-weight="700" fill="white">.NET</text>
                        <defs>
                            <linearGradient id="dotnet-gradient" x1="0" y1="0" x2="128" y2="128" gradientUnits="userSpaceOnUse">
                                <stop offset="0" stop-color="#512BD4"/>
                                <stop offset="1" stop-color="#7B68EE"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section course-content">
    <div class="container">
        <div class="course-layout">
            <main class="course-main">
                <div class="course-section">
                    <h2>What You'll Learn</h2>
                    <div class="learning-outcomes">
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Understand the .NET ecosystem and its components</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Install and configure the .NET SDK</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Use the .NET CLI effectively</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Understand project structure and configuration</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Work with NuGet packages and dependencies</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Build console, web, and API applications</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Debug and troubleshoot .NET applications</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Deploy your applications to production</span>
                        </div>
                    </div>
                </div>

                <div class="course-section">
                    <h2>Course Curriculum</h2>
                    <div class="lessons-list">
                        @foreach (var lesson in Lessons)
                        {
                            <a href="/training/getting-started-dotnet/lesson/@lesson.Number" class="lesson-card">
                                <div class="lesson-number">@lesson.Number</div>
                                <div class="lesson-info">
                                    <h3>@lesson.Title</h3>
                                    <p>@lesson.Description</p>
                                </div>
                                <div class="lesson-duration">@lesson.Duration</div>
                            </a>
                        }
                    </div>
                </div>

                <div class="course-section">
                    <h2>Prerequisites</h2>
                    <ul class="prerequisites-list">
                        <li>Basic understanding of programming concepts (helpful but not required)</li>
                        <li>A computer with Windows, macOS, or Linux</li>
                        <li>Internet connection for downloading tools</li>
                        <li>Willingness to learn and experiment!</li>
                    </ul>
                </div>
            </main>

            <aside class="course-sidebar">
                <div class="sidebar-card">
                    <h4>Course Progress</h4>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%"></div>
                    </div>
                    <p class="progress-text">0 of 10 lessons completed</p>
                    <a href="/training/getting-started-dotnet/lesson/1" class="btn btn-primary">Start Course</a>
                </div>

                <div class="sidebar-card">
                    <h4>Course Includes</h4>
                    <ul class="includes-list">
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="23 7 16 12 23 17 23 7"/>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                            </svg>
                            5 hours of content
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            10 lessons
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="16 18 22 12 16 6"/>
                                <polyline points="8 6 2 12 8 18"/>
                            </svg>
                            Hands-on exercises
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            Lifetime access
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>

@code {
    private List<LessonInfo> Lessons { get; } = new()
    {
        new(1, "What is .NET?", "Understand the .NET platform, its history, and the different versions and implementations.", "25 min"),
        new(2, "Installing the .NET SDK", "Download, install, and verify your .NET development environment on any operating system.", "20 min"),
        new(3, "The .NET CLI", "Master the command-line interface for creating, building, running, and publishing .NET projects.", "30 min"),
        new(4, "Project Structure and Files", "Understand .csproj files, solution files, and how .NET projects are organized.", "30 min"),
        new(5, "NuGet Package Management", "Learn to find, install, update, and manage third-party packages in your projects.", "35 min"),
        new(6, "Building Console Applications", "Create interactive console apps with user input, output formatting, and command-line arguments.", "35 min"),
        new(7, "Configuration and Settings", "Work with appsettings.json, environment variables, and the Options pattern.", "30 min"),
        new(8, "Introduction to ASP.NET Core", "Get started with web development using ASP.NET Core and understand the request pipeline.", "40 min"),
        new(9, "Debugging and Troubleshooting", "Use Visual Studio and VS Code debugging tools to find and fix issues in your code.", "30 min"),
        new(10, "Publishing and Deployment", "Package your application for deployment and understand the different publishing options.", "35 min")
    };

    private record LessonInfo(int Number, string Title, string Description, string Duration);
}

