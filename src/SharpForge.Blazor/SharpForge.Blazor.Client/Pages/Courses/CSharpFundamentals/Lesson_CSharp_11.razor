                <section class="lesson-section">
                    <h2>Creating Custom Exceptions</h2>
                    <p>Create your own exception types for domain-specific errors:</p>

                    <pre><code class="language-csharp">// Custom exception class
public class InsufficientFundsException : Exception
{
    public decimal Balance { get; }
    public decimal AttemptedAmount { get; }
    
    public InsufficientFundsException(decimal balance, decimal attempted)
        : base($"Insufficient funds. Balance: {balance:C}, Attempted: {attempted:C}")
    {
        Balance = balance;
        AttemptedAmount = attempted;
    }
}

// Using the custom exception
class BankAccount
{
    public decimal Balance { get; private set; }
    
    public void Withdraw(decimal amount)
    {
        if (amount &gt; Balance)
        {
            throw new InsufficientFundsException(Balance, amount);
        }
        Balance -= amount;
    }
}

// Handling it
try
{
    account.Withdraw(1000);
}
catch (InsufficientFundsException ex)
{
    Console.WriteLine(ex.Message);
    Console.WriteLine($"You need {ex.AttemptedAmount - ex.Balance:C} more.");
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Exception Filters</h2>
                    <p>C# 6+ allows filtering exceptions with the <code>when</code> keyword:</p>

                    <pre><code class="language-csharp">try
{
    MakeHttpRequest();
}
catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
{
    Console.WriteLine("Resource not found!");
}
catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
{
    Console.WriteLine("Please log in first.");
}
catch (HttpRequestException ex)
{
    Console.WriteLine($"HTTP error: {ex.StatusCode}");
}

// Useful for logging without catching
try
{
    DoWork();
}
catch (Exception ex) when (LogException(ex))  // LogException returns false
{
    // Never enters here, but exception is logged
}

bool LogException(Exception ex)
{
    Console.WriteLine($"[LOG] {ex.Message}");
    return false;  // Don't catch, just log
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Best Practices</h2>

                    <div class="best-practices">
                        <div class="practice do">
                            <h4>✅ Do</h4>
                            <ul>
                                <li>Catch specific exceptions when possible</li>
                                <li>Use <code>finally</code> or <code>using</code> for cleanup</li>
                                <li>Include helpful messages when throwing</li>
                                <li>Log exceptions for debugging</li>
                                <li>Use <code>throw;</code> to re-throw (preserves stack trace)</li>
                            </ul>
                        </div>
                        <div class="practice dont">
                            <h4>❌ Don't</h4>
                            <ul>
                                <li>Catch <code>Exception</code> without good reason</li>
                                <li>Use exceptions for normal flow control</li>
                                <li>Swallow exceptions silently (empty catch)</li>
                                <li>Use <code>throw ex;</code> (loses stack trace)</li>
                                <li>Throw exceptions in constructors if avoidable</li>
                            </ul>
                        </div>
                    </div>

                    <pre><code class="language-csharp">// ❌ Bad: Empty catch block (swallowing exceptions)
try
{
    DoWork();
}
catch { }  // Error is hidden - bugs become impossible to find!

// ❌ Bad: Using exceptions for flow control
try
{
    int index = Array.IndexOf(items, searchItem);
    if (index == -1) throw new Exception("Not found");
}
catch { }  // Don't do this - just use the -1 return value!

// ✅ Good: Specific handling with logging
try
{
    DoWork();
}
catch (SpecificException ex)
{
    _logger.LogError(ex, "Work failed");
    throw;  // Re-throw if caller should handle it
}</code></pre>
                </section>

                <LessonTakeaways>
                        <LessonTakeaway>Use <code>try-catch</code> to handle exceptions and prevent crashes.</LessonTakeaway>
                        <LessonTakeaway>Catch specific exceptions before general ones.</LessonTakeaway>
                        <LessonTakeaway>Use <code>finally</code> or <code>using</code> for cleanup that must always happen.</LessonTakeaway>
                        <LessonTakeaway>Throw meaningful exceptions with descriptive messages.</LessonTakeaway>
                        <LessonTakeaway>Never swallow exceptions silently – always log or re-throw.</LessonTakeaway>
                    </LessonTakeaways>

