            <header class="lesson-header"><span class="lesson-number">Lesson 13</span><h1>Concurrent Collections</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>30 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>ConcurrentDictionary</h2>
                    <pre><code class="language-csharp">var cache = new ConcurrentDictionary&lt;string, Data&gt;();

// Thread-safe add or update
cache.TryAdd("key", new Data());
cache.AddOrUpdate("key", 
    addValue: new Data(),
    updateValueFactory: (key, existing) =&gt; new Data());

// Get or add atomically
var value = cache.GetOrAdd("key", key =&gt; LoadExpensiveData(key));

// Thread-safe read
if (cache.TryGetValue("key", out var data))
{
    // Use data
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>ConcurrentQueue and ConcurrentStack</h2>
                    <pre><code class="language-csharp">var queue = new ConcurrentQueue&lt;WorkItem&gt;();

// Producer
queue.Enqueue(new WorkItem());

// Consumer
if (queue.TryDequeue(out var item))
{
    ProcessItem(item);
}

// Stack (LIFO)
var stack = new ConcurrentStack&lt;WorkItem&gt;();
stack.Push(item);
stack.TryPop(out var popped);</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>ConcurrentBag</h2>
                    <pre><code class="language-csharp">// Thread-local storage optimized for add/take from same thread
var bag = new ConcurrentBag&lt;Result&gt;();

Parallel.ForEach(items, item =&gt;
{
    var result = Process(item);
    bag.Add(result);  // Fast - uses thread-local storage
});

// Get all results
var allResults = bag.ToArray();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>BlockingCollection</h2>
                    <pre><code class="language-csharp">using var collection = new BlockingCollection&lt;WorkItem&gt;(boundedCapacity: 100);

// Producer
Task.Run(() =&gt;
{
    foreach (var item in GetItems())
    {
        collection.Add(item);  // Blocks if full
    }
    collection.CompleteAdding();
});

// Consumer
foreach (var item in collection.GetConsumingEnumerable())
{
    ProcessItem(item);  // Blocks if empty
}</code></pre>
                </section>

