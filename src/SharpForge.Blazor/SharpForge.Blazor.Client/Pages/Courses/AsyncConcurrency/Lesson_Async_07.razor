            <header class="lesson-header"><span class="lesson-number">Lesson 7</span><h1>Progress Reporting</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>IProgress&lt;T&gt; Interface</h2>
                    <pre><code class="language-csharp">// Method that reports progress
public async Task ProcessFilesAsync(
    IEnumerable&lt;string&gt; files,
    IProgress&lt;int&gt;? progress = null,
    CancellationToken ct = default)
{
    var fileList = files.ToList();
    for (int i = 0; i &lt; fileList.Count; i++)
    {
        ct.ThrowIfCancellationRequested();
        
        await ProcessFileAsync(fileList[i], ct);
        
        // Report progress (percentage)
        progress?.Report((i + 1) * 100 / fileList.Count);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Progress&lt;T&gt; Class</h2>
                    <pre><code class="language-csharp">// In UI code
var progress = new Progress&lt;int&gt;(percent =&gt;
{
    progressBar.Value = percent;
    statusLabel.Text = $"Processing: {percent}%";
});

await ProcessFilesAsync(files, progress, cts.Token);</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Custom Progress Data</h2>
                    <pre><code class="language-csharp">public record DownloadProgress(
    string FileName,
    long BytesDownloaded,
    long TotalBytes,
    int PercentComplete);

public async Task DownloadAsync(
    string url,
    IProgress&lt;DownloadProgress&gt;? progress = null)
{
    var response = await httpClient.GetAsync(url, HttpCompletionOption.ResponseHeadersRead);
    var totalBytes = response.Content.Headers.ContentLength ?? -1;
    
    await using var stream = await response.Content.ReadAsStreamAsync();
    var buffer = new byte[8192];
    long bytesRead = 0;
    int read;
    
    while ((read = await stream.ReadAsync(buffer)) &gt; 0)
    {
        bytesRead += read;
        
        progress?.Report(new DownloadProgress(
            Path.GetFileName(url),
            bytesRead,
            totalBytes,
            (int)(bytesRead * 100 / totalBytes)));
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Blazor Example</h2>
                    <pre><code class="language-csharp">@@code {
    private int _progress;
    
    private async Task StartDownloadAsync()
    {
        var progress = new Progress&lt;int&gt;(p =&gt;
        {
            _progress = p;
            StateHasChanged();  // Update UI
        });
        
        await downloadService.DownloadAsync(url, progress);
    }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Use IProgress&lt;T&gt; to report from async methods.</LessonTakeaway>
                    <LessonTakeaway>Progress&lt;T&gt; captures sync context for UI updates.</LessonTakeaway>
                    <LessonTakeaway>Make progress parameter optional with null default.</LessonTakeaway>
