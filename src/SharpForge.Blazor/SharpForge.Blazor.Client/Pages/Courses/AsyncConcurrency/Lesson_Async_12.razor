            <header class="lesson-header"><span class="lesson-number">Lesson 12</span><h1>Thread Synchronization Primitives</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>35 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>lock Statement</h2>
                    <pre><code class="language-csharp">private readonly object _lock = new();
private int _counter;

public void Increment()
{
    lock (_lock)
    {
        _counter++;  // Only one thread at a time
    }
}

// ❌ DON'T lock on 'this' or public objects
lock (this) { }  // Bad!
lock (typeof(MyClass)) { }  // Bad!</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>SemaphoreSlim</h2>
                    <pre><code class="language-csharp">// Limit concurrent access
private readonly SemaphoreSlim _semaphore = new(initialCount: 3);

public async Task ProcessAsync()
{
    await _semaphore.WaitAsync();  // Async-friendly!
    try
    {
        await DoWorkAsync();
    }
    finally
    {
        _semaphore.Release();
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>ReaderWriterLockSlim</h2>
                    <pre><code class="language-csharp">private readonly ReaderWriterLockSlim _rwLock = new();
private Dictionary&lt;string, Data&gt; _cache = new();

public Data? Read(string key)
{
    _rwLock.EnterReadLock();  // Multiple readers allowed
    try
    {
        return _cache.TryGetValue(key, out var data) ? data : null;
    }
    finally
    {
        _rwLock.ExitReadLock();
    }
}

public void Write(string key, Data data)
{
    _rwLock.EnterWriteLock();  // Exclusive access
    try
    {
        _cache[key] = data;
    }
    finally
    {
        _rwLock.ExitWriteLock();
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Interlocked</h2>
                    <pre><code class="language-csharp">private int _counter;

// Atomic operations - no lock needed
Interlocked.Increment(ref _counter);
Interlocked.Decrement(ref _counter);
Interlocked.Add(ref _counter, 5);
Interlocked.Exchange(ref _counter, 0);
Interlocked.CompareExchange(ref _counter, newValue, expectedValue);</code></pre>
                </section>

