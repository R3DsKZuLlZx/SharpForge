            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Encapsulate a request as an object, allowing you to parameterize clients with different requests, queue or log requests, and support undoable operations.</p>
                </section>

                <section class="lesson-section">
                    <h2>Text Editor Example</h2>
                    <pre><code class="language-csharp">public interface ICommand
{
    void Execute();
    void Undo();
}

public class TextEditor
{
    public string Text { get; set; } = "";
}

public class AddTextCommand : ICommand
{
    private readonly TextEditor _editor;
    private readonly string _text;

    public AddTextCommand(TextEditor editor, string text)
    {
        _editor = editor;
        _text = text;
    }

    public void Execute() =&gt; _editor.Text += _text;
    public void Undo() =&gt; _editor.Text = _editor.Text[..^_text.Length];
}

public class CommandHistory
{
    private readonly Stack&lt;ICommand&gt; _history = new();

    public void ExecuteCommand(ICommand command)
    {
        command.Execute();
        _history.Push(command);
    }

    public void Undo()
    {
        if (_history.Count &gt; 0)
            _history.Pop().Undo();
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>MediatR (CQRS)</h2>
                    <pre><code class="language-csharp">// Command
public record CreateOrderCommand(string CustomerId, List&lt;OrderItem&gt; Items) 
    : IRequest&lt;OrderResult&gt;;

// Handler
public class CreateOrderHandler : IRequestHandler&lt;CreateOrderCommand, OrderResult&gt;
{
    public async Task&lt;OrderResult&gt; Handle(CreateOrderCommand request, CancellationToken ct)
    {
        // Process command
    }
}

// Usage
var result = await _mediator.Send(new CreateOrderCommand(customerId, items));</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Encapsulates actions as objects.</LessonTakeaway>
                    <LessonTakeaway>Enables undo/redo, queuing, logging.</LessonTakeaway>
                    <LessonTakeaway>MediatR implements this for CQRS.</LessonTakeaway>
                </LessonTakeaways>
