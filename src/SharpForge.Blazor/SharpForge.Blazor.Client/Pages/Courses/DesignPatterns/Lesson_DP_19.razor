            <header class="lesson-header"><span class="lesson-number">Lesson 19</span><h1>Command Pattern</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Encapsulate a request as an object, allowing you to parameterize clients with different requests, queue or log requests, and support undoable operations.</p>
                </section>

                <section class="lesson-section">
                    <h2>Text Editor Example</h2>
                    <pre><code class="language-csharp">public interface ICommand
{
    void Execute();
    void Undo();
}

public class TextEditor
{
    public string Text { get; set; } = "";
}

public class AddTextCommand : ICommand
{
    private readonly TextEditor _editor;
    private readonly string _text;

    public AddTextCommand(TextEditor editor, string text)
    {
        _editor = editor;
        _text = text;
    }

    public void Execute() =&gt; _editor.Text += _text;
    public void Undo() =&gt; _editor.Text = _editor.Text[..^_text.Length];
}

public class CommandHistory
{
    private readonly Stack&lt;ICommand&gt; _history = new();

    public void ExecuteCommand(ICommand command)
    {
        command.Execute();
        _history.Push(command);
    }

    public void Undo()
    {
        if (_history.Count &gt; 0)
            _history.Pop().Undo();
    }
}</code></pre>
                </section>

