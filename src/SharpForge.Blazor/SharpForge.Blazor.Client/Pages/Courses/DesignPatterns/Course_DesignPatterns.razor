@page "/training/design-patterns-csharp"

<PageTitle>Design Patterns in C# - SharpForge</PageTitle>

<section class="course-hero">
    <div class="container">
        <a href="/training" class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back to Training
        </a>
        <div class="course-hero-content">
            <div class="course-hero-text">
                <span class="course-level advanced">Advanced</span>
                <h1>Design Patterns in C#</h1>
                <p class="course-description">Learn Gang of Four patterns, SOLID principles, and clean architecture. Write maintainable, testable, and scalable code that stands the test of time.</p>
                <div class="course-meta">
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 20V10M18 20V4M6 20v-4"/>
                        </svg>
                        <span>24 Lessons</span>
                    </div>
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span>10 Hours</span>
                    </div>
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        <span>1,432 Students</span>
                    </div>
                </div>
                <a href="/training/design-patterns-csharp/lesson/1" class="btn btn-primary btn-lg">Start Learning</a>
            </div>
            <div class="course-hero-image">
                <div class="course-icon">
                    <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="64" cy="64" r="60" fill="url(#patterns-gradient)"/>
                        <rect x="44" y="40" width="16" height="16" rx="2" fill="white"/>
                        <rect x="68" y="40" width="16" height="16" rx="2" fill="white"/>
                        <rect x="44" y="64" width="16" height="16" rx="2" fill="white"/>
                        <rect x="68" y="64" width="16" height="16" rx="2" fill="white"/>
                        <path d="M52 56v8M76 56v8M60 48h8M60 72h8" stroke="white" stroke-width="2"/>
                        <defs>
                            <linearGradient id="patterns-gradient" x1="0" y1="0" x2="128" y2="128" gradientUnits="userSpaceOnUse">
                                <stop offset="0" stop-color="#ef4444"/>
                                <stop offset="1" stop-color="#dc2626"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section course-content">
    <div class="container">
        <div class="course-layout">
            <main class="course-main">
                <div class="course-section">
                    <h2>What You'll Learn</h2>
                    <div class="learning-outcomes">
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Master SOLID principles for better software design</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Implement creational patterns: Singleton, Factory, Builder, Prototype</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Apply structural patterns: Adapter, Decorator, Facade, Proxy</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Use behavioral patterns: Observer, Strategy, Command, State</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Implement Clean Architecture in .NET applications</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Recognize when and where to apply each pattern</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Refactor legacy code using design patterns</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Write testable, maintainable, and scalable code</span>
                        </div>
                    </div>
                </div>

                <div class="course-section">
                    <h2>Course Curriculum</h2>
                    <div class="lessons-list">
                        @foreach (var lesson in Lessons)
                        {
                            <a href="/training/design-patterns-csharp/lesson/@lesson.Number" class="lesson-card">
                                <div class="lesson-number">@lesson.Number</div>
                                <div class="lesson-info">
                                    <h3>@lesson.Title</h3>
                                    <p>@lesson.Description</p>
                                </div>
                                <div class="lesson-duration">@lesson.Duration</div>
                            </a>
                        }
                    </div>
                </div>

                <div class="course-section">
                    <h2>Prerequisites</h2>
                    <ul class="prerequisites-list">
                        <li>Strong understanding of C# and object-oriented programming</li>
                        <li>Experience building .NET applications</li>
                        <li>Familiarity with interfaces and abstract classes</li>
                        <li>Basic understanding of dependency injection</li>
                        <li>Willingness to think critically about software design</li>
                    </ul>
                </div>
            </main>

            <aside class="course-sidebar">
                <div class="sidebar-card">
                    <h4>Course Progress</h4>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%"></div>
                    </div>
                    <p class="progress-text">0 of 24 lessons completed</p>
                    <a href="/training/design-patterns-csharp/lesson/1" class="btn btn-primary">Start Course</a>
                </div>

                <div class="sidebar-card">
                    <h4>Course Includes</h4>
                    <ul class="includes-list">
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="23 7 16 12 23 17 23 7"/>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                            </svg>
                            10 hours of content
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            24 lessons
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="16 18 22 12 16 6"/>
                                <polyline points="8 6 2 12 8 18"/>
                            </svg>
                            12 hands-on exercises
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                            Real-world refactoring project
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            Lifetime access
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>

@code {
    private List<LessonInfo> Lessons { get; } = new()
    {
        // SOLID Principles
        new(1, "Introduction to Design Patterns", "Understand what design patterns are, their history, and why they matter.", "25 min"),
        new(2, "Single Responsibility Principle", "Learn the S in SOLID - one class, one responsibility.", "25 min"),
        new(3, "Open/Closed Principle", "Classes should be open for extension, closed for modification.", "25 min"),
        new(4, "Liskov Substitution Principle", "Subtypes must be substitutable for their base types.", "25 min"),
        new(5, "Interface Segregation Principle", "Many specific interfaces are better than one general interface.", "25 min"),
        new(6, "Dependency Inversion Principle", "Depend on abstractions, not concretions.", "25 min"),
        
        // Creational Patterns
        new(7, "Singleton Pattern", "Ensure a class has only one instance with global access.", "25 min"),
        new(8, "Factory Method Pattern", "Define an interface for creating objects, let subclasses decide which class to instantiate.", "30 min"),
        new(9, "Abstract Factory Pattern", "Create families of related objects without specifying concrete classes.", "30 min"),
        new(10, "Builder Pattern", "Separate construction of complex objects from their representation.", "30 min"),
        new(11, "Prototype Pattern", "Create new objects by cloning existing ones.", "20 min"),
        
        // Structural Patterns
        new(12, "Adapter Pattern", "Convert the interface of a class into another interface clients expect.", "25 min"),
        new(13, "Decorator Pattern", "Attach additional responsibilities to objects dynamically.", "30 min"),
        new(14, "Facade Pattern", "Provide a unified interface to a set of interfaces in a subsystem.", "25 min"),
        new(15, "Proxy Pattern", "Provide a surrogate or placeholder for another object.", "25 min"),
        new(16, "Composite Pattern", "Compose objects into tree structures to represent part-whole hierarchies.", "25 min"),
        
        // Behavioral Patterns
        new(17, "Strategy Pattern", "Define a family of algorithms and make them interchangeable.", "25 min"),
        new(18, "Observer Pattern", "Define a one-to-many dependency between objects.", "30 min"),
        new(19, "Command Pattern", "Encapsulate a request as an object.", "25 min"),
        new(20, "State Pattern", "Allow an object to alter its behavior when its internal state changes.", "25 min"),
        new(21, "Template Method Pattern", "Define the skeleton of an algorithm, deferring steps to subclasses.", "25 min"),
        new(22, "Chain of Responsibility", "Pass requests along a chain of handlers.", "25 min"),
        
        // Architecture
        new(23, "Clean Architecture", "Organize code into layers with clear dependencies.", "35 min"),
        new(24, "Putting It All Together", "Apply multiple patterns in a real-world application.", "40 min")
    };

    private record LessonInfo(int Number, string Title, string Description, string Duration);
}

