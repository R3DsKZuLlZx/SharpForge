            <header class="lesson-header"><span class="lesson-number">Lesson 15</span><h1>Proxy Pattern</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Provide a surrogate or placeholder for another object to control access to it.</p>
                </section>

                <section class="lesson-section">
                    <h2>Types of Proxies</h2>
                    <ul>
                        <li><strong>Virtual Proxy:</strong> Lazy initialization of expensive objects</li>
                        <li><strong>Protection Proxy:</strong> Access control</li>
                        <li><strong>Caching Proxy:</strong> Cache results</li>
                        <li><strong>Logging Proxy:</strong> Add logging</li>
                    </ul>
                </section>

                <section class="lesson-section">
                    <h2>Caching Proxy</h2>
                    <pre><code class="language-csharp">public interface IWeatherService
{
    Task&lt;Weather&gt; GetWeatherAsync(string city);
}

public class WeatherService : IWeatherService
{
    public async Task&lt;Weather&gt; GetWeatherAsync(string city)
    {
        // Expensive API call
        await Task.Delay(1000);
        return new Weather { City = city, Temperature = 22 };
    }
}

public class CachingWeatherProxy : IWeatherService
{
    private readonly IWeatherService _service;
    private readonly Dictionary&lt;string, (Weather Data, DateTime Expiry)&gt; _cache = new();

    public CachingWeatherProxy(IWeatherService service) =&gt; _service = service;

    public async Task&lt;Weather&gt; GetWeatherAsync(string city)
    {
        if (_cache.TryGetValue(city, out var cached) &amp;&amp; cached.Expiry &gt; DateTime.Now)
            return cached.Data;

        var weather = await _service.GetWeatherAsync(city);
        _cache[city] = (weather, DateTime.Now.AddMinutes(10));
        return weather;
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Protection Proxy</h2>
                    <pre><code class="language-csharp">public class SecureDocumentProxy : IDocument
{
    private readonly IDocument _document;
    private readonly IUserContext _userContext;

    public SecureDocumentProxy(IDocument document, IUserContext userContext)
    {
        _document = document;
        _userContext = userContext;
    }

    public void Read() =&gt; _document.Read();  // Anyone can read

    public void Write(string content)
    {
        if (!_userContext.HasPermission("document:write"))
            throw new UnauthorizedAccessException();
        
        _document.Write(content);
    }

    public void Delete()
    {
        if (!_userContext.IsAdmin)
            throw new UnauthorizedAccessException();
        
        _document.Delete();
    }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Proxy controls access to another object.</LessonTakeaway>
                    <LessonTakeaway>Can add caching, security, logging, lazy loading.</LessonTakeaway>
                    <LessonTakeaway>Same interface as the real object.</LessonTakeaway>
                </LessonTakeaways>
