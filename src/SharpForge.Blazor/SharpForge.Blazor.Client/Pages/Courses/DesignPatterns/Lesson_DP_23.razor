            <header class="lesson-header"><span class="lesson-number">Lesson 23</span><h1>Clean Architecture</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>35 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>The Layers</h2>
                    <p>Clean Architecture organizes code into concentric layers with dependencies pointing inward.</p>
                    <ul>
                        <li><strong>Domain (Core):</strong> Entities, value objects, domain events</li>
                        <li><strong>Application:</strong> Use cases, interfaces, DTOs</li>
                        <li><strong>Infrastructure:</strong> Database, external services, file system</li>
                        <li><strong>Presentation:</strong> API controllers, Blazor components, UI</li>
                    </ul>
                </section>

                <section class="lesson-section">
                    <h2>Project Structure</h2>
                    <pre><code class="language-text">Solution/
├── src/
│   ├── Domain/           # No dependencies
│   │   ├── Entities/
│   │   ├── ValueObjects/
│   │   └── Events/
│   ├── Application/      # Depends on Domain
│   │   ├── Interfaces/
│   │   ├── Services/
│   │   └── DTOs/
│   ├── Infrastructure/   # Depends on Application
│   │   ├── Persistence/
│   │   └── ExternalServices/
│   └── WebApi/          # Depends on Application
│       └── Controllers/
└── tests/</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Domain Layer</h2>
                    <pre><code class="language-csharp">// Domain/Entities/Order.cs
public class Order
{
    public Guid Id { get; private set; }
    public CustomerId CustomerId { get; private set; }
    public Money Total { get; private set; }
    public OrderStatus Status { get; private set; }
    
    private readonly List&lt;OrderItem&gt; _items = new();
    public IReadOnlyList&lt;OrderItem&gt; Items =&gt; _items.AsReadOnly();

    public void AddItem(Product product, int quantity)
    {
        _items.Add(new OrderItem(product, quantity));
        RecalculateTotal();
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Application Layer</h2>
                    <pre><code class="language-csharp">// Application/Interfaces/IOrderRepository.cs
public interface IOrderRepository
{
    Task&lt;Order?&gt; GetByIdAsync(Guid id);
    Task AddAsync(Order order);
}

// Application/Services/CreateOrderUseCase.cs
public class CreateOrderUseCase
{
    private readonly IOrderRepository _repository;
    private readonly IUnitOfWork _unitOfWork;

    public async Task&lt;OrderDto&gt; ExecuteAsync(CreateOrderRequest request)
    {
        var order = new Order(request.CustomerId);
        foreach (var item in request.Items)
            order.AddItem(item.Product, item.Quantity);

        await _repository.AddAsync(order);
        await _unitOfWork.SaveChangesAsync();

        return OrderDto.FromEntity(order);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Infrastructure Layer</h2>
                    <pre><code class="language-csharp">// Infrastructure/Persistence/OrderRepository.cs
public class OrderRepository : IOrderRepository
{
    private readonly AppDbContext _context;

    public async Task&lt;Order?&gt; GetByIdAsync(Guid id)
        =&gt; await _context.Orders
            .Include(o =&gt; o.Items)
            .FirstOrDefaultAsync(o =&gt; o.Id == id);

    public async Task AddAsync(Order order)
        =&gt; await _context.Orders.AddAsync(order);
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Dependencies point inward toward the domain.</LessonTakeaway>
                    <LessonTakeaway>Domain has no external dependencies.</LessonTakeaway>
                    <LessonTakeaway>Interfaces defined in Application, implemented in Infrastructure.</LessonTakeaway>
                    <LessonTakeaway>Business logic is testable without infrastructure.</LessonTakeaway>
                </LessonTakeaways>
