                    <h2>Pattern Summary</h2>
                    <div class="comparison-grid">
                        <div class="comparison-card">
                            <h4>Creational</h4>
                            <ul>
                                <li>Singleton - One instance</li>
                                <li>Factory - Object creation</li>
                                <li>Builder - Complex construction</li>
                                <li>Prototype - Cloning</li>
                            </ul>
                        </div>
                        <div class="comparison-card">
                            <h4>Structural</h4>
                            <ul>
                                <li>Adapter - Interface bridging</li>
                                <li>Decorator - Add behavior</li>
                                <li>Facade - Simplify</li>
                                <li>Proxy - Control access</li>
                            </ul>
                        </div>
                    </div>
                    <div class="comparison-grid">
                        <div class="comparison-card">
                            <h4>Behavioral</h4>
                            <ul>
                                <li>Strategy - Swap algorithms</li>
                                <li>Observer - Event notification</li>
                                <li>Command - Encapsulate actions</li>
                                <li>State - State machine</li>
                            </ul>
                        </div>
                        <div class="comparison-card">
                            <h4>SOLID</h4>
                            <ul>
                                <li>SRP - One responsibility</li>
                                <li>OCP - Open/Closed</li>
                                <li>LSP - Substitutability</li>
                                <li>ISP - Interface segregation</li>
                                <li>DIP - Depend on abstractions</li>
                            </ul>
                        </div>
                    </div>
