            <header class="lesson-header"><span class="lesson-number">Lesson 14</span><h1>Facade Pattern</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Provide a unified interface to a set of interfaces in a subsystem. Facade defines a higher-level interface that makes the subsystem easier to use.</p>
                </section>

                <section class="lesson-section">
                    <h2>Complex Subsystem</h2>
                    <pre><code class="language-csharp">// Complex subsystem classes
public class InventoryService
{
    public bool CheckStock(int productId, int quantity) =&gt; true;
    public void ReserveStock(int productId, int quantity) { }
}

public class PaymentService
{
    public bool ProcessPayment(string cardNumber, decimal amount) =&gt; true;
}

public class ShippingService
{
    public string CreateShipment(Address address) =&gt; "TRACK123";
}

public class NotificationService
{
    public void SendConfirmation(string email, string orderId) { }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>The Facade</h2>
                    <pre><code class="language-csharp">public class OrderFacade
{
    private readonly InventoryService _inventory;
    private readonly PaymentService _payment;
    private readonly ShippingService _shipping;
    private readonly NotificationService _notification;

    public OrderFacade(
        InventoryService inventory,
        PaymentService payment,
        ShippingService shipping,
        NotificationService notification)
    {
        _inventory = inventory;
        _payment = payment;
        _shipping = shipping;
        _notification = notification;
    }

    // Simple interface hides complexity
    public OrderResult PlaceOrder(OrderRequest request)
    {
        // Check inventory
        if (!_inventory.CheckStock(request.ProductId, request.Quantity))
            return OrderResult.Failed("Out of stock");

        // Reserve stock
        _inventory.ReserveStock(request.ProductId, request.Quantity);

        // Process payment
        if (!_payment.ProcessPayment(request.CardNumber, request.Total))
            return OrderResult.Failed("Payment failed");

        // Create shipment
        var trackingNumber = _shipping.CreateShipment(request.Address);

        // Send notification
        _notification.SendConfirmation(request.Email, trackingNumber);

        return OrderResult.Success(trackingNumber);
    }
}

// Client uses simple interface
var result = _orderFacade.PlaceOrder(request);</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Key Takeaways</h2>
                    <div class="key-takeaways">
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Facade simplifies complex subsystems.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Provides a single entry point for clients.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Doesn't prevent direct access to subsystem if needed.</span></div>
                    </div>
