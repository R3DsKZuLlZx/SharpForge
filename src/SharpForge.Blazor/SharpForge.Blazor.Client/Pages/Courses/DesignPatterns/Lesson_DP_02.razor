            <header class="lesson-header"><span class="lesson-number">Lesson 2</span><h1>Single Responsibility Principle</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>The Principle</h2>
                    <p><strong>"A class should have only one reason to change."</strong></p>
                    <p>Each class should focus on a single concern. If a class has multiple responsibilities, changes to one responsibility may affect the others.</p>
                </section>

                <section class="lesson-section">
                    <h2>❌ Violating SRP</h2>
                    <pre><code class="language-csharp">public class Employee
{
    public string Name { get; set; }
    public decimal Salary { get; set; }

    // Responsibility 1: Calculate pay
    public decimal CalculatePay() =&gt; Salary / 12;

    // Responsibility 2: Save to database
    public void Save() =&gt; Database.Save(this);

    // Responsibility 3: Generate report
    public string GenerateReport() =&gt; $"Employee: {Name}, Salary: {Salary}";
}</code></pre>
                    <p>This class has THREE reasons to change: pay calculation, persistence, and reporting.</p>
                </section>

                <section class="lesson-section">
                    <h2>✅ Following SRP</h2>
                    <pre><code class="language-csharp">// Responsibility 1: Employee data
public class Employee
{
    public string Name { get; set; }
    public decimal Salary { get; set; }
}

// Responsibility 2: Pay calculation
public class PayCalculator
{
    public decimal CalculateMonthlyPay(Employee employee)
        =&gt; employee.Salary / 12;
}

// Responsibility 3: Persistence
public class EmployeeRepository
{
    public void Save(Employee employee) =&gt; Database.Save(employee);
}

// Responsibility 4: Reporting
public class EmployeeReportGenerator
{
    public string Generate(Employee employee)
        =&gt; $"Employee: {employee.Name}, Salary: {employee.Salary}";
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Real-World Example</h2>
                    <pre><code class="language-csharp">// ❌ Controller doing too much
public class OrderController
{
    public IActionResult CreateOrder(OrderDto dto)
    {
        // Validation
        if (string.IsNullOrEmpty(dto.CustomerEmail)) return BadRequest();
        
        // Business logic
        var order = new Order { Total = dto.Items.Sum(i =&gt; i.Price) };
        
        // Persistence
        _context.Orders.Add(order);
        _context.SaveChanges();
        
        // Email notification
        _emailService.Send(dto.CustomerEmail, "Order confirmed!");
        
        return Ok(order);
    }
}

// ✅ Separated responsibilities
public class OrderController
{
    private readonly IOrderService _orderService;
    
    public IActionResult CreateOrder(OrderDto dto)
    {
        var result = _orderService.CreateOrder(dto);
        return result.IsSuccess ? Ok(result.Value) : BadRequest(result.Error);
    }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>One class = one responsibility = one reason to change.</LessonTakeaway>
                    <LessonTakeaway>Separate data, logic, persistence, and presentation.</LessonTakeaway>
                    <LessonTakeaway>Smaller, focused classes are easier to test and maintain.</LessonTakeaway>
                </LessonTakeaways>
            </div>
