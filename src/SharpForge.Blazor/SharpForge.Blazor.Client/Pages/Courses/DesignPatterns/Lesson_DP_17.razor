            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Define a family of algorithms, encapsulate each one, and make them interchangeable. Strategy lets the algorithm vary independently from clients that use it.</p>
                </section>

                <section class="lesson-section">
                    <h2>Sorting Example</h2>
                    <pre><code class="language-csharp">public interface ISortStrategy&lt;T&gt;
{
    IEnumerable&lt;T&gt; Sort(IEnumerable&lt;T&gt; items);
}

public class QuickSort&lt;T&gt; : ISortStrategy&lt;T&gt; where T : IComparable&lt;T&gt;
{
    public IEnumerable&lt;T&gt; Sort(IEnumerable&lt;T&gt; items) =&gt; items.OrderBy(x =&gt; x);
}

public class BubbleSort&lt;T&gt; : ISortStrategy&lt;T&gt; where T : IComparable&lt;T&gt;
{
    public IEnumerable&lt;T&gt; Sort(IEnumerable&lt;T&gt; items)
    {
        // Bubble sort implementation
    }
}

public class Sorter&lt;T&gt;
{
    private ISortStrategy&lt;T&gt; _strategy;

    public Sorter(ISortStrategy&lt;T&gt; strategy) =&gt; _strategy = strategy;

    public void SetStrategy(ISortStrategy&lt;T&gt; strategy) =&gt; _strategy = strategy;

    public IEnumerable&lt;T&gt; Sort(IEnumerable&lt;T&gt; items) =&gt; _strategy.Sort(items);
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Payment Strategies</h2>
                    <pre><code class="language-csharp">public interface IPaymentStrategy
{
    Task&lt;PaymentResult&gt; PayAsync(decimal amount);
}

public class CreditCardPayment : IPaymentStrategy
{
    private readonly string _cardNumber;
    public CreditCardPayment(string cardNumber) =&gt; _cardNumber = cardNumber;
    public async Task&lt;PaymentResult&gt; PayAsync(decimal amount) { /* ... */ }
}

public class PayPalPayment : IPaymentStrategy
{
    private readonly string _email;
    public PayPalPayment(string email) =&gt; _email = email;
    public async Task&lt;PaymentResult&gt; PayAsync(decimal amount) { /* ... */ }
}

public class ShoppingCart
{
    private readonly List&lt;Item&gt; _items = new();

    public async Task&lt;PaymentResult&gt; CheckoutAsync(IPaymentStrategy paymentStrategy)
    {
        var total = _items.Sum(i =&gt; i.Price);
        return await paymentStrategy.PayAsync(total);
    }
}

// Usage
var cart = new ShoppingCart();
await cart.CheckoutAsync(new CreditCardPayment("4111111111111111"));
await cart.CheckoutAsync(new PayPalPayment("user@example.com"));</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Encapsulate algorithms in separate classes.</LessonTakeaway>
                    <LessonTakeaway>Switch algorithms at runtime.</LessonTakeaway>
                    <LessonTakeaway>Eliminates conditionals for algorithm selection.</LessonTakeaway>
                </LessonTakeaways>
