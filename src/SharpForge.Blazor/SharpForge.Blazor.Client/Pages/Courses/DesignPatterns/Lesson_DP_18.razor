            <header class="lesson-header"><span class="lesson-number">Lesson 18</span><h1>Observer Pattern</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>30 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Define a one-to-many dependency between objects so that when one object changes state, all its dependents are notified and updated automatically.</p>
                </section>

                <section class="lesson-section">
                    <h2>C# Events (Built-in Observer)</h2>
                    <pre><code class="language-csharp">public class StockTicker
{
    public event EventHandler&lt;StockPriceChangedEventArgs&gt;? PriceChanged;

    private decimal _price;
    public decimal Price
    {
        get =&gt; _price;
        set
        {
            if (_price != value)
            {
                var oldPrice = _price;
                _price = value;
                OnPriceChanged(new StockPriceChangedEventArgs(oldPrice, value));
            }
        }
    }

    protected virtual void OnPriceChanged(StockPriceChangedEventArgs e)
    {
        PriceChanged?.Invoke(this, e);
    }
}

// Subscribers
var ticker = new StockTicker();
ticker.PriceChanged += (sender, e) =&gt; 
    Console.WriteLine($"Price changed: {e.OldPrice} -&gt; {e.NewPrice}");
ticker.PriceChanged += (sender, e) =&gt; 
    SendEmailAlert(e);

ticker.Price = 150.00m;  // Both handlers notified</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>IObservable/IObserver (Rx Pattern)</h2>
                    <pre><code class="language-csharp">public class TemperatureSensor : IObservable&lt;double&gt;
{
    private readonly List&lt;IObserver&lt;double&gt;&gt; _observers = new();

    public IDisposable Subscribe(IObserver&lt;double&gt; observer)
    {
        _observers.Add(observer);
        return new Unsubscriber(_observers, observer);
    }

    public void ReportTemperature(double temp)
    {
        foreach (var observer in _observers)
            observer.OnNext(temp);
    }

    private class Unsubscriber : IDisposable
    {
        private readonly List&lt;IObserver&lt;double&gt;&gt; _observers;
        private readonly IObserver&lt;double&gt; _observer;

        public Unsubscriber(List&lt;IObserver&lt;double&gt;&gt; observers, IObserver&lt;double&gt; observer)
        {
            _observers = observers;
            _observer = observer;
        }

        public void Dispose() =&gt; _observers.Remove(_observer);
    }
}</code></pre>
                </section>

