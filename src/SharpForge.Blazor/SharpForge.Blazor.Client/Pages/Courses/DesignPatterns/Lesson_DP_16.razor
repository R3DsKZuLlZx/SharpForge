        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 16</span><h1>Composite Pattern</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Compose objects into tree structures to represent part-whole hierarchies. Composite lets clients treat individual objects and compositions uniformly.</p>
                </section>

                <section class="lesson-section">
                    <h2>File System Example</h2>
                    <pre><code class="language-csharp">public interface IFileSystemItem
{
    string Name { get; }
    long GetSize();
    void Display(int indent = 0);
}

// Leaf
public class File : IFileSystemItem
{
    public string Name { get; }
    public long Size { get; }

    public File(string name, long size) =&gt; (Name, Size) = (name, size);
    public long GetSize() =&gt; Size;
    public void Display(int indent = 0) 
        =&gt; Console.WriteLine($"{new string(' ', indent)}- {Name} ({Size} bytes)");
}

// Composite
public class Folder : IFileSystemItem
{
    public string Name { get; }
    private readonly List&lt;IFileSystemItem&gt; _items = new();

    public Folder(string name) =&gt; Name = name;

    public void Add(IFileSystemItem item) =&gt; _items.Add(item);
    public void Remove(IFileSystemItem item) =&gt; _items.Remove(item);

    public long GetSize() =&gt; _items.Sum(i =&gt; i.GetSize());

    public void Display(int indent = 0)
    {
        Console.WriteLine($"{new string(' ', indent)}+ {Name}/");
        foreach (var item in _items)
            item.Display(indent + 2);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Usage</h2>
                    <pre><code class="language-csharp">var root = new Folder("root");
var documents = new Folder("Documents");
var photos = new Folder("Photos");

documents.Add(new File("resume.pdf", 50000));
documents.Add(new File("notes.txt", 1000));
photos.Add(new File("vacation.jpg", 2000000));

root.Add(documents);
root.Add(photos);
root.Add(new File("readme.md", 500));

root.Display();
Console.WriteLine($"Total size: {root.GetSize()} bytes");</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Key Takeaways</h2>
                    <div class="takeaways">
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Tree structures with uniform interface.</span></div>
