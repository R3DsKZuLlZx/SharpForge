            <header class="lesson-header"><span class="lesson-number">Lesson 8</span><h1>Factory Method Pattern</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>30 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Define an interface for creating objects, but let subclasses decide which class to instantiate.</p>
                </section>

                <section class="lesson-section">
                    <h2>Simple Factory</h2>
                    <pre><code class="language-csharp">public interface INotification
{
    void Send(string message);
}

public class EmailNotification : INotification
{
    public void Send(string message) =&gt; Console.WriteLine($"Email: {message}");
}

public class SmsNotification : INotification
{
    public void Send(string message) =&gt; Console.WriteLine($"SMS: {message}");
}

public class PushNotification : INotification
{
    public void Send(string message) =&gt; Console.WriteLine($"Push: {message}");
}

public static class NotificationFactory
{
    public static INotification Create(string type) =&gt; type switch
    {
        "email" =&gt; new EmailNotification(),
        "sms" =&gt; new SmsNotification(),
        "push" =&gt; new PushNotification(),
        _ =&gt; throw new ArgumentException($"Unknown type: {type}")
    };
}

// Usage
var notification = NotificationFactory.Create("email");
notification.Send("Hello!");</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Factory Method Pattern</h2>
                    <pre><code class="language-csharp">public abstract class Document
{
    public abstract void Open();
    public abstract void Save();
}

public class PdfDocument : Document
{
    public override void Open() =&gt; Console.WriteLine("Opening PDF");
    public override void Save() =&gt; Console.WriteLine("Saving PDF");
}

public class WordDocument : Document
{
    public override void Open() =&gt; Console.WriteLine("Opening Word");
    public override void Save() =&gt; Console.WriteLine("Saving Word");
}

public abstract class Application
{
    // Factory Method - subclasses override this
    protected abstract Document CreateDocument();

    public void NewDocument()
    {
        var doc = CreateDocument();
        doc.Open();
    }
}

public class PdfApplication : Application
{
    protected override Document CreateDocument() =&gt; new PdfDocument();
}

public class WordApplication : Application
{
    protected override Document CreateDocument() =&gt; new WordDocument();
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Modern C# Factory with DI</h2>
                    <pre><code class="language-csharp">public interface IPaymentProcessorFactory
{
    IPaymentProcessor Create(PaymentMethod method);
}

public class PaymentProcessorFactory : IPaymentProcessorFactory
{
    private readonly IServiceProvider _serviceProvider;

    public PaymentProcessorFactory(IServiceProvider serviceProvider)
    {
        _serviceProvider = serviceProvider;
    }

    public IPaymentProcessor Create(PaymentMethod method) =&gt; method switch
    {
        PaymentMethod.CreditCard =&gt; _serviceProvider.GetRequiredService&lt;CreditCardProcessor&gt;(),
        PaymentMethod.PayPal =&gt; _serviceProvider.GetRequiredService&lt;PayPalProcessor&gt;(),
        _ =&gt; throw new ArgumentException()
    };
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Key Takeaways</h2>
                    <div class="key-takeaways">
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Factory encapsulates object creation logic.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Clients depend on interfaces, not concrete classes.</span></div>
