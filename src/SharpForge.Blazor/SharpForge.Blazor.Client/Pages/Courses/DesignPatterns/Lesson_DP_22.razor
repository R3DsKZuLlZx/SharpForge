            <header class="lesson-header"><span class="lesson-number">Lesson 22</span><h1>Chain of Responsibility</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Intent</h2>
                    <p>Avoid coupling the sender of a request to its receiver by giving more than one object a chance to handle the request. Chain the receiving objects and pass the request along until an object handles it.</p>
                </section>

                <section class="lesson-section">
                    <h2>Request Handler Chain</h2>
                    <pre><code class="language-csharp">public abstract class Handler
{
    protected Handler? _next;

    public Handler SetNext(Handler next)
    {
        _next = next;
        return next;
    }

    public abstract void Handle(Request request);
}

public class AuthenticationHandler : Handler
{
    public override void Handle(Request request)
    {
        if (string.IsNullOrEmpty(request.Token))
            throw new UnauthorizedException();

        Console.WriteLine("Authenticated");
        _next?.Handle(request);
    }
}

public class AuthorizationHandler : Handler
{
    public override void Handle(Request request)
    {
        if (!request.User.HasPermission(request.Resource))
            throw new ForbiddenException();

        Console.WriteLine("Authorized");
        _next?.Handle(request);
    }
}

public class ValidationHandler : Handler
{
    public override void Handle(Request request)
    {
        if (!request.IsValid())
            throw new ValidationException();

        Console.WriteLine("Validated");
        _next?.Handle(request);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Building the Chain</h2>
                    <pre><code class="language-csharp">var chain = new AuthenticationHandler();
chain
    .SetNext(new AuthorizationHandler())
    .SetNext(new ValidationHandler())
    .SetNext(new ProcessingHandler());

chain.Handle(request);</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>ASP.NET Core Middleware</h2>
                    <pre><code class="language-csharp">// ASP.NET Core uses Chain of Responsibility!
app.UseAuthentication();
app.UseAuthorization();
app.UseRateLimiting();
app.UseEndpoints(...);</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Pass requests through a chain of handlers.</LessonTakeaway>
                    <LessonTakeaway>Each handler decides to process or pass along.</LessonTakeaway>
                    <LessonTakeaway>ASP.NET Core middleware is this pattern.</LessonTakeaway>
                </LessonTakeaways>
