@page "/training/microservices/lesson/26"
<PageTitle>Resilience Patterns - Microservices with .NET - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/microservices"
        CourseTitle="Microservices with .NET"
