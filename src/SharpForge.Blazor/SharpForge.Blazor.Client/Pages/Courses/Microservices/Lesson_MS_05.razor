        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 5</span><h1>Dockerizing .NET Applications</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>30 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Multi-Stage Dockerfile</h2>
                    <pre><code class="language-dockerfile"># Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy csproj and restore
COPY ["OrderService.csproj", "./"]
RUN dotnet restore

# Copy everything and build
COPY . .
RUN dotnet publish -c Release -o /app/publish

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
EXPOSE 80

# Copy published output
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "OrderService.dll"]</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Optimized Layer Caching</h2>
                    <pre><code class="language-dockerfile"># Copy only project files first (cached unless changed)
COPY ["src/OrderService/*.csproj", "src/OrderService/"]
COPY ["src/SharedKernel/*.csproj", "src/SharedKernel/"]

# Restore (cached unless csproj changed)
RUN dotnet restore "src/OrderService/OrderService.csproj"

# Now copy source (changes frequently)
COPY . .
RUN dotnet publish</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>.dockerignore</h2>
                    <pre><code class="language-text">**/.git
**/bin
**/obj
**/node_modules
**/.vs
**/.idea
**/Dockerfile*
**/*.md</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Running as Non-Root</h2>
                    <pre><code class="language-dockerfile">FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

# Create non-root user
RUN adduser --disabled-password --gecos '' appuser
USER appuser

COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "OrderService.dll"]</code></pre>
                </section>

                <LessonTakeaways>
                        <LessonTakeaway>Use multi-stage builds for smaller images.</LessonTakeaway>
                        <LessonTakeaway>Order COPY commands for layer caching.</LessonTakeaway>
                        <LessonTakeaway>Run as non-root for security.</LessonTakeaway>
                    </LessonTakeaways>
            </div>
