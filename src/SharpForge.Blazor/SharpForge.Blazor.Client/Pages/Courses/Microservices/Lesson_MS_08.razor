            <header class="lesson-header"><span class="lesson-number">Lesson 8</span><h1>gRPC in .NET</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>35 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Why gRPC?</h2>
                    <ul>
                        <li>Binary protocol (Protocol Buffers) - faster than JSON</li>
                        <li>HTTP/2 - multiplexing, streaming</li>
                        <li>Strongly typed contracts</li>
                        <li>Code generation for client/server</li>
                    </ul>
                </section>

                <section class="lesson-section">
                    <h2>Proto File</h2>
                    <pre><code class="language-protobuf">syntax = "proto3";

option csharp_namespace = "InventoryService.Grpc";

service Inventory {
    rpc CheckStock (CheckStockRequest) returns (CheckStockResponse);
    rpc ReserveStock (ReserveStockRequest) returns (ReserveStockResponse);
}

message CheckStockRequest {
    string product_id = 1;
    int32 quantity = 2;
}

message CheckStockResponse {
    bool in_stock = 1;
    int32 available_quantity = 2;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Server Implementation</h2>
                    <pre><code class="language-csharp">public class InventoryService : Inventory.InventoryBase
{
    private readonly IInventoryRepository _repository;

    public override async Task&lt;CheckStockResponse&gt; CheckStock(
        CheckStockRequest request, ServerCallContext context)
    {
        var productId = Guid.Parse(request.ProductId);
        var available = await _repository.GetAvailableQuantityAsync(productId);
        
        return new CheckStockResponse
        {
            InStock = available &gt;= request.Quantity,
            AvailableQuantity = available
        };
    }
}

// Program.cs
builder.Services.AddGrpc();
app.MapGrpcService&lt;InventoryService&gt;();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Client</h2>
                    <pre><code class="language-csharp">// Program.cs
builder.Services.AddGrpcClient&lt;Inventory.InventoryClient&gt;(o =&gt;
{
    o.Address = new Uri("http://inventoryservice:5001");
});

// Usage
public class OrderService
{
    private readonly Inventory.InventoryClient _inventoryClient;

    public async Task&lt;bool&gt; CheckInventoryAsync(Guid productId, int qty)
    {
        var response = await _inventoryClient.CheckStockAsync(
            new CheckStockRequest 
            { 
                ProductId = productId.ToString(), 
                Quantity = qty 
            });
        return response.InStock;
    }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>gRPC is faster than REST for internal services.</LessonTakeaway>
                    <LessonTakeaway>Proto files define strongly-typed contracts.</LessonTakeaway>
                    <LessonTakeaway>Use for service-to-service communication.</LessonTakeaway>
                </LessonTakeaways>
