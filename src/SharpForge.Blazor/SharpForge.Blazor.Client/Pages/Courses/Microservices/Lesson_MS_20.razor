<PageTitle>ConfigMaps and Secrets - Microservices with .NET - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/microservices"
        CourseTitle="Microservices with .NET"
        CurrentLesson="20"
        Lessons="@_lessons" />
    <main class="lesson-content">
        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 20</span><h1>ConfigMaps and Secrets</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>ConfigMap</h2>
                    <pre><code class="language-yaml">apiVersion: v1
kind: ConfigMap
metadata:
  name: order-service-config
data:
  appsettings.json: |
    {
      "Logging": { "LogLevel": { "Default": "Information" } },
      "AllowedHosts": "*"
    }
  ASPNETCORE_ENVIRONMENT: "Production"</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Secret</h2>
                    <pre><code class="language-yaml">apiVersion: v1
kind: Secret
metadata:
  name: order-service-secrets
type: Opaque
stringData:
  ConnectionStrings__Database: "Server=db;Database=Orders;User=sa;Password=Secret123!"</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Using in Deployment</h2>
                    <pre><code class="language-yaml">spec:
  containers:
  - name: order-service
    image: myregistry/order-service:1.0
    envFrom:
    - configMapRef:
        name: order-service-config
    - secretRef:
        name: order-service-secrets
    volumeMounts:
    - name: config-volume
      mountPath: /app/appsettings.json
      subPath: appsettings.json
  volumes:
  - name: config-volume
    configMap:
      name: order-service-config</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>ConfigMaps for non-sensitive configuration.</LessonTakeaway>
                    <LessonTakeaway>Secrets for sensitive data (base64 encoded).</LessonTakeaway>
                    <LessonTakeaway>Mount as files or environment variables.</LessonTakeaway>
                </LessonTakeaways>
            </div>
