            <header class="lesson-header"><span class="lesson-number">Lesson 10</span><h1>RabbitMQ with MassTransit</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>40 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>MassTransit Setup</h2>
                    <pre><code class="language-csharp">// Install packages
// dotnet add package MassTransit.RabbitMQ

// Program.cs
builder.Services.AddMassTransit(x =&gt;
{
    x.AddConsumer&lt;OrderPlacedConsumer&gt;();
    
    x.UsingRabbitMq((context, cfg) =&gt;
    {
        cfg.Host("rabbitmq", "/", h =&gt;
        {
            h.Username("guest");
            h.Password("guest");
        });
        
        cfg.ConfigureEndpoints(context);
    });
});</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Publishing Events</h2>
                    <pre><code class="language-csharp">public record OrderPlaced(Guid OrderId, Guid CustomerId, decimal Total);

public class OrderService
{
    private readonly IPublishEndpoint _publishEndpoint;

    public async Task PlaceOrderAsync(Order order)
    {
        // Save order...
        
        // Publish event
        await _publishEndpoint.Publish(new OrderPlaced(
            order.Id,
            order.CustomerId,
            order.Total));
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Consuming Events</h2>
                    <pre><code class="language-csharp">public class OrderPlacedConsumer : IConsumer&lt;OrderPlaced&gt;
{
    private readonly IInventoryService _inventory;
    private readonly ILogger&lt;OrderPlacedConsumer&gt; _logger;

    public async Task Consume(ConsumeContext&lt;OrderPlaced&gt; context)
    {
        var message = context.Message;
        
        _logger.LogInformation("Processing order {OrderId}", message.OrderId);
        
        await _inventory.ReserveStockAsync(message.OrderId);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Request-Response</h2>
                    <pre><code class="language-csharp">// Request
public record CheckInventory(Guid ProductId, int Quantity);
public record InventoryResult(bool InStock, int Available);

// Client
var client = _bus.CreateRequestClient&lt;CheckInventory&gt;();
var response = await client.GetResponse&lt;InventoryResult&gt;(
    new CheckInventory(productId, quantity));

// Consumer
public class CheckInventoryConsumer : IConsumer&lt;CheckInventory&gt;
{
    public async Task Consume(ConsumeContext&lt;CheckInventory&gt; context)
    {
        var available = await _repo.GetAvailableAsync(context.Message.ProductId);
        await context.RespondAsync(new InventoryResult(
            available &gt;= context.Message.Quantity, 
            available));
    }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>MassTransit abstracts message broker details.</LessonTakeaway>
                    <LessonTakeaway>Publish for events, Send for commands.</LessonTakeaway>
                    <LessonTakeaway>Request-Response for async queries.</LessonTakeaway>
                </LessonTakeaways>
