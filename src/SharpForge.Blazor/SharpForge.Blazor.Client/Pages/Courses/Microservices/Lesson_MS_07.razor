            <header class="lesson-header"><span class="lesson-number">Lesson 7</span><h1>Synchronous Communication with HTTP</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Typed HttpClient</h2>
                    <pre><code class="language-csharp">// Client interface
public interface IInventoryClient
{
    Task&lt;bool&gt; CheckStockAsync(Guid productId, int quantity);
    Task&lt;bool&gt; ReserveStockAsync(Guid productId, int quantity);
}

// Implementation
public class InventoryClient : IInventoryClient
{
    private readonly HttpClient _httpClient;

    public InventoryClient(HttpClient httpClient)
    {
        _httpClient = httpClient;
    }

    public async Task&lt;bool&gt; CheckStockAsync(Guid productId, int quantity)
    {
        var response = await _httpClient.GetAsync(
            $"/api/inventory/{productId}/check?quantity={quantity}");
        return response.IsSuccessStatusCode;
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Registration</h2>
                    <pre><code class="language-csharp">// Program.cs
builder.Services.AddHttpClient&lt;IInventoryClient, InventoryClient&gt;(client =&gt;
{
    client.BaseAddress = new Uri("http://inventoryservice");
    client.Timeout = TimeSpan.FromSeconds(30);
})
.AddTransientHttpErrorPolicy(p =&gt; p.WaitAndRetryAsync(3, 
    attempt =&gt; TimeSpan.FromSeconds(Math.Pow(2, attempt))));</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Refit (Type-Safe Client)</h2>
                    <pre><code class="language-csharp">// Define API as interface
public interface IInventoryApi
{
    [Get("/api/inventory/{productId}/check")]
    Task&lt;bool&gt; CheckStockAsync(Guid productId, [Query] int quantity);

    [Post("/api/inventory/{productId}/reserve")]
    Task&lt;bool&gt; ReserveStockAsync(Guid productId, [Body] ReserveRequest request);
}

// Registration
builder.Services.AddRefitClient&lt;IInventoryApi&gt;()
    .ConfigureHttpClient(c =&gt; c.BaseAddress = new Uri("http://inventoryservice"));</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Use typed HttpClient for service calls.</LessonTakeaway>
                    <LessonTakeaway>IHttpClientFactory manages connection pooling.</LessonTakeaway>
                    <LessonTakeaway>Refit provides type-safe REST clients.</LessonTakeaway>
                </LessonTakeaways>
            </div>
