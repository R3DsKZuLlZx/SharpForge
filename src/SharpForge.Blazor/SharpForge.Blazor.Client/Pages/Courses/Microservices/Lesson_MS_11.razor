            <header class="lesson-header"><span class="lesson-number">Lesson 11</span><h1>Event Sourcing and CQRS</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>35 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Event Sourcing</h2>
                    <p>Store state as a sequence of events rather than current state.</p>
                    <pre><code class="language-csharp">// Events are immutable facts
public record OrderCreated(Guid OrderId, Guid CustomerId, DateTime CreatedAt);
public record ItemAdded(Guid OrderId, Guid ProductId, int Quantity, decimal Price);
public record OrderPlaced(Guid OrderId, DateTime PlacedAt);

// Rebuild state by replaying events
public class Order
{
    public Guid Id { get; private set; }
    public OrderStatus Status { get; private set; }
    private List&lt;OrderItem&gt; _items = new();

    public void Apply(OrderCreated e) =&gt; Id = e.OrderId;
    public void Apply(ItemAdded e) =&gt; _items.Add(new(e.ProductId, e.Quantity));
    public void Apply(OrderPlaced e) =&gt; Status = OrderStatus.Placed;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>CQRS Pattern</h2>
                    <pre><code class="language-text">CQRS = Command Query Responsibility Segregation

Commands (Write)          Queries (Read)
    │                         │
    ▼                         ▼
┌─────────┐              ┌─────────┐
│ Command │              │  Query  │
│ Handler │              │ Handler │
└────┬────┘              └────┬────┘
     │                        │
     ▼                        ▼
┌─────────┐              ┌─────────┐
│  Write  │   Projections│  Read   │
│   DB    │ ───────────► │   DB    │
└─────────┘              └─────────┘</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Projections</h2>
                    <pre><code class="language-csharp">// Read model - optimized for queries
public class OrderSummary
{
    public Guid Id { get; set; }
    public string CustomerName { get; set; }
    public decimal Total { get; set; }
    public int ItemCount { get; set; }
}

// Projection updates read model from events
public class OrderSummaryProjection
{
    public void Handle(ItemAdded e)
    {
        var summary = _db.Get(e.OrderId);
        summary.ItemCount++;
        summary.Total += e.Price * e.Quantity;
        _db.Save(summary);
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Key Takeaways</h2>
                    <div class="key-takeaways">
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Event Sourcing stores all state changes as events.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>CQRS separates read and write models.</span></div>
                        <div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Projections build read models from events.</span></div>
                    </div>
                </section>
