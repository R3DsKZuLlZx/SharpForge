@page "/training/microservices/lesson/28"
<PageTitle>Building a Complete Microservices System - Microservices with .NET - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/microservices"
        CourseTitle="Microservices with .NET"
        CurrentLesson="28"
        Lessons="CourseLessons.Microservices" />
    <main class="lesson-content">
        <article class="lesson-article">
            <LessonHeader 
                LessonNumber="28"
                Title="Building a Complete Microservices System"
                Duration="45 min"
                Level="Advanced" />
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>E-Commerce System Architecture</h2>
                    <pre><code class="language-text">┌─────────────────────────────────────────────────────────────────────────┐
│                              Clients                                     │
│                    (Web, Mobile, Third-Party)                           │
└───────────────────────────────┬─────────────────────────────────────────┘
                                │
                    ┌───────────▼───────────┐
                    │     API Gateway       │
                    │       (YARP)          │
                    └───────────┬───────────┘
                                │
        ┌───────────────────────┼───────────────────────┐
        │                       │                       │
┌───────▼───────┐   ┌───────────▼───────────┐  ┌───────▼───────┐
│    Order      │   │      Inventory        │  │   Payment     │
│   Service     │   │       Service         │  │   Service     │
└───────┬───────┘   └───────────┬───────────┘  └───────┬───────┘
        │                       │                       │
        │           ┌───────────▼───────────┐          │
        └──────────►│      RabbitMQ         │◄─────────┘
                    │   (Message Broker)    │
                    └───────────────────────┘</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Services Overview</h2>
                    <ul>
                        <li><strong>API Gateway (YARP):</strong> Routing, auth, rate limiting</li>
                        <li><strong>Order Service:</strong> Order management, saga orchestration</li>
                        <li><strong>Inventory Service:</strong> Stock management (gRPC)</li>
                        <li><strong>Payment Service:</strong> Payment processing</li>
                        <li><strong>Notification Service:</strong> Email/SMS (event-driven)</li>
                        <li><strong>Identity Service:</strong> Authentication (Duende IdentityServer)</li>
                    </ul>
                </section>

                <section class="lesson-section">
                    <h2>Order Flow (Saga)</h2>
                    <pre><code class="language-text">1. OrderSubmitted
   └─► ReserveInventory (gRPC)
       ├─► InventoryReserved
       │   └─► ProcessPayment
       │       ├─► PaymentSucceeded
       │       │   └─► CompleteOrder → SendNotification
       │       └─► PaymentFailed
       │           └─► ReleaseInventory (compensate)
       └─► InventoryInsufficient
           └─► RejectOrder</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Infrastructure Stack</h2>
                    <pre><code class="language-yaml"># docker-compose.yml
services:
  api-gateway:         # YARP
  order-service:       # .NET 8
  inventory-service:   # .NET 8 + gRPC
  payment-service:     # .NET 8
  notification-service: # .NET 8 Worker
  
  # Infrastructure
  rabbitmq:            # Messaging
  postgres:            # Databases
  redis:               # Caching
  seq:                 # Logging
  jaeger:              # Tracing
  prometheus:          # Metrics
  grafana:             # Dashboards</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Start with clear service boundaries (DDD).</LessonTakeaway>
                    <LessonTakeaway>Use events for loose coupling between services.</LessonTakeaway>
                    <LessonTakeaway>Implement observability from day one.</LessonTakeaway>
                    <LessonTakeaway>Use sagas for distributed transactions.</LessonTakeaway>
                </LessonTakeaways>

                <LessonCongratulations 
                    CourseTitle="Microservices with .NET"
                    Topics="@(new List<string> {
                        "Microservices architecture and DDD",
                        "Docker and container orchestration",
                        "Service communication (HTTP, gRPC, messaging)",
                        "Data management and saga patterns",
                        "API Gateway with YARP",
                        "Kubernetes deployment and scaling",
                        "Observability (logging, tracing, metrics)",
                        "Resilience patterns with Polly"
                    })"
                    ClosingMessage="<strong>What's next?</strong> You're now ready to design and build production-ready distributed systems!" />
            </div>
