@page "/training/microservices/lesson/6"
<PageTitle>Docker Compose - Microservices with .NET - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/microservices"
        CourseTitle="Microservices with .NET"
        CurrentLesson="6"
        Lessons="@_lessons" />
    <main class="lesson-content">
        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 6</span><h1>Docker Compose</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level advanced">Advanced</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>docker-compose.yml</h2>
                    <pre><code class="language-yaml">version: '3.8'

services:
  orderservice:
    build: ./src/OrderService
    ports:
      - "5001:80"
    environment:
      - ConnectionStrings__Database=Server=db;Database=Orders;User=sa;Password=Password123!
      - RabbitMQ__Host=rabbitmq
    depends_on:
      - db
      - rabbitmq

  inventoryservice:
    build: ./src/InventoryService
    ports:
      - "5002:80"
    environment:
      - ConnectionStrings__Database=Server=db;Database=Inventory;User=sa;Password=Password123!
    depends_on:
      - db

  db:
    image: mcr.microsoft.com/mssql/server:2022-latest
    environment:
      - ACCEPT_EULA=Y
      - SA_PASSWORD=Password123!
    volumes:
      - sqldata:/var/opt/mssql

  rabbitmq:
    image: rabbitmq:3-management
    ports:
      - "15672:15672"

volumes:
  sqldata:</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Commands</h2>
                    <pre><code class="language-bash"># Start all services
docker-compose up -d

# Rebuild and start
docker-compose up -d --build

# View logs
docker-compose logs -f orderservice

# Stop all
docker-compose down

# Stop and remove volumes
docker-compose down -v</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Health Checks</h2>
                    <pre><code class="language-yaml">services:
  orderservice:
    build: ./src/OrderService
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    depends_on:
      db:
        condition: service_healthy</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Compose orchestrates multi-container apps.</LessonTakeaway>
                    <LessonTakeaway>Use depends_on for startup order.</LessonTakeaway>
                    <LessonTakeaway>Health checks ensure dependencies are ready.</LessonTakeaway>
                </LessonTakeaways>
            </div>
            <LessonFooter 
                PreviousUrl="/training/microservices/lesson/5" 
                PreviousText="Previous Lesson"
                NextUrl="/training/microservices/lesson/7" 
                NextText="Next Lesson" />
        </article>
    </main>
</div>

