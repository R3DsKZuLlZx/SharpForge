            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Understanding Routing in ASP.NET Core</h2>
                    <p>Routing is responsible for matching incoming HTTP requests to endpoints. ASP.NET Core uses attribute routing for Web APIs.</p>
                </section>

                <section class="lesson-section">
                    <h2>Route Templates</h2>
                    <pre><code class="language-csharp">// Controller-level route
[Route("api/[controller]")]  // api/products
public class ProductsController : ControllerBase
{
    // Action-level routes
    [HttpGet]                    // GET api/products
    [HttpGet("{id}")]           // GET api/products/5
    [HttpGet("category/{cat}")] // GET api/products/category/electronics
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Route Parameters</h2>
                    <pre><code class="language-csharp">// Required parameter
[HttpGet("{id}")]
public ActionResult Get(int id) { }

// Optional parameter
[HttpGet("{id?}")]
public ActionResult Get(int? id) { }

// Default value
[HttpGet("{id=1}")]
public ActionResult Get(int id) { }

// Multiple parameters
[HttpGet("{category}/{id}")]
public ActionResult Get(string category, int id) { }</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Route Constraints</h2>
                    <pre><code class="language-csharp">// Integer constraint
[HttpGet("{id:int}")]
public ActionResult GetById(int id) { }

// Min/Max value
[HttpGet("{id:int:min(1):max(100)}")]
public ActionResult GetById(int id) { }

// GUID constraint
[HttpGet("{id:guid}")]
public ActionResult GetById(Guid id) { }

// Regex constraint
[HttpGet("{slug:regex(^[a-z0-9-]+$)}")]
public ActionResult GetBySlug(string slug) { }

// Length constraint
[HttpGet("{name:minlength(3):maxlength(50)}")]
public ActionResult GetByName(string name) { }</code></pre>

                    <div class="info-box">
                        <div class="info-box-header">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            <span>Common Constraints</span>
                        </div>
                        <p><code>int</code>, <code>long</code>, <code>guid</code>, <code>bool</code>, <code>datetime</code>, <code>decimal</code>, <code>double</code>, <code>float</code>, <code>alpha</code>, <code>minlength(n)</code>, <code>maxlength(n)</code>, <code>length(n)</code>, <code>min(n)</code>, <code>max(n)</code>, <code>range(min,max)</code>, <code>regex(expression)</code></p>
                    </div>
                </section>

                <section class="lesson-section">
                    <h2>Query String Parameters</h2>
                    <pre><code class="language-csharp">// GET api/products?page=1&pageSize=10&search=laptop
[HttpGet]
public ActionResult GetAll(
    [FromQuery] int page = 1,
    [FromQuery] int pageSize = 10,
    [FromQuery] string? search = null)
{
    // page = 1, pageSize = 10, search = "laptop"
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Route Prefixes</h2>
                    <pre><code class="language-csharp">// Base controller with common prefix
[Route("api/v1/[controller]")]
public class ProductsController : ControllerBase { }

// Override route completely
[Route("api/v1/[controller]")]
public class ProductsController : ControllerBase
{
    [HttpGet("/api/all-products")]  // Absolute path (ignores prefix)
    public ActionResult GetAll() { }
}</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Use <code>[Route]</code> and HTTP method attributes for routing.</LessonTakeaway>
                    <LessonTakeaway>Route parameters can be required, optional, or have defaults.</LessonTakeaway>
                    <LessonTakeaway>Constraints validate route parameters before reaching your action.</LessonTakeaway>
                    <LessonTakeaway>Use <code>[FromQuery]</code> for query string parameters.</LessonTakeaway>
                </LessonTakeaways>
