    <main class="lesson-content">
        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 16</span><h1>Minimal APIs</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>35 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section"><h2>What are Minimal APIs?</h2><p>Minimal APIs provide a lightweight way to build HTTP APIs with minimal code. Perfect for microservices and simple endpoints.</p></section>
                <section class="lesson-section"><h2>Basic Endpoints</h2><pre><code class="language-csharp">var builder = WebApplication.CreateBuilder(args);
var app = builder.Build();

app.MapGet("/", () => "Hello World");
app.MapGet("/products", () => products);
app.MapGet("/products/{id}", (int id) => products.Find(p => p.Id == id));
app.MapPost("/products", (Product product) => { products.Add(product); return Results.Created($"/products/{product.Id}", product); });
app.MapPut("/products/{id}", (int id, Product product) => { /* update */ return Results.NoContent(); });
app.MapDelete("/products/{id}", (int id) => { /* delete */ return Results.NoContent(); });

app.Run();</code></pre></section>
                <section class="lesson-section"><h2>Dependency Injection</h2><pre><code class="language-csharp">app.MapGet("/products", async (IProductRepository repo) => 
    await repo.GetAllAsync());

app.MapGet("/products/{id}", async (int id, IProductRepository repo, ILogger&lt;Program&gt; logger) =>
{
    logger.LogInformation("Getting product {Id}", id);
    var product = await repo.GetByIdAsync(id);
    return product is null ? Results.NotFound() : Results.Ok(product);
});</code></pre></section>
                <section class="lesson-section"><h2>Route Groups</h2><pre><code class="language-csharp">var products = app.MapGroup("/api/products")
    .WithTags("Products")
    .RequireAuthorization();

products.MapGet("/", GetAll);
products.MapGet("/{id}", GetById);
products.MapPost("/", Create);
products.MapPut("/{id}", Update);
products.MapDelete("/{id}", Delete);</code></pre></section>
                <section class="lesson-section"><h2>Validation with Filters</h2><pre><code class="language-csharp">app.MapPost("/products", (Product product) => Results.Ok(product))
    .AddEndpointFilter(async (context, next) =>
    {
        var product = context.GetArgument&lt;Product&gt;(0);
        if (string.IsNullOrEmpty(product.Name))
            return Results.BadRequest("Name is required");
        return await next(context);
    });</code></pre></section>
                <section class="lesson-section"><h2>Key Takeaways</h2><div class="key-takeaways"><div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Minimal APIs are perfect for simple services.</span></div><div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Use route groups to organize related endpoints.</span></div><div class="takeaway"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg><span>Endpoint filters provide validation and cross-cutting concerns.</span></div></div></section>
