    <main class="lesson-content">
        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 10</span><h1>Transactions</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>20 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Implicit Transactions</h2>
                    <p>SaveChangesAsync wraps all changes in a single transaction automatically.</p>
                    <pre><code class="language-csharp">// All operations succeed or fail together
context.Orders.Add(order);
context.OrderItems.AddRange(items);
context.Inventory.Update(inventory);
await context.SaveChangesAsync();  // Single transaction</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Explicit Transactions</h2>
                    <pre><code class="language-csharp">using var transaction = await context.Database.BeginTransactionAsync();

try
{
    // Operation 1
    var order = new Order { CustomerId = customerId };
    context.Orders.Add(order);
    await context.SaveChangesAsync();

    // Operation 2 (needs order.Id)
    foreach (var item in cartItems)
    {
        context.OrderItems.Add(new OrderItem 
        { 
            OrderId = order.Id, 
            ProductId = item.ProductId 
        });
    }
    await context.SaveChangesAsync();

    // All succeeded - commit
    await transaction.CommitAsync();
}
catch
{
    // Something failed - rollback
    await transaction.RollbackAsync();
    throw;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Savepoints</h2>
                    <pre><code class="language-csharp">using var transaction = await context.Database.BeginTransactionAsync();

try
{
    // First batch of changes
    await context.SaveChangesAsync();
    await transaction.CreateSavepointAsync("AfterFirstBatch");

    try
    {
        // Second batch (might fail)
        await context.SaveChangesAsync();
    }
    catch
    {
        // Rollback only to savepoint
        await transaction.RollbackToSavepointAsync("AfterFirstBatch");
    }

    await transaction.CommitAsync();
}
catch
{
    await transaction.RollbackAsync();
    throw;
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>TransactionScope</h2>
                    <pre><code class="language-csharp">using var scope = new TransactionScope(TransactionScopeAsyncFlowOption.Enabled);

// Multiple DbContext operations
using (var context1 = new AppDbContext(options))
{
    await context1.SaveChangesAsync();
}

using (var context2 = new AppDbContext(options))
{
    await context2.SaveChangesAsync();
}

// Commit all
scope.Complete();</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>SaveChangesAsync wraps changes in an implicit transaction.</LessonTakeaway>
                    <LessonTakeaway>Use BeginTransactionAsync for multiple SaveChanges calls.</LessonTakeaway>
                    <LessonTakeaway>Savepoints allow partial rollbacks.</LessonTakeaway>
                    <LessonTakeaway>TransactionScope spans multiple contexts.</LessonTakeaway>
                </LessonTakeaways>
