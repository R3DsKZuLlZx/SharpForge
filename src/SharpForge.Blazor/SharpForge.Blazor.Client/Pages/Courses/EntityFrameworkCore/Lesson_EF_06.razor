@page "/training/entity-framework-core/lesson/6"
<PageTitle>Querying with LINQ - Entity Framework Core - SharpForge</PageTitle>
<CodeHighlighter />

<div class="lesson-layout">
    <LessonSidebar 
        CourseUrl="/training/entity-framework-core"
        CourseTitle="Entity Framework Core"
        CurrentLesson="6"
        Lessons="@_lessons" />
    <main class="lesson-content">
        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 6</span><h1>Querying with LINQ</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>35 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Filtering with Where</h2>
                    <pre><code class="language-csharp">// Simple filter
var expensiveProducts = await context.Products
    .Where(p =&gt; p.Price &gt; 100)
    .ToListAsync();

// Multiple conditions
var activeExpensive = await context.Products
    .Where(p =&gt; p.Price &gt; 100 &amp;&amp; p.IsActive)
    .ToListAsync();

// String operations
var laptops = await context.Products
    .Where(p =&gt; p.Name.Contains("Laptop"))
    .ToListAsync();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Sorting</h2>
                    <pre><code class="language-csharp">// Ascending
var byName = await context.Products
    .OrderBy(p =&gt; p.Name)
    .ToListAsync();

// Descending
var byPriceDesc = await context.Products
    .OrderByDescending(p =&gt; p.Price)
    .ToListAsync();

// Multiple sort criteria
var sorted = await context.Products
    .OrderBy(p =&gt; p.Category.Name)
    .ThenByDescending(p =&gt; p.Price)
    .ToListAsync();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Pagination</h2>
                    <pre><code class="language-csharp">int page = 1;
int pageSize = 10;

var pagedProducts = await context.Products
    .OrderBy(p =&gt; p.Name)
    .Skip((page - 1) * pageSize)
    .Take(pageSize)
    .ToListAsync();

var totalCount = await context.Products.CountAsync();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Projection with Select</h2>
                    <pre><code class="language-csharp">// Select specific columns (more efficient)
var productNames = await context.Products
    .Select(p =&gt; p.Name)
    .ToListAsync();

// Project to DTO
var productDtos = await context.Products
    .Select(p =&gt; new ProductDto
    {
        Id = p.Id,
        Name = p.Name,
        Price = p.Price,
        CategoryName = p.Category.Name
    })
    .ToListAsync();

// Anonymous type
var summary = await context.Products
    .Select(p =&gt; new { p.Name, p.Price })
    .ToListAsync();</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Grouping and Aggregates</h2>
                    <pre><code class="language-csharp">// Group by category
var byCategory = await context.Products
    .GroupBy(p =&gt; p.CategoryId)
    .Select(g =&gt; new
    {
        CategoryId = g.Key,
        Count = g.Count(),
        TotalValue = g.Sum(p =&gt; p.Price),
        AveragePrice = g.Average(p =&gt; p.Price)
    })
    .ToListAsync();

// Aggregates
var maxPrice = await context.Products.MaxAsync(p =&gt; p.Price);
var minPrice = await context.Products.MinAsync(p =&gt; p.Price);
var count = await context.Products.CountAsync();
var sum = await context.Products.SumAsync(p =&gt; p.Stock);</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Query vs Method Syntax</h2>
                    <pre><code class="language-csharp">// Method syntax (more common)
var products = await context.Products
    .Where(p =&gt; p.Price &gt; 100)
    .OrderBy(p =&gt; p.Name)
    .ToListAsync();

// Query syntax (SQL-like)
var products = await (
    from p in context.Products
    where p.Price &gt; 100
    orderby p.Name
    select p
).ToListAsync();</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>Where filters, OrderBy sorts, Skip/Take paginates.</LessonTakeaway>
                    <LessonTakeaway>Use Select to project only needed columns.</LessonTakeaway>
                    <LessonTakeaway>GroupBy with aggregates for reporting queries.</LessonTakeaway>
                    <LessonTakeaway>Queries are translated to SQL—check the generated SQL!</LessonTakeaway>
                </LessonTakeaways>
            </div>
            <LessonFooter 
                PreviousUrl="/training/entity-framework-core/lesson/5" 
                PreviousText="Previous Lesson"
                NextUrl="/training/entity-framework-core/lesson/7" 
                NextText="Next Lesson" />
        </article>
    </main>
</div>

