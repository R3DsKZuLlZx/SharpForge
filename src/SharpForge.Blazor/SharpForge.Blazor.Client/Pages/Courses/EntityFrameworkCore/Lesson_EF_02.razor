        <article class="lesson-article">
            <header class="lesson-header"><span class="lesson-number">Lesson 2</span><h1>Setting Up DbContext</h1><div class="lesson-meta"><span class="lesson-duration"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>25 min</span><span class="lesson-level intermediate">Intermediate</span></div></header>
            <div class="lesson-body">
                <section class="lesson-section">
                    <h2>Creating a DbContext</h2>
                    <pre><code class="language-csharp">public class AppDbContext : DbContext
{
    public AppDbContext(DbContextOptions&lt;AppDbContext&gt; options) 
        : base(options)
    {
    }

    public DbSet&lt;Product&gt; Products =&gt; Set&lt;Product&gt;();
    public DbSet&lt;Category&gt; Categories =&gt; Set&lt;Category&gt;();
    public DbSet&lt;Order&gt; Orders =&gt; Set&lt;Order&gt;();
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Registering in ASP.NET Core</h2>
                    <pre><code class="language-csharp">// Program.cs
builder.Services.AddDbContext&lt;AppDbContext&gt;(options =&gt;
    options.UseSqlServer(
        builder.Configuration.GetConnectionString("DefaultConnection")));</code></pre>
                    <pre><code class="language-json">// appsettings.json
{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=MyAppDb;Trusted_Connection=True;"
  }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>Different Database Providers</h2>
                    <pre><code class="language-csharp">// SQL Server
options.UseSqlServer(connectionString);

// PostgreSQL
options.UseNpgsql(connectionString);

// SQLite
options.UseSqlite("Data Source=app.db");

// In-Memory (for testing)
options.UseInMemoryDatabase("TestDb");</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>OnModelCreating</h2>
                    <pre><code class="language-csharp">public class AppDbContext : DbContext
{
    // ... constructor and DbSets

    protected override void OnModelCreating(ModelBuilder modelBuilder)
    {
        // Configure entities using Fluent API
        modelBuilder.Entity&lt;Product&gt;(entity =&gt;
        {
            entity.HasKey(e =&gt; e.Id);
            entity.Property(e =&gt; e.Name).IsRequired().HasMaxLength(100);
            entity.Property(e =&gt; e.Price).HasPrecision(18, 2);
        });

        // Seed data
        modelBuilder.Entity&lt;Category&gt;().HasData(
            new Category { Id = 1, Name = "Electronics" },
            new Category { Id = 2, Name = "Clothing" }
        );
    }
}</code></pre>
                </section>

                <section class="lesson-section">
                    <h2>DbContext Lifetime</h2>
                    <div class="info-box">
                        <div class="info-box-header"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg><span>Important</span></div>
                        <p>DbContext is registered as <strong>Scoped</strong> by default. This means one instance per HTTP request. Never use Singleton for DbContext!</p>
                    </div>
                    <pre><code class="language-csharp">// Default (recommended)
builder.Services.AddDbContext&lt;AppDbContext&gt;(...);  // Scoped

// For background services, use DbContextFactory
builder.Services.AddDbContextFactory&lt;AppDbContext&gt;(...);</code></pre>
                </section>

                <LessonTakeaways>
                    <LessonTakeaway>DbContext is the main class for database operations.</LessonTakeaway>
                    <LessonTakeaway>Use AddDbContext in ASP.NET Core for DI registration.</LessonTakeaway>
                    <LessonTakeaway>OnModelCreating configures entities with Fluent API.</LessonTakeaway>
                    <LessonTakeaway>DbContext should be Scoped, not Singleton.</LessonTakeaway>
                </LessonTakeaways>
            </div>
