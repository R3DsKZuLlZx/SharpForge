@page "/training/entity-framework-core"

<PageTitle>Entity Framework Core - SharpForge</PageTitle>

<section class="course-hero">
    <div class="container">
        <a href="/training" class="back-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Back to Training
        </a>
        <div class="course-hero-content">
            <div class="course-hero-text">
                <span class="course-level intermediate">Intermediate</span>
                <h1>Entity Framework Core</h1>
                <p class="course-description">Master database access with Entity Framework Core. Learn about DbContext, migrations, relationships, LINQ queries, and performance optimization for production applications.</p>
                <div class="course-meta">
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 20V10M18 20V4M6 20v-4"/>
                        </svg>
                        <span>12 Lessons</span>
                    </div>
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span>5 Hours</span>
                    </div>
                    <div class="meta-item">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                            <circle cx="9" cy="7" r="4"/>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
                        </svg>
                        <span>2,156 Students</span>
                    </div>
                </div>
                <a href="/training/entity-framework-core/lesson/1" class="btn btn-primary btn-lg">Start Learning</a>
            </div>
            <div class="course-hero-image">
                <div class="course-icon">
                    <svg viewBox="0 0 128 128" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="64" cy="64" r="60" fill="url(#ef-gradient)"/>
                        <ellipse cx="64" cy="50" rx="30" ry="12" stroke="white" stroke-width="4" fill="none"/>
                        <path d="M34 50v28c0 6.627 13.431 12 30 12s30-5.373 30-12V50" stroke="white" stroke-width="4" fill="none"/>
                        <path d="M34 64c0 6.627 13.431 12 30 12s30-5.373 30-12" stroke="white" stroke-width="4" fill="none"/>
                        <defs>
                            <linearGradient id="ef-gradient" x1="0" y1="0" x2="128" y2="128" gradientUnits="userSpaceOnUse">
                                <stop offset="0" stop-color="#68217A"/>
                                <stop offset="1" stop-color="#512BD4"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section course-content">
    <div class="container">
        <div class="course-layout">
            <main class="course-main">
                <div class="course-section">
                    <h2>What You'll Learn</h2>
                    <div class="learning-outcomes">
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Understand EF Core architecture and how it works</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Configure DbContext and connection strings</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Create and manage database migrations</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Model relationships: one-to-one, one-to-many, many-to-many</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Write efficient LINQ queries for data access</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Implement change tracking and save strategies</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Optimize performance with lazy, eager, and explicit loading</span>
                        </div>
                        <div class="outcome-item">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span>Handle concurrency and transactions</span>
                        </div>
                    </div>
                </div>

                <div class="course-section">
                    <h2>Course Curriculum</h2>
                    <div class="lessons-list">
                        @foreach (var lesson in Lessons)
                        {
                            <a href="/training/entity-framework-core/lesson/@lesson.Number" class="lesson-card">
                                <div class="lesson-number">@lesson.Number</div>
                                <div class="lesson-info">
                                    <h3>@lesson.Title</h3>
                                    <p>@lesson.Description</p>
                                </div>
                                <div class="lesson-duration">@lesson.Duration</div>
                            </a>
                        }
                    </div>
                </div>

                <div class="course-section">
                    <h2>Prerequisites</h2>
                    <ul class="prerequisites-list">
                        <li>Solid understanding of C# fundamentals</li>
                        <li>Basic knowledge of SQL and relational databases</li>
                        <li>Familiarity with .NET and the CLI</li>
                        <li>Understanding of LINQ basics</li>
                        <li>A local database (SQL Server, SQLite, or PostgreSQL)</li>
                    </ul>
                </div>
            </main>

            <aside class="course-sidebar">
                <div class="sidebar-card">
                    <h4>Course Progress</h4>
                    <div class="progress-bar">
                        <div class="progress-fill" style="width: 0%"></div>
                    </div>
                    <p class="progress-text">0 of 12 lessons completed</p>
                    <a href="/training/entity-framework-core/lesson/1" class="btn btn-primary">Start Course</a>
                </div>

                <div class="sidebar-card">
                    <h4>Course Includes</h4>
                    <ul class="includes-list">
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polygon points="23 7 16 12 23 17 23 7"/>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                            </svg>
                            5 hours of content
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                            12 lessons
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="16 18 22 12 16 6"/>
                                <polyline points="8 6 2 12 8 18"/>
                            </svg>
                            6 hands-on exercises
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                            Complete data layer project
                        </li>
                        <li>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/>
                                <line x1="12" y1="8" x2="12" y2="12"/>
                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                            </svg>
                            Lifetime access
                        </li>
                    </ul>
                </div>
            </aside>
        </div>
    </div>
</section>

@code {
    private List<LessonInfo> Lessons { get; } = new()
    {
        new(1, "Introduction to EF Core", "Understand what Entity Framework Core is, its architecture, and how it compares to other ORMs.", "25 min"),
        new(2, "Setting Up DbContext", "Create and configure your DbContext, connection strings, and database providers.", "25 min"),
        new(3, "Defining Entity Models", "Create entity classes with proper conventions, data annotations, and Fluent API configuration.", "30 min"),
        new(4, "Migrations", "Create, apply, and manage database migrations for schema changes.", "30 min"),
        new(5, "Basic CRUD Operations", "Perform Create, Read, Update, and Delete operations with EF Core.", "25 min"),
        new(6, "Querying with LINQ", "Write efficient LINQ queries including filtering, sorting, grouping, and projections.", "35 min"),
        new(7, "Relationships", "Configure one-to-one, one-to-many, and many-to-many relationships between entities.", "35 min"),
        new(8, "Loading Related Data", "Understand eager loading, lazy loading, and explicit loading strategies.", "25 min"),
        new(9, "Change Tracking", "Master how EF Core tracks changes and optimize save operations.", "25 min"),
        new(10, "Transactions", "Implement database transactions for data integrity.", "20 min"),
        new(11, "Concurrency Handling", "Handle concurrent updates with optimistic concurrency tokens.", "25 min"),
        new(12, "Performance Optimization", "Optimize queries, use raw SQL, and implement caching strategies.", "30 min")
    };

    private record LessonInfo(int Number, string Title, string Description, string Duration);
}

