@page "/training"

<PageTitle>Training - SharpForge</PageTitle>

<section class="page-hero">
    <div class="container">
        <span class="tag mb-3">Training</span>
        <h1>Learn C# from the ground up</h1>
        <p class="page-description">Comprehensive courses designed to take you from beginner to expert</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="filter-bar">
            <button class="filter-btn @(SelectedFilter == "All" ? "active" : "")" @onclick="@(() => SetFilter("All"))">All Levels</button>
            <button class="filter-btn @(SelectedFilter == "Beginner" ? "active" : "")" @onclick="@(() => SetFilter("Beginner"))">Beginner</button>
            <button class="filter-btn @(SelectedFilter == "Intermediate" ? "active" : "")" @onclick="@(() => SetFilter("Intermediate"))">Intermediate</button>
            <button class="filter-btn @(SelectedFilter == "Advanced" ? "active" : "")" @onclick="@(() => SetFilter("Advanced"))">Advanced</button>
        </div>

        <div class="courses-grid">
            @foreach (var course in FilteredCourses)
            {
                <article class="course-card">
                    <div class="course-header">
                        <div class="course-level @course.Level.ToLower()">@course.Level</div>
                        <span class="course-duration">@course.Duration</span>
                    </div>
                    <h2>@course.Title</h2>
                    <p>@course.Description</p>
                    <div class="course-topics">
                        @foreach (var topic in course.Topics)
                        {
                            <span class="topic">@topic</span>
                        }
                    </div>
                    <div class="course-footer">
                        <div class="course-stats">
                            <span>@course.Lessons Lessons</span>
                            <span>•</span>
                            <span>@course.Exercises Exercises</span>
                        </div>
                        <a href="@course.Url" class="btn btn-primary">Start Course</a>
                    </div>
                </article>
            }
        </div>
        
        @if (!FilteredCourses.Any())
        {
            <div class="no-courses">
                <p>No courses found for the selected filter.</p>
            </div>
        }
    </div>
</section>

@code {
    private string SelectedFilter { get; set; } = "All";
    
    private List<Course> Courses { get; set; } = new()
    {
        // Beginner Courses
        new Course
        {
            Title = "C# Fundamentals",
            Description = "Start your C# journey with the basics. Learn about variables, data types, control flow, methods, and object-oriented programming concepts.",
            Level = "Beginner",
            Duration = "6 Hours",
            Lessons = 12,
            Exercises = 6,
            Topics = ["Variables", "Control Flow", "Methods", "Classes"],
            Url = "/training/csharp-fundamentals"
        },
        new Course
        {
            Title = "Getting Started with .NET",
            Description = "Understand the .NET ecosystem, SDK, CLI tools, and project structure. Learn how to create, build, and run .NET applications.",
            Level = "Beginner",
            Duration = "5 Hours",
            Lessons = 10,
            Exercises = 4,
            Topics = [".NET CLI", "Project Structure", "NuGet"],
            Url = "/training/getting-started-dotnet"
        },
        // Intermediate Courses
        new Course
        {
            Title = "ASP.NET Core Web APIs",
            Description = "Build production-ready REST APIs with ASP.NET Core. Learn about routing, middleware, dependency injection, authentication, and more.",
            Level = "Intermediate",
            Duration = "8 Hours",
            Lessons = 18,
            Exercises = 10,
            Topics = ["REST APIs", "Middleware", "Authentication", "EF Core"],
            Url = "/training/aspnet-core-web-apis"
        },
        new Course
        {
            Title = "Blazor WebAssembly",
            Description = "Create interactive web applications with Blazor WebAssembly. Build SPAs with C# instead of JavaScript.",
            Level = "Intermediate",
            Duration = "6 Hours",
            Lessons = 14,
            Exercises = 8,
            Topics = ["Components", "Data Binding", "Routing", "State Management"]
        },
        new Course
        {
            Title = "Entity Framework Core",
            Description = "Master database access with Entity Framework Core. Learn about DbContext, migrations, relationships, and performance optimization.",
            Level = "Intermediate",
            Duration = "5 Hours",
            Lessons = 12,
            Exercises = 6,
            Topics = ["DbContext", "Migrations", "LINQ", "Performance"]
        },
        // Advanced Courses
        new Course
        {
            Title = "Design Patterns in C#",
            Description = "Learn Gang of Four patterns, SOLID principles, and clean architecture. Write maintainable, testable, and scalable code.",
            Level = "Advanced",
            Duration = "10 Hours",
            Lessons = 24,
            Exercises = 12,
            Topics = ["SOLID", "Creational Patterns", "Structural Patterns", "Behavioral Patterns"]
        },
        new Course
        {
            Title = "Async/Await & Concurrency",
            Description = "Deep dive into asynchronous programming, Task Parallel Library, and concurrency patterns in C#.",
            Level = "Advanced",
            Duration = "8 Hours",
            Lessons = 16,
            Exercises = 10,
            Topics = ["async/await", "TPL", "Channels", "Synchronization"]
        },
        new Course
        {
            Title = "Microservices with .NET",
            Description = "Build distributed systems with microservices architecture. Learn about Docker, Kubernetes, message queues, and API gateways.",
            Level = "Advanced",
            Duration = "12 Hours",
            Lessons = 28,
            Exercises = 15,
            Topics = ["Docker", "Kubernetes", "RabbitMQ", "gRPC"]
        }
    };
    
    private IEnumerable<Course> FilteredCourses => SelectedFilter == "All" 
        ? Courses 
        : Courses.Where(c => c.Level == SelectedFilter);
    
    private void SetFilter(string filter)
    {
        SelectedFilter = filter;
    }
    
    private class Course
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Level { get; set; } = "";
        public string Duration { get; set; } = "";
        public int Lessons { get; set; }
        public int Exercises { get; set; }
        public string[] Topics { get; set; } = [];
        public string Url { get; set; } = "#";
    }
}
