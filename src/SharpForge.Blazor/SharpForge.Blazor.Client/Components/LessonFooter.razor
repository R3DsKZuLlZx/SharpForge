@* Common footer component for lesson pages *@

<footer class="lesson-footer">
    <div class="lesson-nav-buttons">
        <a href="@PreviousUrl" class="btn btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            @PreviousText
        </a>
        <a href="@NextUrl" class="btn btn-primary">
            @NextText
            @if (ShowHomeIcon)
            {
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
            }
            else
            {
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="9 18 15 12 9 6"/>
                </svg>
            }
        </a>
    </div>
</footer>

@code {
    [Parameter] public string PreviousUrl { get; set; } = "#";
    [Parameter] public string PreviousText { get; set; } = "Previous";
    [Parameter] public string NextUrl { get; set; } = "#";
    [Parameter] public string NextText { get; set; } = "Next";
    [Parameter] public bool ShowHomeIcon { get; set; } = false;
}

