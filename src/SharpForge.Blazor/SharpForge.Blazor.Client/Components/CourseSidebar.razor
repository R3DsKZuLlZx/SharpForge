@* Common component for course sidebar *@

<aside class="course-sidebar">
    <div class="sidebar-card">
        <h4>Course Progress</h4>
        <div class="progress-bar">
            <div class="progress-fill" style="width: @(ProgressPercent)%"></div>
        </div>
        <p class="progress-text">@CompletedLessons of @TotalLessons lessons completed</p>
        <a href="@StartUrl" class="btn btn-primary">@(CompletedLessons > 0 ? "Continue Course" : "Start Course")</a>
    </div>

    <div class="sidebar-card">
        <h4>Course Includes</h4>
        <ul class="includes-list">
            <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="23 7 16 12 23 17 23 7"/>
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                </svg>
                @Duration of content
            </li>
            <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                </svg>
                @TotalLessons lessons
            </li>
            <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="16 18 22 12 16 6"/>
                    <polyline points="8 6 2 12 8 18"/>
                </svg>
                @ExerciseCount hands-on exercises
            </li>
            @if (!string.IsNullOrEmpty(ProjectDescription))
            {
                <li>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                    </svg>
                    @ProjectDescription
                </li>
            }
            <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                Lifetime access
            </li>
        </ul>
    </div>
</aside>

@code {
    [Parameter] public int CompletedLessons { get; set; } = 0;
    [Parameter] public int TotalLessons { get; set; }
    [Parameter] public string Duration { get; set; } = "";
    [Parameter] public int ExerciseCount { get; set; }
    [Parameter] public string ProjectDescription { get; set; } = "";
    [Parameter] public string StartUrl { get; set; } = "#";

    private int ProgressPercent => TotalLessons > 0 ? (CompletedLessons * 100) / TotalLessons : 0;
}

